<header class="<%= header_classes %>">
  <div class="space-y-6">
    <%= render Blog::PostMetadataComponent.new(post: @post) %>
    <h1 class="text-4xl sm:text-5xl font-bold text-[#7aa2f7] font-heading leading-tight text-center">
      🏗️ <%= @post.title %>
    </h1>
    <% if @post.tags.any? %>
      <%= render Blog::TagListComponent.new(tags: @post.tags, justify: :center) %>
    <% end %>
  </div>
</header>
