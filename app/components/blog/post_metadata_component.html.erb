<div class="<%= metadata_classes %>">
  <div class="<%= metadata_item_classes %>">
    <i class="far fa-calendar-alt <%= icon_classes %> text-[#7dcfff]"></i>
    <time datetime="<%= @post.date.strftime('%Y-%m-%d') %>" class="font-medium">
      <%= @post.date.strftime("%B %d, %Y") %>
    </time>
  </div>
  <div class="<%= metadata_item_classes %>">
    <i class="far fa-clock <%= icon_classes %> text-[#9ece6a]"></i>
    <span class="font-medium"><%= @post.reading_time %> min read</span>
  </div>
  <div class="<%= metadata_item_classes %>">
    <i class="far fa-user <%= icon_classes %> text-[#bb9af7]"></i>
    <span class="font-medium">By <%= @post.author %></span>
  </div>
</div>
