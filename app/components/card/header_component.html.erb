<div class="<%= header_classes %>">
  <% if icon? %>
    <div class="flex-shrink-0 mt-1">
      <%= icon %>
    </div>
  <% end %>
  <div class="flex-grow">
    <% if @title %>
      <h3 class="text-[#7aa2f7] text-xl font-semibold font-heading">
        <%= @title %>
      </h3>
    <% end %>
    <% if @subtitle %>
      <p class="text-[#bb9af7] text-sm mt-1">
        <%= @subtitle %>
      </p>
    <% end %>
    <%= content if content? %>
  </div>
</div>
