<article class="<%= card_classes %>">
  <div class="<%= gradient_classes %>"></div>
  <h3 class="text-[#7aa2f7] text-xl font-semibold font-heading mb-3">
    <%= @title %>
  </h3>
  <p class="text-[#a9b1d6] mb-4 leading-relaxed">
    <%= @description %>
  </p>
  <% if @technologies.any? %>
    <div class="flex flex-wrap gap-2 mb-4">
      <% @technologies.each do |tech| %>
        <%= render UI::BadgeComponent.new(variant: :skill) do %>
          <%= tech %>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% if @links.any? %>
    <div class="flex items-center gap-4 pt-4 border-t border-[#29293f]">
      <% if @links[:github] %>
        <%= render UI::LinkComponent.new(href: @links[:github], variant: :default) do %>
          <%= render UI::IconComponent.new(name: "github", style: :brands) %>
          Code
        <% end %>
      <% end %>
      <% if @links[:live] %>
        <%= render UI::LinkComponent.new(href: @links[:live], variant: :default) do %>
          <%= render UI::IconComponent.new(name: "external-link-alt", style: :solid) %>
          Live Demo
        <% end %>
      <% end %>
    </div>
  <% end %>
</article>
