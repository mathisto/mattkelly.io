<div class="github-heatmap">
  <div class="github-heatmap-grid">
    <% if weeks_data.any? %>
      <% weeks_data.each_with_index do |week, week_index| %>
        <%= render Github::WeekComponent.new(week: week, index: week_index) %>
      <% end %>
    <% end %>
  </div>
  <div class="github-heatmap-total">
    <%= total_contributions %> contributions in the last year
  </div>
</div>
