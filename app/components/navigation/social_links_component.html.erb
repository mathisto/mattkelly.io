<div class="social-links">
  <% social_links.each do |link| %>
    <a href="<%= link[:url] %>" 
       target="_blank" 
       rel="noopener noreferrer" 
       class="text-[#7aa2f7] hover:text-[#bb9af7] transition-colors duration-200">
      <span class="sr-only"><%= link[:label] %></span>
      <i class="<%= link[:style] == :brands ? 'fab' : 'fas' %> fa-<%= link[:icon] %> text-xl"></i>
    </a>
  <% end %>
</div>
