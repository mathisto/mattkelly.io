<style>
  .profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem;
    width: 25%;
    position: relative;
    z-index: 2;
  }

  .profile-section:not(.right) {
    border-right: 1px solid rgba(122, 162, 247, 0.2);
  }

  .profile-section.right {
    border-left: 1px solid rgba(122, 162, 247, 0.2);
  }

    .avatar {
      width: 6rem;
      height: 6rem;
      border-radius: 9999px;
      object-fit: cover;
      border: 2px solid #7aa2f7;
      box-shadow: 0 0 15px rgba(122, 162, 247, 0.3);
      transition: all 0.3s ease;
      margin-bottom: 1rem;
      position: relative;
    }

    .reference-card:hover .avatar {
      border-color: #bb9af7;
      box-shadow: 0 0 20px rgba(187, 154, 247, 0.4);
    }

    .profile-link {
      display: block;
      text-decoration: none;
      transition: all 0.3s ease;
      cursor: pointer;
      position: relative;
      z-index: 3;
    }

    .profile-link:hover {
      transform: translateY(-2px);
    }

    .profile-link:hover .avatar {
      border-color: #bb9af7;
      transform: scale(1.05);
    }

    .profile-link:hover h3 {
      color: #bb9af7;
    }

  .profile-link h3 {
  transition: all 0.3s ease;
  margin-top: 0.5rem;
  position: relative;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  }

  .profile-link h3 i {
  font-size: 1.25rem;
  color: #7aa2f7;
  transition: color 0.3s ease;
  }

  .profile-link:hover h3 i {
  color: #bb9af7;
  }

    .profile-title {
      text-align: center;
      max-width: 90%;
      line-height: 1.4;
    }
</style>
<div class="<%= profile_classes %>">
  <a href="<%= @url %>" target="_blank" rel="noopener noreferrer" class="profile-link">
    <img src="<%= @image %>" alt="<%= @name %>" class="avatar">
    <h3 class="text-2xl font-semibold text-[#7aa2f7]">
      <i class="fab fa-linkedin"></i>
      <%= @name %>
    </h3>
  </a>
  <p class="text-[#bb9af7] text-base mt-1 profile-title"><%= @title %></p>
</div>
