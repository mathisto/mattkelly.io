<div class="scribe-utterance-form" data-controller="utterance-form">
  <form action="<%= scribe_utterances_path %>"
        method="post"
        data-turbo="true"
        data-utterance-form-target="form"
        data-action="turbo:submit-start->utterance-form#handleSubmitStart turbo:submit-end->utterance-form#handleSubmitEnd"
        class="scribe-utterance-form-wrapper">
    <%= hidden_field_tag(:authenticity_token, form_authenticity_token) %>

    <textarea
      name="utterance"
      placeholder="What would you like to track? (e.g., 'Ran 5 miles in 42 minutes')"
      rows="6"
      autofocus
      maxlength="500"
      data-action="keydown->utterance-form#submitWithCtrlEnter input->utterance-form#updateCharacterCount"
      data-utterance-form-target="textarea"
      class="scribe-utterance-textarea"
      aria-label="Natural language input for tracking workouts, nutrition, sleep, and journal entries"
    ></textarea>

    <div class="scribe-form-footer">
      <div class="scribe-form-help">
        <span class="scribe-keyboard-hint">⌘+Enter or Ctrl+Enter to submit</span>
      </div>

      <div class="scribe-character-counter"
           data-utterance-form-target="charCounter"
           aria-live="polite">
        <span data-utterance-form-target="charCount">0</span>/500
      </div>
    </div>
  </form>
</div>
