<%= render Card::DevComponent.new do %>
  <h3 class="text-[#7aa2f7] text-xl font-semibold font-heading text-center mb-3">
    <%= @title %>
  </h3>
  <% if @description %>
    <p class="text-[#a9b1d6] text-center mb-4 leading-relaxed">
      <%= @description %>
    </p>
  <% end %>
  <% if skills? %>
    <div class="skills-container flex flex-wrap gap-2 justify-center mt-4">
      <%= skills %>
    </div>
  <% end %>
  <%= content if content? %>
<% end %>
