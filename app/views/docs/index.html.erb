<div class="min-h-screen bg-gray-50 dark:bg-gray-900">
  <!-- Header -->
  <header class="bg-white dark:bg-gray-800 shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
            <%= @title %>
          </h1>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            Development-only documentation wiki
          </p>
        </div>
        <%= link_to "← Back to Site", root_path, class: "text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300" %>
      </div>
    </div>
  </header>
  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="prose prose-blue dark:prose-invert max-w-none">
      <%= @readme_content %>
    </div>
    <!-- Quick Stats -->
    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 dark:text-white">Getting Started</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          New to the project? Start here!
        </p>
        <ul class="mt-4 space-y-2">
          <li>
            <%= link_to "Quick Start →", doc_page_path("getting-started/quick-start"), class: "text-blue-600 hover:text-blue-800 dark:text-blue-400" %>
          </li>
          <li>
            <%= link_to "Project Overview →", doc_page_path("getting-started/project-overview"), class: "text-blue-600 hover:text-blue-800 dark:text-blue-400" %>
          </li>
          <li>
            <%= link_to "Development Setup →", doc_page_path("getting-started/development-setup"), class: "text-blue-600 hover:text-blue-800 dark:text-blue-400" %>
          </li>
        </ul>
      </div>
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 dark:text-white">Architecture</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          Understand how it's built
        </p>
        <ul class="mt-4 space-y-2">
          <li>
            <%= link_to "Tech Stack →", doc_page_path("architecture/tech-stack"), class: "text-blue-600 hover:text-blue-800 dark:text-blue-400" %>
          </li>
          <li>
            <%= link_to "Rails Importmap →", doc_page_path("architecture/rails-importmap"), class: "text-blue-600 hover:text-blue-800 dark:text-blue-400" %>
          </li>
        </ul>
      </div>
      <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-gray-900 dark:text-white">Features</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          Explore unique features
        </p>
        <ul class="mt-4 space-y-2">
          <li>
            <%= link_to "Terminal Emulator →", doc_page_path("features/terminal-emulator"), class: "text-blue-600 hover:text-blue-800 dark:text-blue-400" %>
          </li>
        </ul>
      </div>
    </div>
  </main>
</div>
