<div class="min-h-screen bg-gray-50 dark:bg-gray-900">
  <!-- Header with Breadcrumbs -->
  <header class="bg-white dark:bg-gray-800 shadow">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <!-- Breadcrumbs -->
      <nav class="flex mb-4" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <% @breadcrumbs.each_with_index do |crumb, index| %>
            <li class="inline-flex items-center">
              <% if index > 0 %>
                <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
              <% end %>
              <%= link_to crumb[:name], crumb[:path], class: "text-gray-700 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400 #{'font-medium' if index == @breadcrumbs.length - 1}" %>
            </li>
          <% end %>
        </ol>
      </nav>
      <!-- Title -->
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">
        <%= @title %>
      </h1>
    </div>
  </header>
  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg">
      <div class="px-8 py-6">
        <article class="prose prose-blue dark:prose-invert max-w-none">
          <%= @content %>
        </article>
      </div>
      <!-- Footer Actions -->
      <div class="border-t border-gray-200 dark:border-gray-700 px-8 py-4">
        <div class="flex items-center justify-between">
          <%= link_to "← Back to Docs", docs_path, class: "text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300" %>
          <a href="https://github.com/mathisto/mattkelly.io/edit/trunk/docs/<%= @doc_path %>.md" 
             target="_blank"
             rel="noopener noreferrer"
             class="text-gray-600 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-300">
            Edit on GitHub →
          </a>
        </div>
      </div>
    </div>
  </main>
</div>
