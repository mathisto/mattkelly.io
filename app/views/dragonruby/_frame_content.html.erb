<div class="dragonruby-fullscreen" data-controller="dragonruby-split">
  <div class="dragonruby-split-pane">
    <div class="left-pane editor-pane">
      <div class="editor-container" 
           data-dragonruby-split-target="editor"
           data-starter-code="<%= ERB::Util.html_escape(tutorial.literate_code) %>">
      </div>
    </div>
    <div class="resize-handle" data-dragonruby-split-target="resizeHandle"></div>
    <div class="right-pane canvas-pane">
      <div class="canvas-container" data-dragonruby-split-target="canvas">
        <p class="canvas-placeholder">🎮 Loading DragonRuby engine...</p>
      </div>
    </div>
  </div>
</div>
<style>
  .dragonruby-fullscreen {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .dragonruby-split-pane {
    display: flex;
    flex: 1;
    overflow: hidden;
    background: #1a1b26;
  }

  .left-pane {
    flex: 0 0 50%;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .right-pane {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .resize-handle {
    width: 4px;
    background: #29293f;
    cursor: col-resize;
    transition: background 0.2s ease;
  }

  .resize-handle:hover {
    background: #7aa2f7;
  }

  .editor-container,
  .canvas-container {
    flex: 1;
    background: #1a1b26;
    overflow: hidden;
    min-height: 0;
  }

  .editor-container .cm-editor {
    height: 100%;
  }

  .editor-container .cm-scroller {
    overflow: auto;
  }

  .canvas-container {
    position: relative;
    display: flex;
    background: #1a1b26;
  }

  .canvas-container iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .canvas-placeholder {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #565f89;
    font-style: italic;
    z-index: 10;
    pointer-events: none;
  }

  .canvas-container .loading {
    color: #7aa2f7;
    font-size: 1.125rem;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .canvas-container code {
    background: rgba(122, 162, 247, 0.15);
    color: #9ece6a;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
  }

  .canvas-container details {
    margin-top: 1.5rem;
    text-align: left;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .canvas-container summary {
    color: #7aa2f7;
    cursor: pointer;
    user-select: none;
    padding: 0.5rem;
    border-radius: 0.25rem;
    transition: background 0.2s ease;
  }

  .canvas-container summary:hover {
    background: rgba(122, 162, 247, 0.1);
  }

  .canvas-container pre {
    margin-top: 1rem;
    background: #24283b;
    padding: 1rem;
    border-radius: 0.375rem;
    overflow-x: auto;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .dragonruby-split-pane {
      flex-direction: column;
    }

    .left-pane {
      flex: 0 0 400px;
    }

    .right-pane {
      flex: 0 0 300px;
    }

    .resize-handle {
      width: 100%;
      height: 4px;
      cursor: row-resize;
    }
  }
</style>
