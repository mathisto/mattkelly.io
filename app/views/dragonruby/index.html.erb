<% content_for :title, "DragonRuby Interactive Fiddle" %>
<div class="dragonruby-spa" data-controller="dragonruby-spa">
  <aside class="tutorial-sidebar" data-dragonruby-spa-target="sidebar">
    <div class="sidebar-header">
      <h2 class="sidebar-title">
        <span class="icon">🐉</span>
        DragonRuby Tutorials
      </h2>
      <button class="close-btn" data-action="click->dragonruby-spa#closeSidebar" aria-label="Close menu">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <nav class="tutorial-nav">
      <% if @tutorials.empty? %>
        <div class="empty-state">
          <p>No tutorials available yet.</p>
        </div>
      <% else %>
        <% @tutorials.group_by(&:difficulty).each do |difficulty, tutorials| %>
          <div class="difficulty-group" data-difficulty="<%= difficulty %>">
            <button class="difficulty-header <%= difficulty %>" 
                    data-action="click->dragonruby-spa#toggleDifficulty"
              data-difficulty="<%= difficulty %>"
              aria-expanded="true">
              <span class="header-text"><%= difficulty.capitalize %></span>
              <i class="fas fa-chevron-down accordion-icon"></i>
            </button>
            <ul class="tutorial-list" data-list="<%= difficulty %>">
              <% tutorials.each do |tutorial| %>
                <li>
                  <%= link_to dragonruby_tutorial_path(tutorial), 
                      class: "tutorial-nav-link",
                      data: { 
                        action: "click->dragonruby-spa#loadTutorial",
                        tutorial_slug: tutorial.slug,
                        tutorial_title: tutorial.title
                      } do %>
                    <span class="tutorial-number"><%= tutorial.order.to_s.rjust(2, '0') %></span>
                    <span class="tutorial-name"><%= tutorial.title %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      <% end %>
    </nav>
  </aside>
  <button class="hamburger-btn" 
          data-action="click->dragonruby-spa#toggleSidebar"
    data-dragonruby-spa-target="hamburger"
    aria-label="Toggle menu">
    <span></span>
    <span></span>
    <span></span>
  </button>
  <main class="tutorial-main">
    <div class="tutorial-toolbar">
      <div class="toolbar-left">
        <span class="tutorial-title-display" data-dragonruby-spa-target="titleDisplay">
          Select a tutorial to begin
        </span>
      </div>
      <div class="toolbar-right">
        <button class="btn-toolbar btn-run" data-action="click->dragonruby-spa#run" disabled>
          <i class="fas fa-play"></i> Run
        </button>
        <button class="btn-toolbar btn-reset" data-action="click->dragonruby-spa#reset" disabled>
          <i class="fas fa-undo"></i> Reset
        </button>
      </div>
    </div>
    <turbo-frame id="tutorial-content" class="tutorial-frame">
      <div class="welcome-screen">
        <div class="welcome-content">
          <h1 class="rainbow-text">🐉 DragonRuby Interactive Fiddle</h1>
          <p class="subtitle">Learn game development with DragonRuby through interactive tutorials</p>
          <div class="features">
            <div class="feature">
              <i class="fas fa-code"></i>
              <h3>Live Coding</h3>
              <p>Write and execute Ruby code in real-time</p>
            </div>
            <div class="feature">
              <i class="fas fa-gamepad"></i>
              <h3>Interactive Canvas</h3>
              <p>See your game come to life instantly</p>
            </div>
            <div class="feature">
              <i class="fas fa-graduation-cap"></i>
              <h3>Guided Learning</h3>
              <p>Step-by-step tutorials from basics to advanced</p>
            </div>
          </div>
          <div class="cta">
            <button class="btn-primary" data-action="click->dragonruby-spa#openSidebar">
              <i class="fas fa-arrow-left"></i>
              Choose a Tutorial to Start
            </button>
          </div>
        </div>
      </div>
    </turbo-frame>
  </main>
</div>
<style>
  .dragonruby-spa {
    position: fixed;
    top: 4rem;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    background: #1a1b26;
    overflow: hidden;
  }

  .tutorial-sidebar {
    position: fixed;
    top: 4rem;
    left: 0;
    width: 320px;
    height: calc(100vh - 4rem);
    background: rgba(26, 27, 38, 0.98);
    border-right: 1px solid #29293f;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 100;
    overflow-y: auto;
    backdrop-filter: blur(10px);
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.3);
  }

  .tutorial-sidebar.open {
    transform: translateX(0);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid #29293f;
    position: sticky;
    top: 0;
    background: rgba(26, 27, 38, 0.95);
    backdrop-filter: blur(10px);
    z-index: 10;
  }

  .sidebar-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: #a9b1d6;
  }

  .sidebar-title .icon {
    font-size: 1.5rem;
  }

  .close-btn {
    width: 36px;
    height: 36px;
    border: none;
    background: rgba(169, 177, 214, 0.1);
    color: #a9b1d6;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
  }

  .close-btn:hover {
    background: rgba(169, 177, 214, 0.2);
    color: #7aa2f7;
  }

  .tutorial-nav {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .difficulty-group {
    margin-bottom: 1rem;
    width: 100%;
  }

  .difficulty-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
    border: none;
    border-bottom: 2px solid;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
  }

  .difficulty-header:hover {
    background: rgba(122, 162, 247, 0.05);
  }

  .difficulty-header .header-text {
    flex: 1;
  }

  .difficulty-header .accordion-icon {
    font-size: 0.75rem;
    transition: transform 0.3s ease;
  }

  .difficulty-header.beginner {
    color: #9ece6a;
    border-color: rgba(158, 206, 106, 0.3);
  }

  .difficulty-header.intermediate {
    color: #ff9e64;
    border-color: rgba(255, 158, 100, 0.3);
  }

  .difficulty-header.advanced {
    color: #f7768e;
    border-color: rgba(247, 118, 142, 0.3);
  }

  .tutorial-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 1000px;
    opacity: 1;
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.3s ease;
  }

  .tutorial-list li {
    margin-bottom: 0.25rem;
  }

  .tutorial-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    color: #a9b1d6;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.2s ease;
    font-size: 0.875rem;
    position: relative;
  }

  .tutorial-nav-link:hover {
    background: rgba(122, 162, 247, 0.1);
    color: #7aa2f7;
    transform: translateX(4px);
  }

  .tutorial-nav-link.active {
    background: rgba(122, 162, 247, 0.2);
    color: #7aa2f7;
    border-left: 3px solid #7aa2f7;
    padding-left: calc(1rem - 3px);
  }

  .tutorial-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: #565f89;
    font-weight: 500;
  }

  .tutorial-nav-link.active .tutorial-number {
    color: #7aa2f7;
  }

  .tutorial-name {
    flex: 1;
  }

  .hamburger-btn {
    position: fixed;
    top: 5rem;
    left: 1rem;
    z-index: 101;
    width: 48px;
    height: 48px;
    background: rgba(122, 162, 247, 0.15);
    border: 1px solid rgba(122, 162, 247, 0.3);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    padding: 0;
    transition: all 0.2s ease;
    opacity: 1;
    visibility: visible;
  }

  .sidebar-open .hamburger-btn {
    opacity: 0;
    visibility: hidden;
  }

  .hamburger-btn:hover {
    background: rgba(122, 162, 247, 0.25);
    border-color: rgba(122, 162, 247, 0.5);
    transform: scale(1.05);
    box-shadow: 0 0 20px rgba(122, 162, 247, 0.3);
  }

  .hamburger-btn span {
    width: 20px;
    height: 2px;
    background: #7aa2f7;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .sidebar-open .hamburger-btn span:nth-child(1) {
    transform: rotate(45deg) translate(6px, 6px);
  }

  .sidebar-open .hamburger-btn span:nth-child(2) {
    opacity: 0;
  }

  .sidebar-open .hamburger-btn span:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
  }

  .tutorial-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-left: 0;
    transition: margin-left 0.3s ease;
    width: 100%;
  }

  .tutorial-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
    background: rgba(26, 27, 38, 0.95);
    border-bottom: 1px solid #29293f;
    backdrop-filter: blur(8px);
    min-height: 60px;
  }

  .toolbar-left {
    flex: 1;
    display: flex;
    align-items: center;
    margin-left: 4rem;
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tutorial-title-display {
    font-size: 1.125rem;
    font-weight: 600;
    color: #a9b1d6;
  }

  .btn-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border: none;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Inter', sans-serif;
  }

  .btn-toolbar:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-run {
    background: rgba(122, 162, 247, 0.15);
    color: #7aa2f7;
    border: 1px solid rgba(122, 162, 247, 0.3);
  }

  .btn-run:hover:not(:disabled) {
    background: rgba(122, 162, 247, 0.25);
    border-color: rgba(122, 162, 247, 0.5);
    transform: translateY(-1px);
  }

  .btn-reset {
    background: rgba(169, 177, 214, 0.1);
    color: #a9b1d6;
    border: 1px solid rgba(169, 177, 214, 0.2);
  }

  .btn-reset:hover:not(:disabled) {
    background: rgba(169, 177, 214, 0.15);
    border-color: rgba(169, 177, 214, 0.3);
    transform: translateY(-1px);
  }

  .tutorial-frame {
    flex: 1;
    display: flex;
    background: #1a1b26;
    overflow: hidden;
  }

  .welcome-screen {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
  }

  .welcome-content {
    max-width: 800px;
  }

  .rainbow-text {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    background: linear-gradient(90deg, #7aa2f7, #bb9af7, #9ece6a, #7aa2f7);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: rainbow 3s ease-in-out infinite;
  }

  @keyframes rainbow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .subtitle {
    font-size: 1.25rem;
    color: #a9b1d6;
    margin-bottom: 3rem;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .feature {
    padding: 1.5rem;
    background: rgba(122, 162, 247, 0.05);
    border: 1px solid rgba(122, 162, 247, 0.2);
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .feature:hover {
    background: rgba(122, 162, 247, 0.1);
    border-color: rgba(122, 162, 247, 0.3);
    transform: translateY(-2px);
  }

  .feature i {
    font-size: 2rem;
    color: #7aa2f7;
    margin-bottom: 1rem;
  }

  .feature h3 {
    font-size: 1.125rem;
    color: #a9b1d6;
    margin-bottom: 0.5rem;
  }

  .feature p {
    font-size: 0.875rem;
    color: #565f89;
    margin: 0;
  }

  .cta {
    margin-top: 2rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    background: rgba(122, 162, 247, 0.15);
    color: #7aa2f7;
    border: 1px solid rgba(122, 162, 247, 0.3);
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Inter', sans-serif;
  }

  .btn-primary:hover {
    background: rgba(122, 162, 247, 0.25);
    border-color: rgba(122, 162, 247, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(122, 162, 247, 0.3);
  }

  @media (min-width: 768px) {
    .sidebar-open .tutorial-main {
      margin-left: 320px;
    }
  }

  @media (max-width: 767px) {
    .close-btn {
      display: flex;
    }

    .toolbar-left {
      margin-left: 3.5rem;
    }
  }

  .empty-state {
    padding: 2rem 1rem;
    text-align: center;
    color: #565f89;
  }
</style>
