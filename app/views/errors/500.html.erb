<%# 500 Page - Cyberpunk Edition %>
<div class="error-page">
  <div class="cat-container">
    <div class="cat-border">
      <img src="https://http.cat/500" alt="500 Internal Server Error Cat" class="error-cat">
    </div>
  </div>
  <div class="back-button-container">
    <a href="/" class="back-button" aria-label="Go back to homepage">
      <i class="fas fa-arrow-left"></i>
    </a>
  </div>
</div>

<%# Enhanced Cyberpunk Styles %>
<style>
  /* Grid Background */
  .grid-bg {
    background-image: 
      linear-gradient(rgba(247, 118, 142, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247, 118, 142, 0.1) 1px, transparent 1px);
    background-size: 50px 50px;
    opacity: 0.5;
    animation: grid-scroll 20s linear infinite;
  }

  @keyframes grid-scroll {
    0% { transform: translateY(0); }
    100% { transform: translateY(50px); }
  }

  /* Main Glitch Container */
  .glitch-container {
    width: min-content;
    filter: drop-shadow(0 0 10px rgba(247, 118, 142, 0.3));
    animation: container-pulse 4s ease infinite;
    transform: scale(1); /* Reset to full size */
    transform-origin: center center;
    margin-bottom: 2rem;
  }

  @keyframes container-pulse {
    0%, 100% { filter: drop-shadow(0 0 10px rgba(247, 118, 142, 0.3)); }
    50% { filter: drop-shadow(0 0 20px rgba(187, 154, 247, 0.5)); }
  }

  /* Base Text Styling */
  .cyberpunk-text {
    text-shadow: 
      4px 4px 0px #bb9af7,
      -4px -4px 0px #7dcfff;
  }

  /* Glitch Base */
  .glitch-base {
    position: relative;
    z-index: 3;
    animation: text-flicker 0.15s infinite;
  }

  /* Text Flicker Animation */
  @keyframes text-flicker {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 1; }
    25%, 75% { opacity: 0.95; }
  }

  /* Button Effects */
  .cyberpunk-button {
    clip-path: polygon(
      0 10px,
      10px 0,
      calc(100% - 10px) 0,
      100% 10px,
      100% calc(100% - 10px),
      calc(100% - 10px) 100%,
      10px 100%,
      0 calc(100% - 10px)
    );
  }

  .cyber-gradient {
    background: linear-gradient(
      45deg,
      rgba(247, 118, 142, 0.5),
      rgba(187, 154, 247, 0.5),
      rgba(125, 207, 255, 0.5)
    );
    animation: gradient-shift 3s linear infinite;
  }

  @keyframes gradient-shift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* Extra Glitch States */
  .extra-glitch .glitch-base {
    animation: extra-glitch-base 0.2s steps(2) infinite;
  }

  @keyframes extra-glitch-base {
    0% { transform: translate(8px, -8px); opacity: 0.7; }
    100% { transform: translate(-8px, 8px); opacity: 0.8; }
  }

  .error-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--tokyo-bg);
    gap: 2rem;
    padding-top: 4rem;
  }

  .cat-container {
    position: relative;
    width: min(90vw, 600px);
    aspect-ratio: 1.5;
  }

  .cat-border {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 4px;
    border-radius: 12px;
    overflow: hidden;
    isolation: isolate;
  }

  .cat-border::before {
    content: '';
    position: absolute;
    inset: -150%;
    background: conic-gradient(
      from 180deg at 50% 50%,
      #f7768e 0deg,
      #bb9af7 60deg,
      #7dcfff 120deg,
      #2ac3de 180deg,
      #73daca 240deg,
      #e0af68 300deg,
      #f7768e 360deg
    );
    animation: rotate 4s linear infinite;
    z-index: 1;
  }

  .error-cat {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
    z-index: 2;
    background: var(--tokyo-bg);
  }

  .back-button-container {
    margin-top: 2rem;
  }

  .back-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    transition: all 0.3s ease;
  }

  .back-button:hover {
    background: rgba(187, 154, 247, 0.2);
    color: #bb9af7;
    transform: translateY(-2px);
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style> 