<%# Consolidated Styles %>
<style>
  /* Base Styles */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Grid System */
  .grid {
    display: grid;
  }

  .grid-cols-1 {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  .gap-y-8 {
    row-gap: 2rem;
  }

  /* Skills Container and Pills */
  .skills-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.25rem, 1.5vw, 0.5rem);
    margin-top: 0.75rem;
    justify-content: center;
  }

  .skill-pill {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: rgba(122, 162, 247, 0.1);
    border: 1px solid rgba(122, 162, 247, 0.2);
    border-radius: 9999px;
    color: #a9b1d6;
    font-size: clamp(0.75rem, 2vw, 0.875rem);
    transition: all 0.3s ease;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.01em;
    pointer-events: auto;
    white-space: nowrap;
  }

  .skill-pill i {
    font-size: clamp(0.875rem, 2vw, 1rem);
    color: #9ece6a !important;
    transition: color 0.3s ease !important;
  }

  /* CTA Section */
  .cta-section .card-actions {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 3vw, 4rem);
    margin-top: clamp(1.5rem, 4vw, 2rem);
    width: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
  }

  .cta-section .card-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
    color: #a9b1d6;
    text-decoration: none;
    padding: clamp(0.4rem, 1vw, 0.5rem) clamp(0.5rem, 1.5vw, 1rem);
    border-radius: 0.375rem;
    position: relative;
    white-space: nowrap;
    min-width: fit-content;
  }

  .cta-section .card-actions a i {
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    color: inherit;
    transition: all 0.3s ease;
  }

  .cta-section .card-actions a span {
    position: relative;
    color: inherit;
    font-size: clamp(0.875rem, 2.5vw, 1rem);
  }

  /* Terminal Styles */
  .terminal-container {
    max-width: 800px;
    margin: 2rem auto;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(122, 162, 247, 0.2);
  }

  .terminal-dots {
    display: flex;
    gap: 0.5rem;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red { background: #f7768e; }
  .dot-yellow { background: #e0af68; }
  .dot-green { background: #9ece6a; }

  .terminal-content {
    font-family: 'Fira Code', monospace;
    color: #a9b1d6;
  }

  .command-prompt {
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .prompt-symbol {
    color: #9ece6a;
    margin-right: 0.5rem;
  }

  .command-text {
    color: #7aa2f7;
  }

  .command-output {
    color: #a9b1d6;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .ascii-art {
    font-family: 'Fira Code', monospace;
    white-space: pre;
    font-size: 0.7rem;
    line-height: 1.2;
    padding: 0.5rem 0;
    display: inline-block;
    background: transparent;
  }

  .terminal-content .command-output pre.ascii-art {
    margin: 0;
    background: transparent;
    border: none;
    padding: 0.5rem 0;
  }

  .role-text {
    white-space: normal;
    font-size: 0.9rem;
    line-height: 1.5;
    padding-right: 1.5rem;
  }

  /* Cursor Animation */
  .cursor {
    display: inline-block;
    width: 0.5rem;
    height: 1.2rem;
    background: #bb9af7;
    margin-left: 0.25rem;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 0; }
    50% { opacity: 1; }
  }

  /* GitHub Heatmap */
  .github-heatmap {
    padding: 1rem;
  }

  .github-heatmap-grid {
    display: flex;
    gap: 3px;
    overflow-x: auto;
    padding-bottom: 1rem;
  }

  .github-heatmap-week {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .github-heatmap-day {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    transition: transform 0.2s ease;
  }

  .github-heatmap-day:hover {
    transform: scale(1.2);
  }

  .github-heatmap-total {
    text-align: center;
    margin-top: 1rem;
    color: #7aa2f7;
    font-size: 0.875rem;
  }

  /* Hover Effects */
  @media (hover: hover) {
    .skill-pill:hover {
      transform: translateY(-2px);
      background: rgba(187, 154, 247, 0.15);
      border-color: rgba(187, 154, 247, 0.3);
    }

    .skill-pill:hover i {
      color: #bb9af7 !important;
    }

    .cta-section .card-actions a::after {
      content: '';
      position: absolute;
      width: 100%;
      height: 2px;
      bottom: -2px;
      left: 0;
      background-color: #bb9af7;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.3s ease;
    }

    .cta-section .card-actions a:hover {
      color: #bb9af7;
      transform: translateY(-2px);
    }

    .cta-section .card-actions a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .cta-section .card-actions a:hover i {
      transform: scale(1.1);
    }
  }

  /* Responsive Breakpoints */
  @media (min-width: 640px) {
    .sm\:gap-8 {
      gap: 2rem;
    }
    
    .sm\:gap-6 {
      gap: 1.5rem;
    }

    .sm\:mt-0 {
      margin-top: 0;
    }
  }

  /* Mobile Optimizations */
  @media (max-width: 639px) {
    .hero {
      padding: 2rem 1rem;
    }

    .hero h1 {
      margin-bottom: 1rem;
    }

    .hero p {
      font-size: 1.125rem;
      max-width: 90%;
      margin: 0 auto;
    }

    .dev-card {
      padding: 1.5rem;
      margin-bottom: 3rem !important;
    }

    .dev-card .card-title {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .dev-card .card-content {
      font-size: 1rem;
      margin-bottom: 1rem;
    }

    .skills-container {
      padding: 0.5rem;
    }

    .grid.gap-8 {
      gap: 4rem !important;
    }

    .py-2 {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    .py-4 {
      padding-top: 4rem !important;
      padding-bottom: 4rem !important;
    }

    /* Mobile CTA Adjustments */
    .cta-section .dev-card {
      padding: 1.25rem;
      width: 100%;
      max-width: 100%;
    }

    .cta-section .card-actions {
      gap: 1rem;
      padding: 0;
      margin-top: 1rem;
      justify-content: space-around;
    }

    .cta-section .card-actions a {
      font-size: 0.875rem;
      padding: 0.5rem;
    }

    .cta-section .card-actions a i {
      font-size: 1rem;
    }

    .cta-section .card-content {
      font-size: 0.9375rem;
      margin-bottom: 0.5rem;
    }

    /* Mobile GitHub Heatmap */
    .github-heatmap {
      padding: 0.5rem;
    }

    .github-heatmap-grid {
      gap: 2px;
    }

    .github-heatmap-day {
      width: 8px;
      height: 8px;
    }

    .mt-8 {
      margin-top: 2rem;
    }

    .dev-card {
      transform: none !important;
      margin-bottom: 3rem !important;
    }

    .dev-card:hover {
      transform: none !important;
    }
  }
</style>

