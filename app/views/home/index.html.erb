<%# Hero Section %>
<style>
  /* Skills Container and Pills - Copied from CV page */
  .skills-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .skill-pill {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: rgba(122, 162, 247, 0.1);
    border: 1px solid rgba(122, 162, 247, 0.2);
    border-radius: 9999px;
    color: #a9b1d6;
    font-size: 0.875rem;
    transition: all 0.3s ease;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.01em;
    pointer-events: auto;
  }

  .skill-pill:hover {
    transform: translateY(-2px);
    background: rgba(187, 154, 247, 0.15);
    border-color: rgba(187, 154, 247, 0.3);
  }

  .skill-pill i {
    color: #9ece6a !important;
    transition: color 0.3s ease !important;
  }

  .skill-pill:hover i {
    color: #bb9af7 !important;
  }

  /* Improve icon alignment and sizing in CTA section */
  .cta-section .card-actions {
    display: flex;
    justify-content: center;
    gap: 4rem;
    margin-top: 2rem;
    width: 100%;
  }

  .cta-section .card-actions a {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    transition: all 0.3s ease;
    min-width: 8rem;
  }

  .cta-section .card-actions a i {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.5rem;
    color: #a9b1d6;
    transition: all 0.3s ease;
  }

  .cta-section .card-actions a:hover i {
    transform: translateY(-4px) scale(1.1);
    color: #bb9af7;
  }

  .cta-section .card-actions a span {
    display: block;
    width: 100%;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .cta-section .card-actions a:hover span {
    color: #bb9af7;
  }
</style>

<section class="hero py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-controller="entrance" data-entrance-delay-value="0" class="text-center">
      <h1 class="animate-fade-in mb-4">Hi, I'm Matt Kelly</h1>
      <p class="animate-slide-in-left mx-auto">Managing Staff Software Engineer passionate about elegant solutions and mentoring.</p>
    </div>
  </div>
</section>

<%# Core Skills %>
<section class="py-4">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="section-header text-center mb-8" data-controller="entrance" data-entrance-delay-value="100">
      <h2>Core Expertise</h2>
    </div>

    <div class="grid gap-6" data-controller="entrance" data-entrance-delay-value="200">
      <div class="dev-card animate-slide-in-left">
        <h3 class="card-title text-center">System Architecture</h3>
        <p class="card-content">
          Designing scalable, maintainable systems with a focus on high-level abstractions and clean interfaces.
          Experienced in microservices, API design, and complex system integration.
        </p>
        <div class="skills-container justify-center">
          <span class="skill-pill">
            <i class="fas fa-sitemap"></i>
            System Design
          </span>
          <span class="skill-pill">
            <i class="fas fa-code-branch"></i>
            Microservices
          </span>
          <span class="skill-pill">
            <i class="fas fa-project-diagram"></i>
            API Design
          </span>
        </div>
      </div>

      <div class="dev-card animate-fade-in">
        <h3 class="card-title text-center">Technical Leadership</h3>
        <p class="card-content">
          Leading engineering teams with a focus on mentorship, knowledge sharing, and building high-performing cultures.
          Strong emphasis on code quality and best practices.
        </p>
        <div class="skills-container justify-center">
          <span class="skill-pill">
            <i class="fas fa-users"></i>
            Team Leadership
          </span>
          <span class="skill-pill">
            <i class="fas fa-graduation-cap"></i>
            Mentoring
          </span>
          <span class="skill-pill">
            <i class="fas fa-code"></i>
            Best Practices
          </span>
        </div>
      </div>

      <div class="dev-card animate-slide-in-right">
        <h3 class="card-title text-center">Cloud & DevOps</h3>
        <p class="card-content">
          Implementing robust CI/CD pipelines and cloud infrastructure with a focus on security, scalability, and automation.
        </p>
        <div class="skills-container justify-center">
          <span class="skill-pill">
            <i class="fas fa-cloud"></i>
            Cloud Architecture
          </span>
          <span class="skill-pill">
            <i class="fas fa-infinity"></i>
            CI/CD
          </span>
          <span class="skill-pill">
            <i class="fas fa-shield-alt"></i>
            Security
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

