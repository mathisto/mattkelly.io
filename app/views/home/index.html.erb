<div class="prose dark:prose-invert max-w-none">
  <h1 class="font-heading text-gray-900 dark:text-white">Welcome to MattKelly.io</h1>
  
  <p class="text-lg text-gray-700 dark:text-gray-300">
    Full-stack developer passionate about building elegant solutions with Ruby on Rails and modern JavaScript.
  </p>

  <h2 class="font-heading text-gray-900 dark:text-white">Test Typography</h2>
  
  <p class="text-gray-700 dark:text-gray-300">This is a regular paragraph using Lato font. Here's some <code class="font-mono bg-gray-100 dark:bg-gray-800 px-1 rounded">inline code</code> using Fira Code.</p>
  
  <pre class="bg-gray-100 dark:bg-gray-800 p-4 rounded-lg"><code class="font-mono text-gray-900 dark:text-white">def hello_world
  puts "Hello, World!"
end</code></pre>

  <h3 class="font-heading text-gray-900 dark:text-white">Theme Test</h3>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
    <div class="p-4 rounded-lg bg-gray-100 dark:bg-gray-800">
      <p class="text-blue-600 dark:text-blue-400">Primary Blue</p>
      <p class="text-green-600 dark:text-green-400">Success Green</p>
      <p class="text-red-600 dark:text-red-400">Error Red</p>
    </div>
    
    <div class="p-4 rounded-lg bg-gray-100 dark:bg-gray-800">
      <p class="text-purple-600 dark:text-purple-400">Purple</p>
      <p class="text-cyan-600 dark:text-cyan-400">Cyan</p>
      <p class="text-orange-600 dark:text-orange-400">Orange</p>
    </div>
  </div>

  <h2>Code Example</h2>
  
  <%= render partial: "shared/code_block", locals: {
    language: "ruby",
    filename: "app/models/user.rb",
    code: <<~RUBY
      class User < ApplicationRecord
        include Authenticatable
        
        has_many :posts, dependent: :destroy
        has_many :comments
        
        validates :email, presence: true, uniqueness: true
        validates :username, presence: true, length: { minimum: 3 }
        
        def full_name
          [first_name, last_name].compact.join(' ')
        end
        
        def authored_post?(post)
          posts.include?(post)
        end
      end
    RUBY
  } %>

  <h3 class="mt-8">JavaScript Example</h3>
  
  <%= render partial: "shared/code_block", locals: {
    language: "javascript",
    filename: "app/javascript/controllers/code_block_controller.js",
    code: <<~JAVASCRIPT
      import { Controller } from "@hotwired/stimulus"

      export default class extends Controller {
        static targets = ["code", "copyButton"]
        
        async copy() {
          const code = this.codeTarget.textContent
          await navigator.clipboard.writeText(code)
          
          this.showCopySuccess()
        }
        
        showCopySuccess() {
          // Show success state
          this.element.classList.add('copied')
          
          // Reset after 2 seconds
          setTimeout(() => {
            this.element.classList.remove('copied')
          }, 2000)
        }
      }
    JAVASCRIPT
  } %>
</div>
