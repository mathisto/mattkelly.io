<%# Hero Section %>
<style>
  /* Skills Container and Pills - Copied from CV page */
  .skills-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.25rem, 1.5vw, 0.5rem);
    margin-top: 0.75rem;
    justify-content: center;
  }

  .skill-pill {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: rgba(122, 162, 247, 0.1);
    border: 1px solid rgba(122, 162, 247, 0.2);
    border-radius: 9999px;
    color: #a9b1d6;
    font-size: clamp(0.75rem, 2vw, 0.875rem);
    transition: all 0.3s ease;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.01em;
    pointer-events: auto;
    white-space: nowrap;
  }

  .skill-pill i {
    font-size: clamp(0.875rem, 2vw, 1rem);
    color: #9ece6a !important;
    transition: color 0.3s ease !important;
  }

  @media (hover: hover) {
    .skill-pill:hover {
      transform: translateY(-2px);
      background: rgba(187, 154, 247, 0.15);
      border-color: rgba(187, 154, 247, 0.3);
    }

    .skill-pill:hover i {
      color: #bb9af7 !important;
    }
  }

  /* Improve icon alignment and sizing in CTA section */
  .cta-section .card-actions {
    display: flex;
    justify-content: center;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(1.5rem, 4vw, 2rem);
    width: 100%;
  }

  .cta-section .card-actions a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: all 0.3s ease;
    color: #a9b1d6;
    text-decoration: none;
    padding: clamp(0.4rem, 1.5vw, 0.5rem) clamp(0.75rem, 2vw, 1rem);
    border-radius: 0.375rem;
    position: relative;
  }

  @media (hover: hover) {
    .cta-section .card-actions a::after {
      content: '';
      position: absolute;
      width: 100%;
      height: 2px;
      bottom: -2px;
      left: 0;
      background-color: #bb9af7;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.3s ease;
    }

    .cta-section .card-actions a:hover {
      color: #bb9af7;
      transform: translateY(-2px);
    }

    .cta-section .card-actions a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .cta-section .card-actions a:hover i {
      transform: scale(1.1);
    }
  }

  .cta-section .card-actions a i {
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    color: inherit;
    transition: all 0.3s ease;
  }

  .cta-section .card-actions a span {
    position: relative;
    color: inherit;
    font-size: clamp(0.875rem, 2.5vw, 1rem);
  }

  /* Mobile optimizations */
  @media (max-width: 639px) {
    .hero {
      padding: 2rem 1rem;
    }

    .hero h1 {
      margin-bottom: 1rem;
    }

    .hero p {
      font-size: 1.125rem;
      max-width: 90%;
      margin: 0 auto;
    }

    .dev-card {
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    .dev-card .card-title {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .dev-card .card-content {
      font-size: 1rem;
      margin-bottom: 1rem;
    }

    .skills-container {
      padding: 0.5rem;
    }

    .grid.gap-8 {
      gap: 2rem;
    }
  }
</style>

<section class="hero py-8 sm:py-10">
