<%# Consolidated Styles %>
<style>
  /* Base Styles */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Grid System */
  .grid {
    display: grid;
  }

  .dev-card {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .grid-cols-1 {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }

  .gap-y-8 {
    row-gap: 2rem;
  }

  /* Skills Container and Pills */
  .skills-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.25rem, 1.5vw, 0.5rem);
    margin-top: 0.75rem;
    justify-content: center;
  }

  .skill-pill {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: rgba(122, 162, 247, 0.1);
    border: 1px solid rgba(122, 162, 247, 0.2);
    border-radius: 9999px;
    color: #a9b1d6;
    font-size: clamp(0.75rem, 2vw, 0.875rem);
    transition: all 0.3s ease;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.01em;
    pointer-events: auto;
    white-space: nowrap;
  }

  .skill-pill i {
    font-size: clamp(0.875rem, 2vw, 1rem);
    color: #9ece6a !important;
    transition: color 0.3s ease !important;
  }

  /* CTA Section */
  .cta-section .card-actions {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 3vw, 4rem);
    margin-top: clamp(1.5rem, 4vw, 2rem);
    width: 100%;
    flex-direction: row;
    flex-wrap: nowrap;
  }

  .cta-section .card-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s ease;
    color: #a9b1d6;
    text-decoration: none;
    padding: clamp(0.4rem, 1vw, 0.5rem) clamp(0.5rem, 1.5vw, 1rem);
    border-radius: 0.375rem;
    position: relative;
    white-space: nowrap;
    min-width: fit-content;
  }

  .cta-section .card-actions a i {
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    color: inherit;
    transition: all 0.3s ease;
  }

  .cta-section .card-actions a span {
    position: relative;
    color: inherit;
    font-size: clamp(0.875rem, 2.5vw, 1rem);
  }

  /* Terminal Styles */
  .terminal-container {
    max-width: 800px;
    margin: 0 auto;
    height: 400px;
    display: flex;
    flex-direction: column;
    text-align: left !important;
    background: #1f2335;
    min-height: 400px;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(122, 162, 247, 0.2);
    text-align: left;
  }

  .terminal-dots {
    display: flex;
    gap: 0.5rem;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red { background: #f7768e; }
  .dot-yellow { background: #e0af68; }
  .dot-green { background: #9ece6a; }

  .terminal-output {
    flex: 1;
    overflow-y: auto;
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 1rem;
    font-family: 'Fira Code', monospace;
    color: #a9b1d6;
    text-align: left;
  }

  .terminal-output > div {
    white-space: pre-wrap;
    word-break: normal;
    overflow-wrap: break-word;
    text-align: left;
  }

  .terminal-output a {
    word-break: keep-all;
    white-space: nowrap;
    pointer-events: auto;
    position: relative;
    z-index: 10;
  }

  .terminal-output a:hover {
    opacity: 0.8;
  }

  .terminal-input-line {
    display: flex;
    align-items: center;
    font-size: 14px;
    font-family: 'Fira Code', monospace;
    text-align: left;
  }

  .terminal-prompt {
    margin-right: 0.5rem;
    flex-shrink: 0;
  }

  .terminal-input {
    flex: 1;
    outline: none;
    color: #a9b1d6;
    white-space: pre;
    min-width: 0;
  }

  .cursor {
    display: inline;
    background: rgba(187, 154, 247, 0.4);
    animation: blink 1.5s ease-in-out infinite;
  }

  .cursor:empty::before {
    content: '\00a0';
  }

  @keyframes blink {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  /* GitHub Heatmap */
  .github-heatmap {
    padding: 1rem;
    padding-bottom: 0.5rem;
    display: flex;
    flex-direction: column;
  }

  .github-heatmap-grid {
    display: flex;
    gap: 3px;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
    min-height: fit-content;
  }

  .github-heatmap-week {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .github-heatmap-day {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    transition: transform 0.2s ease;
  }

  .github-heatmap-day:hover {
    transform: scale(1.2);
  }

  .github-heatmap-total {
    text-align: center;
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    color: #7aa2f7;
    font-size: 0.875rem;
  }

  /* Hover Effects */
  @media (hover: hover) {
    .skill-pill:hover {
      transform: translateY(-2px);
      background: rgba(187, 154, 247, 0.15);
      border-color: rgba(187, 154, 247, 0.3);
    }

    .skill-pill:hover i {
      color: #bb9af7 !important;
    }

    .cta-section .card-actions a::after {
      content: '';
      position: absolute;
      width: 100%;
      height: 2px;
      bottom: -2px;
      left: 0;
      background-color: #bb9af7;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.3s ease;
    }

    .cta-section .card-actions a:hover {
      color: #bb9af7;
      transform: translateY(-2px);
    }

    .cta-section .card-actions a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .cta-section .card-actions a:hover i {
      transform: scale(1.1);
    }
  }

  /* Responsive Breakpoints */
  @media (min-width: 640px) {
    .sm\:gap-8 {
      gap: 2rem;
    }

    .sm\:gap-6 {
      gap: 1.5rem;
    }

    .sm\:mt-0 {
      margin-top: 0;
    }
  }

  /* Mobile Optimizations */
  @media (max-width: 639px) {
    .hero {
      padding: 1rem;
    }

    .hero h1 {
      margin-bottom: 0.5rem;
    }

    .hero p {
      font-size: 1.125rem;
      max-width: 90%;
      margin: 0 auto;
    }

    .dev-card {
      padding: 1.25rem;
      margin-bottom: 1.5rem !important;
      max-width: 100%;
    }

    .dev-card + .dev-card {
      margin-top: 1rem;
    }

    .section-header {
      margin-bottom: 1.5rem !important;
    }

    .dev-card .card-title {
      font-size: 1.25rem;
      margin-bottom: 0.5rem;
    }

    .dev-card .card-content {
      font-size: 1rem;
      margin-bottom: 0.5rem;
    }

    .skills-container {
      padding: 0.25rem;
      margin-top: 0.5rem;
      margin-bottom: 0.25rem;
    }

    .grid.gap-6 {
      gap: 1.5rem !important;
    }

    .py-2 {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .py-4 {
      padding-top: 1.5rem !important;
      padding-bottom: 1.5rem !important;
    }

    /* Mobile CTA Adjustments */
    .cta-section .dev-card {
      padding: 1.25rem;
      width: 100%;
      max-width: 100%;
    }

    .cta-section .card-actions {
      gap: 1rem;
      padding: 0;
      margin-top: 1rem;
      justify-content: space-around;
    }

    .cta-section .card-actions a {
      font-size: 0.875rem;
      padding: 0.5rem;
    }

    .cta-section .card-actions a i {
      font-size: 1rem;
    }

    .cta-section .card-actions a span {
      font-size: 0.9375rem;
      margin-bottom: 0.5rem;
    }

    /* Mobile GitHub Heatmap */
    .github-heatmap {
      padding: 0.5rem;
      overflow: hidden;
      max-height: none;
      display: flex;
      flex-direction: column;
      margin-bottom: 0;
      width: 100%;
      align-items: center;
      position: relative;
    }

    .github-heatmap-grid {
      gap: 2px;
      width: 95%;
      overflow: hidden;
      -webkit-overflow-scrolling: touch;
      padding: 0.5rem 1rem;
      min-height: fit-content;
      transform-origin: center;
      transform: scale(0.75);
      margin: 0 auto;
      display: flex;
      justify-content: center;
      position: relative;
      left: 0;
    }

    .github-heatmap-week {
      gap: 2px;
      display: flex;
      flex-direction: column;
    }

    .github-heatmap-day {
      width: 8px;
      height: 8px;
      min-width: 8px;
    }

    /* Ensure proper card separation and corners */
    section:has(.github-heatmap) .dev-card {
      margin-bottom: 1.5rem !important;
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      padding: 1rem !important;
      min-height: 0;
      height: auto;
      align-items: center;
      overflow: hidden;
    }

    .dev-card[data-controller="github-heatmap"] {
      min-height: 0;
      height: auto;
      display: flex;
      flex-direction: column;
      overflow: hidden !important;
      padding: 1.25rem !important;
      align-items: center;
    }

    /* Ensure bottom corners and border are visible */
    .dev-card[data-controller="github-heatmap"]::after {
      content: '';
      position: absolute;
      bottom: -1px;
      left: 0;
      right: 0;
      height: 8px;
      background: var(--background-color, #1a1b26);
      z-index: 1;
      border-bottom-left-radius: 0.5rem;
      border-bottom-right-radius: 0.5rem;
    }

    .github-heatmap-total {
      position: relative;
      z-index: 2;
      margin: 0.5rem 0;
      padding-bottom: 0.25rem;
    }

    /* CTA specific adjustments */
    .cta-section {
      position: relative;
      z-index: 2;
      padding-top: 1.5rem !important;
      margin-top: 1.5rem !important;
      width: 100%;
      background: var(--background-color, #1a1b26);
      overflow: visible;
    }

    .cta-section .max-w-7xl {
      padding: 0 1rem;
      width: 100%;
      box-sizing: border-box;
      overflow: visible;
    }

    .cta-section .dev-card {
      border-radius: 0.5rem;
      position: relative;
      z-index: 3;
      margin: 0 auto;
      width: 100%;
      background: var(--background-color, #1a1b26);
      padding: 1.5rem 1rem;
      overflow: visible;
    }

    /* Container adjustments for mobile */
    .max-w-7xl {
      width: 100%;
      margin: 0 auto;
      padding: 0 1rem;
      box-sizing: border-box;
    }

    /* Ensure proper spacing around edges */
    section {
      width: 100%;
      overflow: visible;
    }

    .dev-card {
      overflow: visible !important;
      border-radius: 0.5rem !important;
    }

    /* Adjust section spacing */
    section + section {
      margin-top: 3rem;
    }

    /* Specific fixes for known problem areas */
    section.py-16 {
      padding-top: 3rem;
      padding-bottom: 3rem;
      margin-bottom: 1rem;
    }

    /* Ensure grid gaps are respected */
    .grid.gap-6,
    .grid.gap-8 {
      gap: 3rem !important;
    }
  }
</style>
<%# Hero Section %>
<h1 class="visually-hidden">Matt Kelly</h1>
<section class="hero py-4 sm:py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-controller="entrance" data-entrance-delay-value="0">
      <div 
        class="dev-card terminal-container" 
        data-controller="interactive-terminal"
        data-action="keydown->interactive-terminal#handleKeydown"
        tabindex="0"
        >
        <div class="terminal-header">
          <div class="terminal-dots">
            <div class="terminal-dot dot-red"></div>
            <div class="terminal-dot dot-yellow"></div>
            <div class="terminal-dot dot-green"></div>
          </div>
        </div>
        <div class="terminal-output" data-interactive-terminal-target="output"></div>
        <div class="terminal-input-line">
          <span class="terminal-prompt" data-interactive-terminal-target="prompt"></span>
          <span class="terminal-input" data-interactive-terminal-target="input"></span>
        </div>
      </div>
    </div>
  </div>
</section>
