<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "MattKelly.io" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# Favicons and Icons %>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/svg+xml" href="/icon.svg">
    <link rel="icon" type="image/png" href="/icon.png">
    <link rel="manifest" href="/manifest.json">

    <%= javascript_importmap_tags %>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Devicon -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">

    <!-- Custom Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Prism.js -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-ruby.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-javascript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-css.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-markup.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js"></script>

    <!-- Custom Styles -->
    <style>
      /* Base Styles */
      html {
        height: 100%;
        background-color: #1a1b26;
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        background-color: #1a1b26;
        color: #a9b1d6;
        display: flex;
        flex-direction: column;
        margin: 0;
        font-family: 'Inter', sans-serif;
        line-height: 1.6;
        opacity: 0;
        animation: fadeIn 0.5s ease-in forwards;
        -webkit-text-size-adjust: 100%;
      }

      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      /* Typography */
      p {
        margin-bottom: 1.5rem;
        font-size: clamp(1rem, 2.5vw, 1.125rem);
        line-height: 1.7;
      }

      h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1.2;
        margin-bottom: 1rem;
      }

      h2 {
        font-size: clamp(1.5rem, 4vw, 2rem);
        line-height: 1.3;
        margin-bottom: 1rem;
      }

      h3 {
        font-size: clamp(1.25rem, 3vw, 1.5rem);
        line-height: 1.4;
      }

      a {
        color: #7aa2f7;
        text-decoration: none;
        transition: color 0.3s ease;
        display: inline-block;
      }

      a:hover {
        color: #bb9af7;
      }

      /* Content Sections */
      section {
        margin-bottom: clamp(2rem, 5vw, 3rem);
        padding: clamp(1rem, 3vw, 2rem) 0;
      }

      /* Main Content Area */
      main {
        flex: 1;
        width: 100%;
        padding: clamp(0.5rem, 2vw, 1rem) 0;
        display: flex;
        justify-content: flex-start;
      }

      main .max-w-7xl {
        width: 100%;
        max-width: 80rem;
        margin: 0 auto;
        padding: 0 clamp(1rem, 3vw, 2rem);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(1rem, 3vw, 2rem);
      }

      /* Container Styles */
      .container {
        width: 100%;
        max-width: 65ch;
        margin: clamp(1rem, 4vw, 2rem) auto;
        padding: clamp(1.5rem, 4vw, 2.5rem);
        background: rgba(36, 40, 59, 0.8);
        border: 1px solid #29293f;
        border-radius: clamp(0.5rem, 2vw, 1rem);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        backdrop-filter: blur(8px);
        position: relative;
        overflow: hidden;
      }

      .container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #7aa2f7, transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .container:hover {
        transform: translateY(-6px);
        border-color: transparent;
        box-shadow: 
          0 20px 25px -5px rgba(122, 162, 247, 0.1),
          0 10px 10px -5px rgba(187, 154, 247, 0.04),
          0 0 15px rgba(122, 162, 247, 0.2);
      }

      .container:hover::before {
        opacity: 1;
      }

      .container.wide {
        max-width: 80rem;
      }

      /* Grid Layout with better mobile support */
      .grid {
        display: grid;
        width: 100%;
        gap: clamp(1rem, 3vw, 1.5rem);
        grid-template-columns: 1fr;
        margin-bottom: 1.5rem;
        padding: 0 clamp(0.5rem, 2vw, 1rem);
      }

      @media (min-width: 640px) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 1024px) {
        .grid {
          grid-template-columns: repeat(3, 1fr);
          padding: 0;
        }
      }

      /* Card Base with better mobile support */
      .card-base {
        background: rgba(31, 35, 53, 0.8);
        border: 1px solid transparent;
        border-radius: clamp(0.5rem, 2vw, 1rem);
        padding: clamp(1rem, 3vw, 1.5rem);
        margin-bottom: clamp(1rem, 3vw, 1.5rem);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(8px);
        position: relative;
        isolation: isolate;
        z-index: 1;
        width: 100%;
      }

      .card-base::before {
        content: '';
        position: absolute;
        inset: -2px;
        padding: 2px;
        background: linear-gradient(
          90deg,
          #7aa2f7 0%,     /* Tokyo Night blue */
          #bb9af7 16.67%, /* Tokyo Night purple */
          #7dcfff 33.33%, /* Tokyo Night cyan */
          #9ece6a 50%,    /* Tokyo Night green */
          #ff9e64 66.67%, /* Tokyo Night orange */
          #f7768e 83.33%, /* Tokyo Night red */
          #9d7cd8 91.67%, /* Transition purple */
          #7aa2f7 100%    /* Back to blue */
        );
        border-radius: calc(1rem + 2px);
        -webkit-mask: 
          linear-gradient(#fff 0 0) content-box, 
          linear-gradient(#fff 0 0);
        mask: 
          linear-gradient(#fff 0 0) content-box, 
          linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        will-change: opacity, background-position;
        transition: opacity 0.3s ease;
        background-size: 200% 100%;
        z-index: 0;
      }

      .card-base::after {
        content: '';
        position: absolute;
        inset: -1px;
        background: rgba(31, 35, 53, 0.95);
        border-radius: calc(1rem + 1px);
        z-index: -1;
      }

      .card-base:hover {
        transform: translateY(-4px) scale(1.01);
        box-shadow: 
          0 20px 25px -5px rgba(122, 162, 247, 0.1),
          0 10px 10px -5px rgba(187, 154, 247, 0.04);
      }

      .card-base:hover::before {
        opacity: 1;
        animation: borderGradient 6s linear infinite;
      }

      @keyframes borderGradient {
        to {
          background-position: 200% 0;
        }
      }

      /* Project Card Styles */
      .project-card {
        composes: card-base;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .project-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #7aa2f7, transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .project-card:hover::before {
        opacity: 1;
      }

      /* Blog Post Card Styles */
      .post-card {
        composes: card-base;
        height: 100%;
      }

      .post-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #bb9af7, transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .post-card:hover::before {
        opacity: 1;
      }

      /* Card Content Styles */
      .card-title {
        color: #7aa2f7;
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        font-family: 'Space Grotesk', sans-serif;
      }

      .card-subtitle {
        color: #bb9af7;
        font-size: 0.875rem;
        margin-bottom: 1rem;
      }

      .card-content {
        color: #a9b1d6;
        font-size: 1rem;
        line-height: 1.5;
        margin-bottom: 0.75rem;
        flex-grow: 1;
      }

      /* Card Actions */
      .card-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
        justify-content: center;
        width: 100%;
      }

      .card-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: rgba(122, 162, 247, 0.1);
        border: 1px solid rgba(122, 162, 247, 0.2);
        border-radius: 0.5rem;
        color: #7aa2f7;
        font-weight: 500;
        transition: all 0.3s ease;
        min-width: 8rem;
        font-family: 'Inter', sans-serif;
      }

      .card-link:hover {
        background: rgba(187, 154, 247, 0.15);
        border-color: rgba(187, 154, 247, 0.3);
        transform: translateY(-2px);
        color: #bb9af7;
      }

      /* Tags and Metadata */
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
      }

      .tag {
        padding: 0.25rem 0.75rem;
        background: rgba(122, 162, 247, 0.1);
        border-radius: 1rem;
        color: #7aa2f7;
        font-size: 0.875rem;
        transition: all 0.3s ease;
        font-family: 'Inter', sans-serif;
      }

      .tag:hover {
        background: rgba(187, 154, 247, 0.15);
        border-color: rgba(187, 154, 247, 0.3);
        color: #bb9af7;
      }

      /* Grid Layout */
      .grid {
        display: grid;
        width: 100%;
        gap: 2rem;
        grid-template-columns: 1fr;
        margin-bottom: 2rem;
      }

      @media (min-width: 768px) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 1024px) {
        .grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      /* Content Sections */
      .section {
        width: 100%;
        max-width: 65ch;
        margin: 0 auto 4rem;
        opacity: 0;
        animation: slideUp 0.5s ease-out forwards;
      }

      .section.wide {
        max-width: 80rem;
      }

      @keyframes slideUp {
        from {
          transform: translateY(20px);
          opacity: 0;
        }
        to {
          transform: translateY(0);
          opacity: 1;
        }
      }

      /* Grid Layouts */
      .grid-cols-2-sm,
      .grid-cols-3-lg {
        display: none;
      }

      /* Footer Styles */
      footer {
        background-color: rgba(22, 22, 30, 0.8);
        backdrop-filter: blur(8px);
        border-top: 1px solid #29293f;
        padding: 2rem 0;
        width: 100%;
      }

      footer .max-w-7xl {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      footer p.text-sm {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        margin: 0 auto;
        line-height: 1.5;
      }

      footer .rainbow-text {
        background: linear-gradient(45deg, #7aa2f7, #bb9af7, #7dcfff);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 500;
      }

      /* Lists */
      ul, ol {
        margin: 0 0 1.5rem 1.5rem;
        padding: 0;
      }

      li {
        margin-bottom: 0.5rem;
      }

      /* Code Blocks */
      code {
        font-family: 'JetBrains Mono', monospace;
        background-color: #24283b;
        padding: 0.2em 0.4em;
        border-radius: 0.3em;
        font-size: 0.925em;
      }

      pre {
        background-color: #24283b;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 1.5rem 0;
      }

      pre code {
        background-color: transparent;
        padding: 0;
      }

      /* Container Spacing */
      .container {
        padding: 2rem 1rem;
      }

      @media (min-width: 640px) {
        .container {
          padding: 2rem;
        }
      }

      @media (min-width: 1024px) {
        .container {
          padding: 3rem 2rem;
        }
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Space Grotesk', sans-serif;
        color: #7aa2f7;
        margin: 0;
      }

      h1 { font-size: 2.25rem; font-weight: 700; margin-bottom: 1.5rem; }
      h2 { font-size: 1.875rem; font-weight: 600; margin-bottom: 1rem; }
      h3 { font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; }
      h4 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; }

      /* Layout */
      .max-w-7xl {
        max-width: 80rem;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1rem;
        padding-right: 1rem;
      }

      @media (min-width: 640px) {
        .max-w-7xl {
          padding-left: 1.5rem;
          padding-right: 1.5rem;
        }
      }

      @media (min-width: 1024px) {
        .max-w-7xl {
          padding-left: 2rem;
          padding-right: 2rem;
        }
      }

      /* Header */
      .main-header {
        position: fixed;
        width: 100%;
        top: 0;
        background-color: rgba(22, 22, 30, 0.8);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #29293f;
        z-index: 50;
      }

      .header-content {
        height: 4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      /* Navigation */
      .nav-link {
        position: relative !important;
        color: #a9b1d6 !important;
        font-weight: 500 !important;
        transition: color 0.3s ease-in-out !important;
        text-decoration: none;
        font-family: 'Space Grotesk', sans-serif;
        letter-spacing: -0.01em;
      }

      .nav-link:hover {
        color: #bb9af7 !important;
      }

      .nav-link::after {
        content: '';
        position: absolute !important;
        width: 100% !important;
        height: 2px !important;
        bottom: -4px !important;
        left: 0 !important;
        background-color: #bb9af7 !important;
        transform: scaleX(0) !important;
        transform-origin: right !important;
        transition: transform 0.3s ease-in-out !important;
      }

      .nav-link:hover::after {
        transform: scaleX(1) !important;
        transform-origin: left !important;
      }

      nav {
        display: flex;
        align-items: center;
        gap: 2rem;
      }

      /* Social Icons */
      .social-icon {
        color: #7aa2f7 !important;
        transition: all 0.3s ease-in-out !important;
        text-decoration: none;
      }

      .social-icon:hover {
        color: #bb9af7 !important;
        transform: translateY(-2px) !important;
      }

      .social-icons {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      /* Rainbow Text */
      .rainbow-text {
        display: inline-block !important;
        background-image: linear-gradient(
          45deg,
          #f7768e,
          #ff9e64,
          #9ece6a,
          #7aa2f7,
          #bb9af7
        ) !important;
        background-size: 400% 400% !important;
        -webkit-background-clip: text !important;
        background-clip: text !important;
        color: transparent !important;
        animation: rainbow 8s ease infinite !important;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 500;
      }

      @keyframes rainbow {
        0%, 100% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
      }

      /* Button */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        background-color: #7aa2f7;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease-in-out;
        transform: scale(1) rotate(0);
        box-shadow: 0 0 15px rgba(122, 162, 247, 0.5);
        font-family: 'Inter', sans-serif;
      }

      .btn-primary:hover {
        background-color: #bb9af7;
        transform: scale(1.05) rotate(1deg);
        box-shadow: 0 0 25px rgba(187, 154, 247, 0.5);
      }

      /* Layout Utilities */
      .flex-grow {
        flex-grow: 1;
      }

      .pt-20 {
        padding-top: 5rem;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* Additional Utility Classes */
      .flex-none {
        flex: none;
      }

      .text-xl {
        font-size: 1.25rem;
        line-height: 1.75rem;
      }

      .font-semibold {
        font-weight: 600;
      }

      .font-heading {
        font-family: 'Space Grotesk', sans-serif;
      }

      /* Content Cards and Containers */
      .card {
        background-color: rgba(36, 40, 59, 0.8);
        border: 1px solid #29293f;
        border-radius: 1rem;
        padding: 2rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        backdrop-filter: blur(8px);
      }

      .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(122, 162, 247, 0.1), 0 10px 10px -5px rgba(187, 154, 247, 0.04);
        border-color: #7aa2f7;
      }

      /* Spacing Utilities */
      .mt-4 { margin-top: 1rem; }
      .mt-8 { margin-top: 2rem; }
      .mb-4 { margin-bottom: 1rem; }
      .mb-8 { margin-bottom: 2rem; }
      .mx-auto { margin-left: auto; margin-right: auto; }
      .p-4 { padding: 1rem; }
      .p-8 { padding: 2rem; }

      /* Dev Cards and Containers */
      .dev-card {
        composes: card-base;
        background: rgba(31, 35, 53, 0.8);
        border: 1px solid transparent;
        border-radius: 1rem;
        padding: 1.25rem;
        margin-bottom: 1rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(8px);
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
        isolation: isolate;
        z-index: 1;
      }

      .dev-card::before {
        content: '';
        position: absolute;
        inset: -2px;
        padding: 2px;
        background: linear-gradient(
          90deg,
          #7aa2f7 0%,     /* Tokyo Night blue */
          #bb9af7 16.67%, /* Tokyo Night purple */
          #7dcfff 33.33%, /* Tokyo Night cyan */
          #9ece6a 50%,    /* Tokyo Night green */
          #ff9e64 66.67%, /* Tokyo Night orange */
          #f7768e 83.33%, /* Tokyo Night red */
          #9d7cd8 91.67%, /* Transition purple */
          #7aa2f7 100%    /* Back to blue */
        );
        border-radius: calc(1rem + 2px);
        -webkit-mask: 
          linear-gradient(#fff 0 0) content-box, 
          linear-gradient(#fff 0 0);
        mask: 
          linear-gradient(#fff 0 0) content-box, 
          linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        will-change: opacity, background-position;
        transition: opacity 0.3s ease;
        background-size: 200% 100%;
        z-index: 0;
      }

      .dev-card::after {
        content: '';
        position: absolute;
        inset: -1px;
        background: rgba(31, 35, 53, 0.95);
        border-radius: calc(1rem + 1px);
        z-index: -1;
      }

      .dev-card:hover {
        border-color: transparent;
        transform: translateY(-4px);
      }

      .dev-card:hover::before {
        opacity: 1;
        animation: borderGradient 6s linear infinite;
      }

      .dev-card a {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      /* Skills Container and Pills */
      .skills-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.75rem;
      }

      .skill-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.75rem;
        background: rgba(122, 162, 247, 0.1);
        border: 1px solid rgba(122, 162, 247, 0.2);
        border-radius: 9999px;
        color: #a9b1d6;
        font-size: 0.875rem;
        transition: all 0.3s ease;
        font-family: 'Inter', sans-serif;
        letter-spacing: 0.01em;
      }

      .skill-pill:hover {
        transform: translateY(-2px);
        background: rgba(187, 154, 247, 0.15);
        border-color: rgba(187, 154, 247, 0.3);
      }

      .skill-pill i {
        color: #9ece6a;
        transition: color 0.3s ease;
      }

      .skill-pill:hover i {
        color: #bb9af7;
      }

      /* Section Headers */
      .section-header {
        margin-bottom: 1.5rem;
        text-align: center;
      }

      .section-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #7aa2f7;
        margin-bottom: 0.5rem;
        letter-spacing: -0.025em;
        font-family: 'Space Grotesk', sans-serif;
      }

      .section-header p {
        color: #a9b1d6;
        font-size: 1.125rem;
        opacity: 0.9;
        max-width: 36rem;
        margin: 0 auto;
      }

      /* Hero Section */
      .hero {
        padding: 3rem 0;
        text-align: center;
      }

      .hero h1 {
        font-size: 3rem;
        font-weight: 700;
        color: #7aa2f7;
        margin-bottom: 0.75rem;
        letter-spacing: -0.025em;
        text-shadow: 0 0 20px rgba(122, 162, 247, 0.3);
        font-family: 'Space Grotesk', sans-serif;
      }

      .hero p {
        font-size: 1.5rem;
        color: #bb9af7;
        opacity: 0.9;
        max-width: 36rem;
        margin: 0 auto;
      }

      /* Animations */
      @media (prefers-reduced-motion: no-preference) {
        @keyframes fade-in {
          from { opacity: 0; }
          to { opacity: 1; }
        }

        @keyframes slide-in-left {
          from { transform: translateX(-20px); opacity: 0; }
          to { transform: translateX(0); opacity: 1; }
        }

        @keyframes slide-in-right {
          from { transform: translateX(20px); opacity: 0; }
          to { transform: translateX(0); opacity: 1; }
        }

        .animate-fade-in {
          opacity: 0;
          animation: fade-in 0.6s ease-out forwards;
        }

        .animate-slide-in-left {
          opacity: 0;
          animation: slide-in-left 0.6s ease-out forwards;
        }

        .animate-slide-in-right {
          opacity: 0;
          animation: slide-in-right 0.6s ease-out forwards;
        }

        [data-controller="entrance"] {
          opacity: 0;
          transform: translateY(20px);
          animation: slide-up 0.6s ease-out forwards;
        }

        @keyframes slide-up {
          from {
            opacity: 0;
            transform: translateY(20px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      }

      /* Base hover color standardization */
      a:hover,
      .nav-link:hover,
      .social-icon:hover,
      .card-link:hover,
      .skill-pill:hover i,
      .tag:hover {
        color: #bb9af7 !important;
      }

      /* Skills Container and Pills */
      .skill-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.75rem;
        background: rgba(122, 162, 247, 0.1);
        border: 1px solid rgba(122, 162, 247, 0.2);
        border-radius: 9999px;
        color: #a9b1d6;
        font-size: 0.875rem;
        transition: all 0.3s ease;
      }

      .skill-pill:hover {
        transform: translateY(-2px);
        background: rgba(187, 154, 247, 0.15);
        border-color: rgba(187, 154, 247, 0.3);
      }

      .skill-pill i {
        color: #9ece6a;
        transition: color 0.3s ease;
      }

      .skill-pill:hover i {
        color: #bb9af7;
      }

      /* Card links */
      .card-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: rgba(122, 162, 247, 0.1);
        border: 1px solid rgba(122, 162, 247, 0.2);
        border-radius: 0.5rem;
        color: #7aa2f7;
        font-weight: 500;
        transition: all 0.3s ease;
      }

      .card-link:hover {
        background: rgba(187, 154, 247, 0.15);
        border-color: rgba(187, 154, 247, 0.3);
        transform: translateY(-2px);
        color: #bb9af7;
      }

      /* Navigation links */
      .nav-link:hover {
        color: #bb9af7;
      }

      .nav-link::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 2px;
        bottom: -4px;
        left: 0;
        background-color: #bb9af7;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease-in-out;
      }

      /* Social icons */
      .social-icon:hover {
        color: #bb9af7;
        transform: translateY(-2px);
      }

      /* Tags */
      .tag:hover {
        background: rgba(187, 154, 247, 0.15);
        border-color: rgba(187, 154, 247, 0.3);
        color: #bb9af7;
      }

      /* Card gradients on hover */
      .card-base:hover::before,
      .project-card:hover::before,
      .post-card:hover::before,
      .container:hover::before {
        background: linear-gradient(90deg, transparent, #bb9af7, transparent);
      }

      /* Button hover */
      .btn-primary:hover {
        background-color: #bb9af7;
        transform: scale(1.05) rotate(1deg);
        box-shadow: 0 0 25px rgba(187, 154, 247, 0.5);
      }

      /* Call to Action Section Styles */
      .cta-section .dev-card {
        width: 100%;
        max-width: 42rem;
        margin: 0 auto;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .cta-section .dev-card .card-title,
      .cta-section .dev-card .card-content {
        text-align: center;
        width: 100%;
        max-width: 36rem;
        margin-left: auto;
        margin-right: auto;
      }

      .cta-section .dev-card .card-actions {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 1.5rem;
        width: 100%;
      }

      .cta-section .dev-card .card-link {
        min-width: 8rem;
        justify-content: center;
      }

      /* Remove the general header styles */
      header:not(.main-header) {
        position: relative;
      }

      /* Mobile-specific adjustments */
      @media (max-width: 639px) {
        .container {
          margin: 1rem auto;
          padding: 1.25rem;
        }

        .card-base:hover {
          transform: none;
        }

        .container:hover {
          transform: none;
        }

        .skills-container {
          justify-content: center;
        }

        .skill-pill {
          font-size: 0.8125rem;
          padding: 0.3rem 0.6rem;
        }

        .cta-section .card-actions {
          flex-direction: column;
          gap: 1.5rem;
          align-items: center;
        }

        .cta-section .card-actions a {
          width: 100%;
          justify-content: center;
        }
      }
    </style>
  </head>

  <body>
    <header class="main-header">
      <div class="max-w-7xl">
        <div class="header-content">
          <div class="flex-none">
            <%= link_to "MattKelly.io", root_path, class: "nav-link font-heading font-semibold text-xl text-[#7aa2f7]" %>
          </div>
          
          <nav>
            <%= link_to "Projects", projects_path, class: "nav-link" %>
            <%= link_to "Blog", posts_path, class: "nav-link" %>
            <%= link_to "CV", cv_path, class: "nav-link" %>
          </nav>

          <div class="social-icons">
            <a href="https://github.com/mathisto" target="_blank" rel="noopener noreferrer" class="social-icon">
              <span class="sr-only">GitHub</span>
              <i class="fab fa-github text-xl"></i>
            </a>
            <a href="https://www.linkedin.com/in/themattkellyshow/" target="_blank" rel="noopener noreferrer" class="social-icon">
              <span class="sr-only">LinkedIn</span>
              <i class="fab fa-linkedin text-xl"></i>
            </a>
            <a href="mailto:matthew.ryan.kelly@gmail.com" class="social-icon">
              <span class="sr-only">Email</span>
              <i class="fas fa-envelope text-xl"></i>
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow pt-20">
      <div class="max-w-7xl">
        <%= yield %>
      </div>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
