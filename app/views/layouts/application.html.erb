<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "MattKelly.io" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= javascript_importmap_tags %>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Custom Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Montserrat:wght@500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">

    <!-- Custom Styles -->
    <style>
      /* Base Styles */
      html {
        height: 100%;
        background-color: #1a1b26;
        scroll-behavior: smooth;
      }

      body {
        min-height: 100vh;
        background-color: #1a1b26;
        color: #a9b1d6;
        display: flex;
        flex-direction: column;
        margin: 0;
        font-family: 'Lato', sans-serif;
        line-height: 1.6;
        opacity: 0;
        animation: fadeIn 0.5s ease-in forwards;
      }

      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      /* Typography */
      p {
        margin-bottom: 1.5rem;
        font-size: 1.125rem;
      }

      a {
        color: #7aa2f7;
        text-decoration: none;
        transition: color 0.3s ease;
      }

      a:hover {
        color: #bb9af7;
      }

      /* Content Sections */
      section {
        margin-bottom: 4rem;
      }

      /* Main Content Area */
      main {
        flex: 1;
        width: 100%;
        padding: 2rem 0;
        display: flex;
        justify-content: flex-start;
      }

      main .max-w-7xl {
        width: 100%;
        max-width: 80rem;
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2rem;
      }

      /* Container Styles */
      .container {
        width: 100%;
        max-width: 65ch;
        margin: 2rem auto;
        padding: 2.5rem;
        background: rgba(36, 40, 59, 0.8);
        border: 1px solid #29293f;
        border-radius: 1rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        backdrop-filter: blur(8px);
        position: relative;
        overflow: hidden;
      }

      .container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #7aa2f7, transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .container:hover {
        transform: translateY(-6px);
        border-color: transparent;
        box-shadow: 
          0 20px 25px -5px rgba(122, 162, 247, 0.1),
          0 10px 10px -5px rgba(187, 154, 247, 0.04),
          0 0 15px rgba(122, 162, 247, 0.2);
      }

      .container:hover::before {
        opacity: 1;
      }

      .container.wide {
        max-width: 80rem;
      }

      /* Grid Layout */
      .grid {
        display: grid;
        width: 100%;
        gap: 2rem;
        grid-template-columns: 1fr;
        margin-bottom: 2rem;
        max-width: 80rem;
        margin-left: auto;
        margin-right: auto;
      }

      @media (min-width: 768px) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 1024px) {
        .grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      /* Project Cards */
      .project-card {
        background: rgba(36, 40, 59, 0.8);
        border: 1px solid #29293f;
        border-radius: 1rem;
        padding: 2.5rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
      }

      .project-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #7aa2f7, transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .project-card:hover {
        transform: translateY(-6px) rotate(1deg);
        border-color: transparent;
        box-shadow: 
          0 20px 25px -5px rgba(122, 162, 247, 0.1),
          0 10px 10px -5px rgba(187, 154, 247, 0.04),
          0 0 15px rgba(122, 162, 247, 0.2);
      }

      .project-card:hover::before {
        opacity: 1;
      }

      /* Blog Post Cards */
      .post-card {
        background: rgba(36, 40, 59, 0.8);
        border: 1px solid #29293f;
        border-radius: 1rem;
        padding: 2.5rem;
        height: 100%;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
      }

      .post-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, #bb9af7, transparent);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .post-card:hover {
        transform: translateY(-6px) rotate(-1deg);
        border-color: transparent;
        box-shadow: 
          0 20px 25px -5px rgba(187, 154, 247, 0.1),
          0 10px 10px -5px rgba(187, 154, 247, 0.04),
          0 0 15px rgba(187, 154, 247, 0.2);
      }

      .post-card:hover::before {
        opacity: 1;
      }

      /* Content Sections */
      .section {
        width: 100%;
        max-width: 65ch;
        margin: 0 auto 4rem;
        opacity: 0;
        animation: slideUp 0.5s ease-out forwards;
      }

      .section.wide {
        max-width: 80rem;
      }

      @keyframes slideUp {
        from {
          transform: translateY(20px);
          opacity: 0;
        }
        to {
          transform: translateY(0);
          opacity: 1;
        }
      }

      /* Grid Layouts */
      .grid-cols-2-sm,
      .grid-cols-3-lg {
        display: none;
      }

      /* Footer Styles */
      footer {
        background-color: rgba(22, 22, 30, 0.8);
        backdrop-filter: blur(8px);
        border-top: 1px solid #29293f;
        padding: 2rem 0;
        width: 100%;
      }

      footer .max-w-7xl {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      footer p.text-sm {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        margin: 0 auto;
        line-height: 1.5;
      }

      footer .rainbow-text {
        background: linear-gradient(45deg, #7aa2f7, #bb9af7, #7dcfff);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 500;
      }

      /* Lists */
      ul, ol {
        margin: 0 0 1.5rem 1.5rem;
        padding: 0;
      }

      li {
        margin-bottom: 0.5rem;
      }

      /* Code Blocks */
      code {
        font-family: 'Fira Code', monospace;
        background-color: #24283b;
        padding: 0.2em 0.4em;
        border-radius: 0.3em;
        font-size: 0.9em;
      }

      pre {
        background-color: #24283b;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 1.5rem 0;
      }

      pre code {
        background-color: transparent;
        padding: 0;
      }

      /* Container Spacing */
      .container {
        padding: 2rem 1rem;
      }

      @media (min-width: 640px) {
        .container {
          padding: 2rem;
        }
      }

      @media (min-width: 1024px) {
        .container {
          padding: 3rem 2rem;
        }
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Montserrat', sans-serif;
        color: #7aa2f7;
        margin: 0;
      }

      h1 { font-size: 2.25rem; font-weight: 700; margin-bottom: 1.5rem; }
      h2 { font-size: 1.875rem; font-weight: 600; margin-bottom: 1rem; }
      h3 { font-size: 1.5rem; font-weight: 600; margin-bottom: 0.75rem; }
      h4 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; }

      /* Layout */
      .max-w-7xl {
        max-width: 80rem;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1rem;
        padding-right: 1rem;
      }

      @media (min-width: 640px) {
        .max-w-7xl {
          padding-left: 1.5rem;
          padding-right: 1.5rem;
        }
      }

      @media (min-width: 1024px) {
        .max-w-7xl {
          padding-left: 2rem;
          padding-right: 2rem;
        }
      }

      /* Header */
      header {
        position: fixed;
        width: 100%;
        top: 0;
        background-color: rgba(22, 22, 30, 0.8);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #29293f;
        z-index: 50;
      }

      .header-content {
        height: 4rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      /* Navigation */
      .nav-link {
        position: relative !important;
        color: #a9b1d6 !important;
        font-weight: 500 !important;
        transition: color 0.3s ease-in-out !important;
        text-decoration: none;
      }

      .nav-link:hover {
        color: #bb9af7 !important;
      }

      .nav-link::after {
        content: '';
        position: absolute !important;
        width: 100% !important;
        height: 2px !important;
        bottom: -4px !important;
        left: 0 !important;
        background-color: #bb9af7 !important;
        transform: scaleX(0) !important;
        transform-origin: right !important;
        transition: transform 0.3s ease-in-out !important;
      }

      .nav-link:hover::after {
        transform: scaleX(1) !important;
        transform-origin: left !important;
      }

      nav {
        display: flex;
        align-items: center;
        gap: 2rem;
      }

      /* Social Icons */
      .social-icon {
        color: #7aa2f7 !important;
        transition: all 0.3s ease-in-out !important;
        text-decoration: none;
      }

      .social-icon:hover {
        color: #bb9af7 !important;
        transform: translateY(-2px) !important;
      }

      .social-icons {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      /* Rainbow Text */
      .rainbow-text {
        display: inline-block !important;
        background-image: linear-gradient(
          45deg,
          #f7768e,
          #ff9e64,
          #9ece6a,
          #7aa2f7,
          #bb9af7
        ) !important;
        background-size: 400% 400% !important;
        -webkit-background-clip: text !important;
        background-clip: text !important;
        color: transparent !important;
        animation: rainbow 8s ease infinite !important;
      }

      @keyframes rainbow {
        0%, 100% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
      }

      /* Button */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        background-color: #7aa2f7;
        color: white;
        font-weight: 500;
        transition: all 0.3s ease-in-out;
        transform: scale(1) rotate(0);
        box-shadow: 0 0 15px rgba(122, 162, 247, 0.5);
      }

      .btn-primary:hover {
        background-color: #bb9af7;
        transform: scale(1.05) rotate(1deg);
        box-shadow: 0 0 25px rgba(187, 154, 247, 0.5);
      }

      /* Layout Utilities */
      .flex-grow {
        flex-grow: 1;
      }

      .pt-20 {
        padding-top: 5rem;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* Additional Utility Classes */
      .flex-none {
        flex: none;
      }

      .text-xl {
        font-size: 1.25rem;
        line-height: 1.75rem;
      }

      .font-semibold {
        font-weight: 600;
      }

      .font-heading {
        font-family: 'Montserrat', sans-serif;
      }

      /* Content Cards and Containers */
      .card {
        background-color: rgba(36, 40, 59, 0.8);
        border: 1px solid #29293f;
        border-radius: 1rem;
        padding: 2rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        backdrop-filter: blur(8px);
      }

      .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(122, 162, 247, 0.1), 0 10px 10px -5px rgba(187, 154, 247, 0.04);
        border-color: #7aa2f7;
      }

      /* Spacing Utilities */
      .mt-4 { margin-top: 1rem; }
      .mt-8 { margin-top: 2rem; }
      .mb-4 { margin-bottom: 1rem; }
      .mb-8 { margin-bottom: 2rem; }
      .mx-auto { margin-left: auto; margin-right: auto; }
      .p-4 { padding: 1rem; }
      .p-8 { padding: 2rem; }

      /* Dev Cards and Containers */
      .dev-card {
        background: rgba(36, 40, 59, 0.8);
        border: 1px solid #29293f;
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .dev-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 4px 12px rgba(122, 162, 247, 0.1);
      }

      .dev-card a {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      /* Card Content */
      .card-title {
        color: #7aa2f7;
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        font-family: 'Montserrat', sans-serif;
      }

      .card-subtitle {
        color: #bb9af7;
        font-size: 0.875rem;
        margin-bottom: 1rem;
      }

      .card-content {
        color: #a9b1d6;
        font-size: 1rem;
        line-height: 1.5;
        margin-bottom: 1rem;
        flex-grow: 1;
      }

      /* Skills Container */
      .skills-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.5rem;
        justify-content: flex-start;
      }

      .skill-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: rgba(122, 162, 247, 0.1);
        border: 1px solid rgba(122, 162, 247, 0.2);
        border-radius: 1rem;
        color: #7aa2f7;
        font-size: 0.875rem;
      }

      .skill-pill i {
        font-size: 0.875rem;
      }

      /* Card Actions */
      .card-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
        justify-content: flex-start;
      }

      .card-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: rgba(122, 162, 247, 0.1);
        border: 1px solid rgba(122, 162, 247, 0.2);
        border-radius: 0.5rem;
        color: #7aa2f7;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s ease;
      }

      .card-link:hover {
        background: rgba(187, 154, 247, 0.1);
        border-color: rgba(187, 154, 247, 0.3);
        color: #bb9af7;
      }

      .card-link i {
        font-size: 1rem;
      }

      /* Tags and Metadata */
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
      }

      .tag {
        padding: 0.25rem 0.75rem;
        background: rgba(122, 162, 247, 0.1);
        border-radius: 1rem;
        color: #7aa2f7;
        font-size: 0.875rem;
        transition: all 0.3s ease;
      }

      .tag:hover {
        background: rgba(187, 154, 247, 0.1);
        color: #bb9af7;
        transform: translateY(-1px);
      }

      .text-center.mt-6 {
        margin-top: 1rem;
        position: relative;
        z-index: 10;
      }
    </style>
  </head>

  <body>
    <header>
      <div class="max-w-7xl">
        <div class="header-content">
          <div class="flex-none">
            <%= link_to "MattKelly.io", root_path, class: "nav-link font-heading font-semibold text-xl text-[#7aa2f7]" %>
          </div>
          
          <nav>
            <%= link_to "Projects", projects_path, class: "nav-link" %>
            <%= link_to "Blog", posts_path, class: "nav-link" %>
            <%= link_to "CV", cv_path, class: "nav-link" %>
          </nav>

          <div class="social-icons">
            <a href="https://github.com/mathisto" target="_blank" rel="noopener noreferrer" class="social-icon">
              <span class="sr-only">GitHub</span>
              <i class="fab fa-github text-xl"></i>
            </a>
            <a href="https://www.linkedin.com/in/themattkellyshow/" target="_blank" rel="noopener noreferrer" class="social-icon">
              <span class="sr-only">LinkedIn</span>
              <i class="fab fa-linkedin text-xl"></i>
            </a>
            <a href="mailto:matthew.ryan.kelly@gmail.com" class="social-icon">
              <span class="sr-only">Email</span>
              <i class="fas fa-envelope text-xl"></i>
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow pt-20">
      <div class="max-w-7xl">
        <%= yield %>
      </div>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
