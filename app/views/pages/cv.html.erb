<%# CV Page with Tokyo Night theme %>
<style>
  /* CV-specific styles */
  .cv-section {
    text-align: center;
    padding: 2.5rem 2rem;
    position: relative;
    margin-bottom: 2rem;
  }

  @media (min-width: 1024px) {
    .cv-section, .max-w-4xl {
      max-width: 64rem;
    }
  }

  /* Document icons styling */
  .icon-container-reset {
    position: absolute !important;
    top: 1.5rem !important;
    right: 1.5rem !important;
    display: flex !important;
    align-items: center !important;
    z-index: 50 !important;
    margin: 0 !important;
    padding: 0 !important;
    gap: 0.75rem !important;
  }

  .icon-container-reset a {
    display: inline-flex;
    padding: 0.5rem;
    transition: all 0.3s ease;
  }

  .icon-container-reset a:hover {
    transform: translateY(-2px);
  }

  .icon-container-reset a:hover i {
    color: #bb9af7 !important;
  }

  /* Name styling with more emphasis */
  .cv-section h1 {
    font-size: 3rem;
    font-weight: 700;
    color: #7aa2f7;
    margin-bottom: 0.75rem;
    letter-spacing: -0.025em;
    text-shadow: 0 0 20px rgba(122, 162, 247, 0.3);
  }

  /* Title styling */
  .cv-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #f7768e;
    margin-bottom: 2rem;
    opacity: 0.9;
    text-shadow: 0 0 15px rgba(247, 118, 142, 0.3);
  }

  /* Tagline icons - Header section */
  .cv-section .fas {
    font-size: 1rem;
    margin-right: 0.75rem;
    color: #9ece6a;
    opacity: 0.9;
    transition: color 0.3s ease;
  }

  .cv-section p:hover .fas {
    color: #bb9af7;
  }

  /* Core skills icons */
  .skills-container .skill-pill i {
    color: #9ece6a !important;
    opacity: 0.9;
    transition: color 0.3s ease !important;
  }

  .skills-container .skill-pill:hover i {
    color: #bb9af7 !important;
  }

  /* Job entry icons (calendar and location) */
  .cv-job-entry .fas.fa-calendar-alt,
  .cv-job-entry .fas.fa-location-dot {
    color: #bb9af7 !important;
    opacity: 0.9;
  }

  /* CV Job Entry */
  .cv-job-entry {
    composes: card-base;
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid transparent;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    text-align: left;
    position: relative;
    isolation: isolate;
    z-index: 1;
  }

  /* Job Entry Headers - Updated for better mobile positioning */
  .header-container {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: start;
    margin-bottom: 0.75rem;
  }

  .cv-job-entry h4 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #7aa2f7;
    margin: 0;
    line-height: 1.4;
  }

  /* Date styling */
  .cv-job-entry .date-container {
    display: flex;
    align-items: center;
    white-space: nowrap;
    color: #bb9af7;
    font-size: 0.95rem;
  }

  .cv-job-entry .date-container i {
    color: #f7768e !important;
    opacity: 0.9;
    margin-right: 0.5rem;
  }

  /* Location line styling */
  .cv-job-entry .location-container {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .cv-job-entry .location-container i {
    color: #7dcfff !important;
    opacity: 0.9;
    margin-right: 0.5rem;
  }

  .cv-job-entry::before {
    content: '';
    position: absolute;
    inset: -2px;
    padding: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,     /* Tokyo Night blue */
      #bb9af7 16.67%, /* Tokyo Night purple */
      #7dcfff 33.33%, /* Tokyo Night cyan */
      #9ece6a 50%,    /* Tokyo Night green */
      #ff9e64 66.67%, /* Tokyo Night orange */
      #f7768e 83.33%, /* Tokyo Night red */
      #9d7cd8 91.67%, /* Transition purple */
      #7aa2f7 100%    /* Back to blue */
    );
    border-radius: calc(1rem + 2px);
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    will-change: opacity, background-position;
    transition: opacity 0.3s ease;
    background-size: 200% 100%;
    z-index: 0;
  }

  .cv-job-entry::after {
    content: '';
    position: absolute;
    inset: -1px;
    background: rgba(31, 35, 53, 0.95);
    border-radius: calc(1rem + 1px);
    z-index: -1;
  }

  .cv-job-entry:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 20px 25px -5px rgba(122, 162, 247, 0.1),
      0 10px 10px -5px rgba(187, 154, 247, 0.04);
  }

  .cv-job-entry:hover::before {
    opacity: 1;
    animation: borderGradient 6s linear infinite;
  }

  .cv-job-entry .flex.flex-wrap {
    margin-bottom: 0.75rem;
  }

  .cv-job-entry .flex.items-center {
    white-space: nowrap;
    font-size: 0.9rem;
  }

  .cv-job-entry .flex.items-center i {
    font-size: 0.875rem;
  }

  .cv-job-entry .flex.items-center.mb-4 {
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  /* CV Bullet Points */
  .cv-bullet {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    transition: all 0.3s ease;
    list-style-type: none;
    text-align: left;
    padding: 0.25rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: 0.25rem;
    line-height: 1.5;
  }

  .cv-bullet:hover {
    background: rgba(122, 162, 247, 0.05);
    transform: translateX(2px);
  }

  .cv-bullet::before {
    content: '⁜';
    position: absolute;
    left: -1rem;
    color: #9ece6a;
    transition: all 0.3s ease;
  }

  .cv-bullet:hover::before {
    color: #bb9af7;
    transform: translateX(2px);
  }

  /* Remove default bullets from ul elements */
  .cv-job-entry ul {
    list-style-type: none;
    padding-left: 0;
  }

  /* Skills section styling */
  .skills-section {
    composes: card-base;
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid transparent;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(8px);
    position: relative;
    isolation: isolate;
    z-index: 1;
  }

  .skills-section::before {
    content: '';
    position: absolute;
    inset: -2px;
    padding: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,     /* Tokyo Night blue */
      #bb9af7 16.67%, /* Tokyo Night purple */
      #7dcfff 33.33%, /* Tokyo Night cyan */
      #9ece6a 50%,    /* Tokyo Night green */
      #ff9e64 66.67%, /* Tokyo Night orange */
      #f7768e 83.33%, /* Tokyo Night red */
      #9d7cd8 91.67%, /* Transition purple */
      #7aa2f7 100%    /* Back to blue */
    );
    border-radius: calc(1rem + 2px);
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    will-change: opacity, background-position;
    transition: opacity 0.3s ease;
    background-size: 200% 100%;
    z-index: 0;
  }

  .skills-section::after {
    content: '';
    position: absolute;
    inset: -1px;
    background: rgba(31, 35, 53, 0.95);
    border-radius: calc(1rem + 1px);
    z-index: -1;
  }

  .skills-section:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 20px 25px -5px rgba(122, 162, 247, 0.1),
      0 10px 10px -5px rgba(187, 154, 247, 0.04);
  }

  .skills-section:hover::before {
    opacity: 1;
    animation: borderGradient 6s linear infinite;
  }

  /* Section Headers (Experience, Core Skills, Education) */
  .cv-section > h3 {
    font-size: 2rem !important;
    font-weight: 700 !important;
    color: #bb9af7 !important;
    margin-bottom: 2rem !important;
    letter-spacing: -0.025em;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    opacity: 0.9;
  }

  .cv-section > h3 span {
    font-size: 1.75rem;
    margin-right: 1rem;
  }

  /* Job Entry Headers */
  .cv-job-entry h4 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #7aa2f7;
  }

  /* Skills Container and Pills */
  .skills-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .skill-pill {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: rgba(122, 162, 247, 0.1);
    border: 1px solid rgba(122, 162, 247, 0.2);
    border-radius: 9999px;
    color: #a9b1d6;
    font-size: 0.875rem;
    transition: all 0.3s ease;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.01em;
    pointer-events: auto;
  }

  .skill-pill:hover {
    transform: translateY(-2px);
    background: rgba(187, 154, 247, 0.15);
    border-color: rgba(187, 154, 247, 0.3);
  }

  .skill-pill i {
    color: #9ece6a !important;
    transition: color 0.3s ease !important;
  }

  .skill-pill:hover i {
    color: #bb9af7 !important;
  }

  /* Tagline container styling */
  .taglines-grid {
    position: relative;
    z-index: 2;
  }

  /* Tagline item styling */
  .taglines-grid > div {
    padding: 0.5rem;
    transition: transform 0.3s ease;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .taglines-grid > div:hover {
    transform: translateY(-2px);
  }

  .taglines-grid i {
    color: #9ece6a;
    transition: transform 0.3s ease, background-position 0.3s ease;
    flex-shrink: 0;
    background: linear-gradient(
      135deg,
      #7aa2f7 0%,
      #9d7cd8 16.67%,
      #7dcfff 33.33%,
      #73daca 50%,
      #ff9e64 66.67%,
      #f7768e 83.33%,
      #9d7cd8 91.67%,
      #7aa2f7 100%
    );
    background-size: 100% 100%;
    background-position: 0% 0%;
    -webkit-background-clip: text;
    background-clip: text;
    color: #9ece6a;
  }

  .taglines-grid > div:hover i {
    transform: scale(1.2);
    color: transparent;
  }

  .taglines-grid span {
    color: #a9b1d6;
    transition: color 0.3s ease, background-position 0.3s ease;
    background: linear-gradient(
      135deg,
      #7aa2f7 0%,
      #9d7cd8 16.67%,
      #7dcfff 33.33%,
      #73daca 50%,
      #ff9e64 66.67%,
      #f7768e 83.33%,
      #9d7cd8 91.67%,
      #7aa2f7 100%
    );
    background-size: 100% 100%;
    background-position: 0% 0%;
    -webkit-background-clip: text;
    background-clip: text;
    color: #a9b1d6;
  }

  .taglines-grid > div:hover span {
    color: transparent;
  }

  /* Mobile Optimizations */
  @media (max-width: 639px) {
    .cv-section {
      padding: 0 1rem;
      padding-top: 4rem; /* Add extra padding at the top for the icons */
    }

    .icon-container-reset {
      top: 0.75rem !important; /* Move icons up */
      right: 0.75rem !important; /* Adjust right spacing */
    }

    .cv-job-entry {
      margin-left: -1rem;
      margin-right: -1rem;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }

    .cv-job-entry .header-container {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .cv-job-entry h4 {
      font-size: clamp(1.125rem, 4vw, 1.25rem);
    }

    .cv-job-entry .date-container {
      font-size: clamp(0.875rem, 2.5vw, 0.95rem);
      opacity: 0.9;
    }

    .skills-container {
      padding: 0.5rem;
    }

    .skill-pill {
      margin: 0.25rem;
    }
  }
</style>

<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-4 sm:p-8 pt-20">
  <div class="max-w-4xl mx-auto">
    <%= render partial: "pages/cv/_sections/header" %>

    <div class="text-center mb-8">
      <%= render partial: "pages/cv/_sections/skills" %>
    </div>
    <div class="space-y-8">
      <%= render partial: "pages/cv/_sections/experience" %>
      <%= render partial: "pages/cv/_sections/education" %>
    </div>
  </div>
</div>

<%# Animations %>
<% content_for :head do %>
  <style>
    /* Animations */
    @media (prefers-reduced-motion: no-preference) {
      @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes slide-in-left {
        from { transform: translateX(-20px); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }

      @keyframes slide-in-right {
        from { transform: translateX(20px); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }

      .animate-fade-in {
        opacity: 0;
        animation: fade-in 0.6s ease-out forwards;
      }

      .animate-slide-in-left {
        opacity: 0;
        animation: slide-in-left 0.6s ease-out forwards;
      }

      .animate-slide-in-right {
        opacity: 0;
        animation: slide-in-right 0.6s ease-out forwards;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-fade-in,
      .animate-slide-in-left,
      .animate-slide-in-right {
        animation: none;
        opacity: 1;
      }
    }
  </style>
<% end %> 