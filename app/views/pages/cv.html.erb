<%# CV Page with Tokyo Night theme %>
<style>
  /* CV-specific styles */
  .cv-section {
    text-align: center;
    padding: 2.5rem 2rem;
    position: relative;
    margin-bottom: 2rem;
  }

  @media (min-width: 1024px) {
    .cv-section, .max-w-4xl {
      max-width: 64rem;
    }
  }

  /* Document icons styling */
  .icon-container-reset {
    position: absolute !important;
    top: 1.5rem !important;
    right: 1.5rem !important;
    display: flex !important;
    align-items: center !important;
    z-index: 50 !important;
    margin: 0 !important;
    padding: 0 !important;
    gap: 0.75rem !important;
  }

  .icon-container-reset a {
    display: inline-flex;
    padding: 0.5rem;
    transition: all 0.3s ease;
  }

  .icon-container-reset a:hover {
    transform: translateY(-2px);
  }

  .icon-container-reset a:hover i {
    color: #bb9af7 !important;
  }

  /* Name styling with more emphasis */
  .cv-section h1 {
    font-size: 3rem;
    font-weight: 700;
    color: #7aa2f7;
    margin-bottom: 0.75rem;
    letter-spacing: -0.025em;
    text-shadow: 0 0 20px rgba(122, 162, 247, 0.3);
  }

  /* Title styling */
  .cv-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #f7768e;
    margin-bottom: 2rem;
    opacity: 0.9;
    text-shadow: 0 0 15px rgba(247, 118, 142, 0.3);
  }

  /* Tagline icons - Header section */
  .cv-section .fas {
    font-size: 1rem;
    margin-right: 0.75rem;
    color: #9ece6a;
    opacity: 0.9;
    transition: color 0.3s ease;
  }

  .cv-section p:hover .fas {
    color: #bb9af7;
  }

  /* Core skills icons */
  .skills-container .skill-pill i {
    color: #9ece6a !important;
    opacity: 0.9;
    transition: color 0.3s ease !important;
  }

  .skills-container .skill-pill:hover i {
    color: #bb9af7 !important;
  }

  /* Job entry icons (calendar and location) */
  .cv-job-entry .fas.fa-calendar-alt,
  .cv-job-entry .fas.fa-location-dot {
    color: #bb9af7 !important;
    opacity: 0.9;
  }

  /* CV Job Entry */
  .cv-job-entry {
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid #29293f;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    text-align: left;
  }

  .cv-job-entry:hover {
    border-color: rgba(122, 162, 247, 0.3);
    transform: translateY(-4px);
    box-shadow: 
      0 20px 25px -5px rgba(122, 162, 247, 0.1),
      0 10px 10px -5px rgba(187, 154, 247, 0.04);
  }

  .cv-job-entry h3,
  .cv-job-entry h4,
  .cv-job-entry p {
    text-align: left;
  }

  /* CV Bullet Points */
  .cv-bullet {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    transition: all 0.3s ease;
    list-style-type: none;
    text-align: left;
    padding: 0.25rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: 0.25rem;
  }

  .cv-bullet:hover {
    background: rgba(122, 162, 247, 0.05);
    transform: translateX(2px);
  }

  .cv-bullet::before {
    content: '⁜';
    position: absolute;
    left: -1rem;
    color: #9ece6a;
    transition: all 0.3s ease;
  }

  .cv-bullet:hover::before {
    color: #bb9af7;
    transform: translateX(2px);
  }

  /* Remove default bullets from ul elements */
  .cv-job-entry ul {
    list-style-type: none;
    padding-left: 0;
  }

  /* Skills section styling */
  .skills-section {
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid #29293f;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .skills-section:hover {
    border-color: rgba(122, 162, 247, 0.3);
    transform: translateY(-4px);
    box-shadow: 
      0 20px 25px -5px rgba(122, 162, 247, 0.1),
      0 10px 10px -5px rgba(187, 154, 247, 0.04);
  }

  /* Section Headers (Experience, Core Skills, Education) */
  .cv-section > h3 {
    font-size: 2rem !important;
    font-weight: 700 !important;
    color: #bb9af7 !important;
    margin-bottom: 2rem !important;
    letter-spacing: -0.025em;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    opacity: 0.9;
  }

  .cv-section > h3 span {
    font-size: 1.75rem;
    margin-right: 1rem;
  }

  /* Job Entry Headers */
  .cv-job-entry h4 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #7aa2f7;
  }
</style>

<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-8 pt-20">
  <div class="max-w-4xl mx-auto">
    <%= render partial: "pages/cv/_sections/header" %>

    <div class="text-center mb-8">
      <%= render partial: "pages/cv/_sections/skills" %>
    </div>
    <div class="space-y-8">
      <%= render partial: "pages/cv/_sections/experience" %>
      <%= render partial: "pages/cv/_sections/education" %>
    </div>
  </div>
</div>

<%# Animations %>
<% content_for :head do %>
  <style>
    /* Animations */
    @media (prefers-reduced-motion: no-preference) {
      @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes slide-in-left {
        from { transform: translateX(-20px); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }

      @keyframes slide-in-right {
        from { transform: translateX(20px); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
      }

      .animate-fade-in {
        opacity: 0;
        animation: fade-in 0.6s ease-out forwards;
      }

      .animate-slide-in-left {
        opacity: 0;
        animation: slide-in-left 0.6s ease-out forwards;
      }

      .animate-slide-in-right {
        opacity: 0;
        animation: slide-in-right 0.6s ease-out forwards;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-fade-in,
      .animate-slide-in-left,
      .animate-slide-in-right {
        animation: none;
        opacity: 1;
      }
    }
  </style>
<% end %> 