<%# NexHealth Experience %>
<div class="cv-job-entry animate-slide-in-right" style="animation-delay: 600ms">
  <div class="flex flex-wrap items-baseline justify-between mb-2">
    <h4 class="text-lg font-semibold text-[#7aa2f7]">Senior Software Engineer</h4>
    <div class="flex items-center">
      <i class="fas fa-calendar-alt text-sm mr-2 text-[#f7768e] opacity-90"></i>
      <span class="text-[#bb9af7]">2022 – 2023</span>
    </div>
  </div>
  <div class="flex items-center mb-4">
    <i class="fas fa-location-dot mr-2 text-[#7dcfff] opacity-90"></i>
    <span class="text-[#7dcfff]">NexHealth</span>
    <span class="mx-2 text-[#565f89]">•</span>
    <span class="text-[#9ece6a]">San Francisco, CA [Remote]</span>
  </div>
  <ul class="space-y-3">
    <% [
      "Resuscitated an ancient Python 2/Django app and ported it to Ruby on Rails",
      "Untangled a hairy, ten year old, diamond dependency",
      "Fixed a mountain of broken tests, bringing the test suite green for the first time ever"
    ].each do |bullet| %>
      <li class="cv-bullet">
        <%= bullet %>
      </li>
    <% end %>
  </ul>
</div> 