<%# Education Section %>
<section class="cv-section animate-fade-in" style="animation-delay: 600ms;">
  <h3 class="text-xl font-semibold text-[#f7768e] mb-6 flex items-center">
    <span class="mr-2">🎓</span>
    Education
  </h3>

  <div class="space-y-6">
    <div class="cv-job-entry">
      <div class="flex flex-wrap items-baseline justify-between mb-2">
        <h4 class="text-lg font-semibold text-[#7aa2f7]">Bachelor of Science in Nuclear Engineering Technology</h4>
        <div class="text-[#bb9af7]">2007 – 2009</div>
      </div>
      <div class="flex items-center text-[#7dcfff] mb-4">
        <i class="fas fa-location-dot mr-2"></i>
        Excelsior University
        <span class="mx-2">•</span>
        <span class="text-[#9ece6a]">Albany, NY</span>
      </div>
      <ul class="space-y-3">
        <% [
          "Advanced mathematics including calculus, differential equations, and linear algebra",
          "Nuclear physics, reactor theory, and thermodynamics",
          "Radiation protection and nuclear materials handling",
          "Plant systems and operations",
          "Specialized focus on nuclear power generation systems"
        ].each do |bullet| %>
          <li class="cv-bullet">
            <%= bullet %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="cv-job-entry">
      <div class="flex flex-wrap items-baseline justify-between mb-2">
        <h4 class="text-lg font-semibold text-[#7aa2f7]">Nuclear Power School</h4>
        <div class="text-[#bb9af7]">2003 – 2004</div>
      </div>
      <div class="flex items-center text-[#7dcfff] mb-4">
        <i class="fas fa-location-dot mr-2"></i>
        Naval Nuclear Power Training Command
        <span class="mx-2">•</span>
        <span class="text-[#9ece6a]">Goose Creek, SC</span>
      </div>
      <ul class="space-y-3">
        <% [
          "Reactor plant materials, mechanical systems, and fluid dynamics",
          "Advanced nuclear physics and reactor theory",
          "Thermodynamics and heat transfer principles",
          "Electrical engineering and power distribution systems",
          "Nuclear chemistry and radiological fundamentals"
        ].each do |bullet| %>
          <li class="cv-bullet">
            <%= bullet %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</section> 