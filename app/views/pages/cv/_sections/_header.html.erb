<%# Header Section %>
<section class="cv-section max-w-4xl mx-auto mb-6 animate-fade-in relative">
  <div class="icon-container-reset animate-slide-in-right">
    <%= link_to "/CV.pdf", class: "group", title: "Download PDF" do %>
      <i class="fas fa-file-pdf text-xl text-[#a9b1d6] group-hover:text-[#f7768e] transition-all duration-300 group-hover:scale-110"></i>
    <% end %>
    <%= link_to "/CV.docx", class: "group", title: "Download Word Document" do %>
      <i class="fas fa-file-word text-xl text-[#a9b1d6] group-hover:text-[#7dcfff] transition-all duration-300 group-hover:scale-110"></i>
    <% end %>
  </div>

  <div class="flex flex-col items-center justify-center text-center w-full">
    <div class="mb-8 w-full">
      <h1 class="animate-slide-in-left">Matt Kelly</h1>
      <h2 class="animate-slide-in-left" style="animation-delay: 100ms;">Managing Staff Software Engineer</h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2 sm:gap-6 text-base animate-slide-in-left w-full max-w-3xl mx-auto taglines-grid" style="animation-delay: 200ms;">
      <div class="flex items-center justify-center" style="animation-delay: 200ms;">
        <i class="fas fa-lightbulb mr-2"></i>
        <span>Audacious vision for high-level abstractions</span>
      </div>
      <div class="flex items-center justify-center" style="animation-delay: 300ms;">
        <i class="fas fa-brain mr-2"></i>
        <span>Big picture systems thinker</span>
      </div>
      <div class="flex items-center justify-center" style="animation-delay: 400ms;">
        <i class="fas fa-compass mr-2"></i>
        <span>Product-minded decision maker</span>
      </div>
      <div class="flex items-center justify-center" style="animation-delay: 500ms;">
        <i class="fas fa-graduation-cap mr-2"></i>
        <span>Mentor at heart with a penchant for teaching</span>
      </div>
      <div class="flex items-center justify-center" style="animation-delay: 600ms;">
        <i class="fas fa-code-branch mr-2"></i>
        <span>Simplifier of complex systems</span>
      </div>
      <div class="flex items-center justify-center" style="animation-delay: 700ms;">
        <i class="fas fa-users mr-2"></i>
        <span>Team catalyst and force multiplier</span>
      </div>
    </div>
  </div>
</section> 