<%# Skills Section %>
<section class="mb-12 animate-fade-in" style="animation-delay: 300ms;">
  <h3 class="text-xl font-semibold text-[#f7768e] mb-4 flex items-center">
    <span class="mr-2">⚡</span>
    Technical Arsenal
  </h3>
  
  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <h4 class="text-[#bb9af7] mb-2">Languages</h4>
      <div class="flex flex-wrap gap-2">
        <% ["Ruby", "Python", "Javascript", "Go", "Clojure", "Lua", "Fennel", "Sindarin", "FORTH", "C#", "[ba|z|fi]sh", "Quenya", "QBASIC"].each do |lang| %>
          <span class="px-3 py-1 rounded-full bg-[#24283b] text-[#7aa2f7] transition-all duration-300 hover:scale-110 hover:bg-[#2ac3de]/10 hover:-translate-y-0.5 cursor-default"><%= lang %></span>
        <% end %>
      </div>
    </div>
    
    <div>
      <h4 class="text-[#bb9af7] mb-2">Technologies</h4>
      <div class="flex flex-wrap gap-2">
        <% ["Rails", "AWS", "Kubernetes", "ArgoCD", "PostgreSQL", "Redis", "Kafka", "Airflow", "Memcached"].each do |tech| %>
          <span class="px-3 py-1 rounded-full bg-[#24283b] text-[#7dcfff] transition-all duration-300 hover:scale-110 hover:bg-[#7dcfff]/10 hover:-translate-y-0.5 cursor-default"><%= tech %></span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-6">
    <h4 class="text-[#bb9af7] mb-2">Toolbelt</h4>
    <div class="flex flex-wrap gap-2">
      <% ["VS Code+Neovim", "Cursor", "iTerm2", "tmux", "Obsidian", "Talon Voice", "Hammerspoon", ":(){:|:&};:"].each do |tool| %>
        <span class="px-3 py-1 rounded-full bg-[#24283b] text-[#9ece6a] transition-all duration-300 hover:scale-110 hover:bg-[#9ece6a]/10 hover:-translate-y-0.5 cursor-default"><%= tool %></span>
      <% end %>
    </div>
  </div>
</section> 