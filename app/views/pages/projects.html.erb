<%# Projects Page with Tokyo Night theme %>
<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-4 sm:p-8">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-[#7aa2f7] text-3xl sm:text-4xl font-bold mb-8 sm:mb-12 text-center">Projects</h1>

    <style>
      /* Card base styles */
      .dev-card {
        composes: card-base;
        background: rgba(31, 35, 53, 0.8);
        border: 1px solid transparent;
        border-radius: 1rem;
        margin-bottom: 2rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        backdrop-filter: blur(8px);
        position: relative;
        isolation: isolate;
        z-index: 1;
        width: 100%;
        max-width: 100%;
      }

      .dev-card > div {
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .dev-card::before {
        content: '';
        position: absolute;
        inset: -2px;
        padding: 2px;
        background: linear-gradient(
          90deg,
          #7aa2f7 0%,     /* Tokyo Night blue */
          #bb9af7 16.67%, /* Tokyo Night purple */
          #7dcfff 33.33%, /* Tokyo Night cyan */
          #9ece6a 50%,    /* Tokyo Night green */
          #ff9e64 66.67%, /* Tokyo Night orange */
          #f7768e 83.33%, /* Tokyo Night red */
          #9d7cd8 91.67%, /* Transition purple */
          #7aa2f7 100%    /* Back to blue */
        );
        border-radius: calc(1rem + 2px);
        -webkit-mask: 
          linear-gradient(#fff 0 0) content-box, 
          linear-gradient(#fff 0 0);
        mask: 
          linear-gradient(#fff 0 0) content-box, 
          linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        opacity: 0;
        will-change: opacity, background-position;
        transition: opacity 0.3s ease;
        background-size: 200% 100%;
        z-index: 0;
      }

      .dev-card::after {
        content: '';
        position: absolute;
        inset: -1px;
        background: rgba(31, 35, 53, 0.95);
        border-radius: calc(1rem + 1px);
        z-index: -1;
      }

      .dev-card:hover {
        transform: translateY(-4px);
        box-shadow: 
          0 20px 25px -5px rgba(122, 162, 247, 0.1),
          0 10px 10px -5px rgba(187, 154, 247, 0.04);
      }

      .dev-card:hover::before {
        opacity: 1;
        animation: borderGradient 6s linear infinite;
      }

      /* Skills Container and Pills */
      .skills-container {
        position: relative;
        z-index: 2;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.75rem;
      }

      .skill-pill {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.75rem;
        background: rgba(122, 162, 247, 0.1);
        border: 1px solid rgba(122, 162, 247, 0.2);
        border-radius: 9999px;
        color: #a9b1d6;
        font-size: 0.875rem;
        transition: all 0.3s ease;
        font-family: 'Inter', sans-serif;
        letter-spacing: 0.01em;
        pointer-events: auto;
      }

      .skill-pill:hover {
        transform: translateY(-2px);
        background: rgba(187, 154, 247, 0.15);
        border-color: rgba(187, 154, 247, 0.3);
      }

      .skill-pill i {
        color: #9ece6a !important;
        transition: color 0.3s ease !important;
      }

      .skill-pill:hover i {
        color: #bb9af7 !important;
      }

      /* Card Actions */
      .card-actions {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-top: auto;
        padding-top: 1rem;
        border-top: 1px solid rgba(41, 41, 63, 0.5);
        position: relative;
        z-index: 10;
      }

      .dev-card .card-actions a.card-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #7aa2f7;
        font-weight: 500;
        transition: all 0.3s ease;
        text-decoration: none !important;
        background: none !important;
        border: none !important;
        cursor: pointer !important;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        position: relative;
        z-index: 20;
        pointer-events: auto !important;
      }

      .dev-card .card-actions a.card-link:hover {
        color: #bb9af7 !important;  /* Tokyo Night pink */
        transform: translateY(-2px);
      }

      .dev-card .card-actions a.card-link:hover i,
      .dev-card .card-actions a.card-link:hover span {
        color: #bb9af7 !important;  /* Tokyo Night pink */
      }

      .dev-card .card-actions a.card-link i,
      .dev-card .card-actions a.card-link span {
        transition: color 0.3s ease;
        pointer-events: none;
      }

      .dev-card .card-actions a.card-link i {
        font-size: 1.125rem;
      }

      /* Override any conflicting styles */
      .dev-card a {
        pointer-events: auto !important;
      }

      /* Grid Layout */
      .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 3.5rem;
        margin: 0 auto;
        padding: 1.5rem;
        width: 100%;
        max-width: 100%;
        margin-bottom: 4rem;
      }

      @media (max-width: 1024px) {
        .grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 3rem;
          padding: 1rem;
        }
      }

      @media (max-width: 768px) {
        .grid {
          grid-template-columns: minmax(0, 1fr);
          gap: 3rem;
          padding: 1.5rem;
          width: calc(100% - 2rem);
          margin: 0 auto 3rem auto;
        }

        .dev-card {
          margin: 0 auto 2rem auto;
          max-width: 32rem;
        }
      }

      /* Container adjustments */
      .max-w-4xl {
        width: 100%;
        max-width: 100%;
        padding: 0 1rem;
        margin: 0 auto;
      }

      @media (min-width: 1024px) {
        .max-w-4xl {
          max-width: 72rem;
        }
      }

      /* Project Title */
      .dev-card h2 {
        color: #7aa2f7;
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
      }

      /* Project Description */
      .dev-card p {
        color: #a9b1d6;
        margin-bottom: 1.5rem;
        line-height: 1.6;
      }

      @keyframes borderGradient {
        0% { background-position: 0% 0; }
        100% { background-position: 200% 0; }
      }
    </style>

