<%# References Page with Tokyo Night theme %>
<style>
  .reference-card {
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid transparent;
    border-radius: 1rem;
    padding: 2rem;
    margin-bottom: 2rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    position: relative;
    isolation: isolate;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }

  .reference-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    padding: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,     /* Tokyo Night blue */
      #bb9af7 16.67%, /* Tokyo Night purple */
      #7dcfff 33.33%, /* Tokyo Night cyan */
      #9ece6a 50%,    /* Tokyo Night green */
      #ff9e64 66.67%, /* Tokyo Night orange */
      #f7768e 83.33%, /* Tokyo Night red */
      #9d7cd8 91.67%, /* Transition purple */
      #7aa2f7 100%    /* Back to blue */
    );
    border-radius: calc(1rem + 2px);
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    will-change: opacity, background-position;
    transition: opacity 0.3s ease;
    background-size: 200% 100%;
    z-index: 0;
  }

  .reference-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    background: rgba(31, 35, 53, 0.95);
    border-radius: calc(1rem + 1px);
    z-index: -1;
  }

  .reference-card:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 20px 25px -5px rgba(122, 162, 247, 0.1),
      0 10px 10px -5px rgba(187, 154, 247, 0.04);
  }

  .reference-card:hover::before {
    opacity: 1;
    animation: borderGradient 6s linear infinite;
  }

  @keyframes borderGradient {
    0% { background-position: 0 0; }
    100% { background-position: 200% 0; }
  }

  .avatar {
    width: 6rem;
    height: 6rem;
    border-radius: 9999px;
    object-fit: cover;
    border: 2px solid #7aa2f7;
    box-shadow: 0 0 15px rgba(122, 162, 247, 0.3);
    transition: all 0.3s ease;
    margin-bottom: 1rem;
    position: relative;
  }

  .reference-card:hover .avatar {
    border-color: #bb9af7;
    box-shadow: 0 0 20px rgba(187, 154, 247, 0.4);
  }

  .profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem;
    width: 25%;
    border-right: 1px solid rgba(122, 162, 247, 0.2);
    position: relative;
    z-index: 2;
  }

  .profile-section.right {
    border-right: none;
    border-left: 1px solid rgba(122, 162, 247, 0.2);
  }

  .content-section {
    width: 75%;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .reference-flex {
    display: flex;
    min-height: 100%;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .profile-link {
    display: block;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    position: relative;
    z-index: 3;
  }

  .profile-link:hover {
    transform: translateY(-2px);
  }

  .profile-link:hover .avatar {
    border-color: #bb9af7;
    transform: scale(1.05);
  }

  .profile-link:hover h3 {
    color: #bb9af7;
  }

  .profile-link h3 {
    transition: all 0.3s ease;
    margin-top: 0.5rem;
    position: relative;
  }

  .profile-title {
    text-align: center;
    max-width: 90%;
    line-height: 1.4;
  }
</style>

