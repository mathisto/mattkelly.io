<h1>Interactive Terminal Test</h1>
<div class="instructions">
  <h2>Try These Commands:</h2>
  <ul>
    <li><code>help</code> - See all available commands</li>
    <li><code>ls</code> - List files in current directory</li>
    <li><code>ls -la</code> - List all files including hidden ones</li>
    <li><code>cat role.txt</code> - Read your role description</li>
    <li><code>whoami</code> - Display ASCII art name</li>
    <li><code>cd .secrets</code> - Explore the secrets directory</li>
    <li><code>pwd</code> - Print working directory</li>
    <li><code>clear</code> - Clear the terminal</li>
  </ul>
</div>
<div 
  class="terminal-container" 
  data-controller="interactive-terminal"
  data-action="keydown->interactive-terminal#handleKeydown"
  tabindex="0"
  >
  <div class="terminal-header">
    <div class="dot dot-red"></div>
    <div class="dot dot-yellow"></div>
    <div class="dot dot-green"></div>
  </div>
  <div class="terminal-output" data-interactive-terminal-target="output"></div>
  <div class="terminal-input-line">
    <span class="terminal-prompt" data-interactive-terminal-target="prompt"></span>
    <span class="terminal-input" data-interactive-terminal-target="input"></span>
  </div>
</div>
