<%# Blog Posts Index with Tokyo Night theme %>
<style>
  @keyframes borderGradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  /* Blog Post Card Styles */
  .post-card {
    display: flex;
    flex-direction: column;
    background: rgba(31, 35, 53, 0.8);
    border-radius: clamp(0.5rem, 2vw, 1rem);
    position: relative;
    width: 100%;
    max-width: 64rem;
    margin: 0 auto clamp(1rem, 3vw, 1.5rem);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    isolation: isolate;
  }

  .post-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 4px;
    right: 4px;
    height: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,     /* Tokyo Night blue */
      #bb9af7 16.67%, /* Tokyo Night purple */
      #7dcfff 33.33%, /* Tokyo Night cyan */
      #9ece6a 50%,    /* Tokyo Night green */
      #ff9e64 66.67%, /* Tokyo Night orange */
      #f7768e 83.33%, /* Tokyo Night red */
      #9d7cd8 91.67%, /* Transition purple */
      #7aa2f7 100%    /* Back to blue */
    );
    background-size: 200% 100%;
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
    transform: scaleX(0.98);
    transform-origin: center;
  }

  .post-card-content {
    background: rgba(31, 35, 53, 0.95);
    border-radius: clamp(0.5rem, 2vw, 1rem);
    padding: clamp(1rem, 3vw, 1.5rem);
    height: 100%;
    backdrop-filter: blur(8px);
  }

  @media (hover: hover) {
    .post-card:hover {
      transform: translateY(-4px);
      box-shadow: 
        0 20px 25px -5px rgba(122, 162, 247, 0.1),
        0 10px 10px -5px rgba(187, 154, 247, 0.04);
    }

    .post-card:hover::before {
      opacity: 1;
      animation: borderGradient 6s linear infinite;
    }
  }

  /* Post Card Header */
  .post-card .header-container {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(0.5rem, 2vw, 1rem);
    align-items: start;
    margin-bottom: clamp(0.75rem, 2vw, 1rem);
  }

  .post-card h2 {
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    line-height: 1.3;
    color: #7aa2f7;
    font-weight: 600;
    font-family: 'Space Grotesk', sans-serif;
  }

  /* Date Container */
  .post-card .date-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #7dcfff;
    font-size: clamp(0.875rem, 2.5vw, 1rem);
    white-space: nowrap;
  }

  .post-card .date-container i {
    color: #bb9af7 !important;
    opacity: 0.9;
    margin-right: 0.5rem;
  }

  /* Tags */
  .post-card .tags {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.25rem, 1vw, 0.5rem);
    margin-top: clamp(0.75rem, 2vw, 1rem);
  }

  .post-card .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: clamp(0.25rem, 1vw, 0.375rem) clamp(0.5rem, 1.5vw, 0.75rem);
    background: rgba(122, 162, 247, 0.1);
    border: 1px solid rgba(122, 162, 247, 0.2);
    border-radius: 9999px;
    color: #a9b1d6;
    font-size: clamp(0.75rem, 2vw, 0.875rem);
    transition: all 0.3s ease;
  }

  @media (hover: hover) {
    .post-card .tag:hover {
      background: rgba(187, 154, 247, 0.15);
      border-color: rgba(187, 154, 247, 0.3);
      transform: translateY(-1px);
    }
  }

  /* Card Actions */
  .post-card .card-actions {
    display: flex;
    justify-content: flex-start;
    margin-top: clamp(1rem, 3vw, 1.5rem);
  }

  .post-card .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: clamp(0.5rem, 1.5vw, 0.75rem) clamp(0.75rem, 2vw, 1rem);
    color: #7aa2f7;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
  }

  .post-card .card-link i {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    transition: transform 0.3s ease;
  }

  .post-card .card-link span {
    font-size: clamp(0.875rem, 2.5vw, 1rem);
  }

  @media (hover: hover) {
    .post-card .card-link:hover {
      color: #bb9af7;
    }

    .post-card .card-link:hover i {
      transform: translateX(2px);
    }
  }

  /* Mobile Optimizations */
  @media (max-width: 639px) {
    .post-card {
      margin-left: -1rem;
      margin-right: -1rem;
      border-radius: 0;
    }

    .post-card-content {
      border-radius: 0;
    }

    .post-card .header-container {
      grid-template-columns: 1fr;
    }

    .post-card .date-container {
      margin-top: 0.5rem;
    }

    .post-card .tags {
      margin-top: 1rem;
    }

    .post-card .card-actions {
      justify-content: center;
    }
  }
</style>

<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-4 sm:p-8">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-[#7aa2f7] text-3xl sm:text-4xl font-bold mb-8 sm:mb-12">Blog Posts</h1>

    <div class="space-y-6">
      <% @posts.each do |post| %>
        <article class="post-card">
          <div class="post-card-content">
            <div class="header-container">
              <h2><%= post.title %></h2>
              <div class="date-container">
                <i class="fas fa-calendar-alt"></i>
                <time datetime="<%= post.date.strftime('%Y-%m-%d') %>">
                  <%= post.date.strftime('%B %d, %Y') %>
                </time>
              </div>
            </div>
            
            <p class="text-[#a9b1d6] mb-4 text-base sm:text-lg"><%= post.description %></p>
            
            <div class="tags">
              <% post.tags.each do |tag| %>
                <span class="tag">
                  <i class="fas fa-tag"></i>
                  <%= tag %>
                </span>
              <% end %>
            </div>
            
            <div class="card-actions">
              <%= link_to post_path(post), class: "card-link" do %>
                <i class="fas fa-book-open"></i>
                <span>Read More</span>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</div> 