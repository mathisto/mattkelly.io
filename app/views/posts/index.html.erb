<%= render Hero::PageHeaderComponent.new(
  title: "Blog Posts",
  subtitle: "Thoughts on software development, architecture, and leadership"
) %>

<%= render Layout::SectionComponent.new do %>
  <%= render Layout::ContainerComponent.new(size: :prose) do %>
    <%= render Blog::PostListComponent.new(posts: @posts) %>
  <% end %>
<% end %>
