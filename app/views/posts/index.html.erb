<%# Blog Posts Index with Tokyo Night theme %>
<style>
  @keyframes borderGradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  /* Blog Post Card Styles */
  .post-card {
    display: flex;
    flex-direction: column;
    background: rgba(31, 35, 53, 0.8);
    border-radius: 1rem;
    position: relative;
    width: 100%;
    max-width: 64rem;
    margin: 0 auto 1.5rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    isolation: isolate;
  }

  .post-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 4px;
    right: 4px;
    height: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,     /* Tokyo Night blue */
      #bb9af7 16.67%, /* Tokyo Night purple */
      #7dcfff 33.33%, /* Tokyo Night cyan */
      #9ece6a 50%,    /* Tokyo Night green */
      #ff9e64 66.67%, /* Tokyo Night orange */
      #f7768e 83.33%, /* Tokyo Night red */
      #9d7cd8 91.67%, /* Transition purple */
      #7aa2f7 100%    /* Back to blue */
    );
    background-size: 200% 100%;
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1;
    transform: scaleX(0.98);
    transform-origin: center;
  }

  .post-card-content {
    background: rgba(31, 35, 53, 0.95);
    border-radius: 1rem;
    padding: 1.5rem;
    height: 100%;
    backdrop-filter: blur(8px);
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 20px 25px -5px rgba(122, 162, 247, 0.1),
      0 10px 10px -5px rgba(187, 154, 247, 0.04);
  }

  .post-card:hover::before {
    opacity: 1;
    animation: borderGradient 6s linear infinite;
  }

  /* Post Card Header */
  .post-card .header-container {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: start;
    margin-bottom: 0.75rem;
  }

  .post-card h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #7aa2f7;
    margin: 0;
    line-height: 1.4;
  }

  /* Date styling */
  .post-card .date-container {
    display: flex;
    align-items: center;
    white-space: nowrap;
    color: #bb9af7;
    font-size: 0.95rem;
  }

  .post-card .date-container i {
    color: #bb9af7 !important;
    opacity: 0.9;
    margin-right: 0.5rem;
  }

  /* Tags styling */
  .post-card .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .post-card .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: rgba(122, 162, 247, 0.1);
    border: 1px solid rgba(122, 162, 247, 0.2);
    border-radius: 9999px;
    color: #a9b1d6;
    font-size: 0.875rem;
    transition: all 0.3s ease;
  }

  .post-card .tag:hover {
    transform: translateY(-2px);
    background: rgba(187, 154, 247, 0.15);
    border-color: rgba(187, 154, 247, 0.3);
  }

  /* Card Actions */
  .post-card .card-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  .post-card .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    color: #a9b1d6;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .post-card .card-link:hover {
    color: #f7768e;
    transform: translateY(-2px);
  }

  .post-card .card-link i {
    font-size: 1.25rem;
    color: inherit;
    transition: all 0.3s ease;
  }

  .post-card .card-link:hover i {
    transform: scale(1.1);
    color: inherit;
  }

  .post-card .card-link span {
    position: relative;
    color: inherit;
  }

  .post-card .card-link span::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 1px;
    bottom: -2px;
    left: 0;
    background-color: #f7768e;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .post-card .card-link:hover span::after {
    transform: scaleX(1);
  }
</style>

<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-8">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-[#7aa2f7] text-4xl font-bold mb-8">Blog Posts</h1>

    <div class="space-y-6">
      <% @posts.each do |post| %>
        <article class="post-card">
          <div class="post-card-content">
            <div class="header-container">
              <h2><%= post.title %></h2>
              <div class="date-container">
                <i class="fas fa-calendar-alt"></i>
                <time datetime="<%= post.date.strftime('%Y-%m-%d') %>">
                  <%= post.date.strftime('%B %d, %Y') %>
                </time>
              </div>
            </div>
            
            <p class="text-[#a9b1d6] mb-4"><%= post.description %></p>
            
            <div class="tags">
              <% post.tags.each do |tag| %>
                <span class="tag">
                  <i class="fas fa-tag"></i>
                  <%= tag %>
                </span>
              <% end %>
            </div>
            
            <div class="card-actions">
              <%= link_to post_path(post), class: "card-link" do %>
                <i class="fas fa-book-open"></i>
                <span>Read More</span>
              <% end %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</div> 