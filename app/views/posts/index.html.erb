<%# Blog Index %>
<div class="py-12">
  <%# Header %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold font-heading text-[#7aa2f7]">Blog</h1>
      <p class="mt-4 text-xl text-[#a9b1d6]">Thoughts, tutorials, and tech explorations.</p>
    </div>
  </div>

  <%# Posts Grid %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
    <div class="grid gap-8">
      <% @posts.each do |post| %>
        <%= link_to post_path(post) do %>
          <div class="dev-card"
               data-controller="entrance"
               data-entrance-delay-value="<%= @posts.index(post) * 100 %>">
            <%# Post Header %>
            <div class="flex items-center justify-between mb-4">
              <div>
                <h2 class="card-title">
                  <%= post.title %>
                </h2>
                <div class="card-subtitle">
                  <time datetime="<%= post.date %>">
                    <%= post.date.strftime("%B %d, %Y") %>
                  </time>
                  <span class="mx-2">•</span>
                  <span><%= post.reading_time %> min read</span>
                </div>
              </div>
            </div>

            <%# Post Preview %>
            <p class="card-content">
              <%= post.description %>
            </p>

            <%# Tags %>
            <div class="skills-container">
              <% post.tags.each do |tag| %>
                <span class="skill-pill">
                  <i class="fas fa-tag"></i>
                  <%= tag %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div> 