<%# Blog Posts Index with Tokyo Night theme %>
<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-8">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-[#7aa2f7] text-4xl font-bold mb-8">Blog Posts</h1>

    <div class="grid gap-6">
      <% @posts.each do |post| %>
        <article class="post-card">
          <h2 class="card-title"><%= post.title %></h2>
          
          <div class="card-subtitle">
            <time datetime="<%= post.date.strftime('%Y-%m-%d') %>">
              <i class="fas fa-calendar-alt mr-2 opacity-90"></i>
              <%= post.date.strftime('%B %d, %Y') %>
            </time>
          </div>
          
          <p class="card-content"><%= post.description %></p>
          
          <div class="tags">
            <% post.tags.each do |tag| %>
              <span class="tag"><%= tag %></span>
            <% end %>
          </div>
          
          <div class="card-actions">
            <%= link_to post_path(post), class: "card-link" do %>
              <i class="fas fa-book-open"></i>
              <span>Read More</span>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</div> 