<%# Project card with entrance animation %>
<div class="dev-card"
     data-controller="entrance"
     data-entrance-delay-value="<%= project_counter * 100 %>">
  <h3 class="card-title">
    <%= project.title %>
  </h3>
  
  <p class="card-content">
    <%= project.description %>
  </p>
  
  <div class="skills-container">
    <% project.technologies_used.each do |tech| %>
      <span class="skill-pill">
        <i class="fas fa-code"></i>
        <%= tech %>
      </span>
    <% end %>
  </div>
  
  <div class="card-actions">
    <% if project.github_url.present? %>
      <%= link_to project.github_url, class: "card-link", target: "_blank" do %>
        <i class="fab fa-github"></i>
        <span>GitHub</span>
      <% end %>
    <% end %>
    
    <% if project.live_site_url.present? %>
      <%= link_to project.live_site_url, class: "card-link", target: "_blank" do %>
        <i class="fas fa-link"></i>
        <span>Live Site</span>
      <% end %>
    <% end %>
  </div>
</div> 