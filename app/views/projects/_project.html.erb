<%# Project card with entrance animation %>
<div class="project-card bg-[#16161e]/50 border border-[#29293f] rounded-lg p-6 hover:border-[#7aa2f7]/50"
     data-controller="entrance"
     data-entrance-delay-value="<%= project_counter * 100 %>">
  <h3 class="text-xl font-semibold mb-3 text-[#7aa2f7]">
    <%= project.title %>
  </h3>
  
  <p class="text-[#a9b1d6] mb-4">
    <%= project.description %>
  </p>
  
  <div class="flex flex-wrap gap-2 mb-4">
    <% project.technologies_used.each do |tech| %>
      <span class="px-2 py-1 text-sm rounded bg-[#1a1b26] border border-[#29293f] text-[#7dcfff]">
        <%= tech %>
      </span>
    <% end %>
  </div>
  
  <div class="flex space-x-4">
    <% if project.github_url.present? %>
      <%= link_to project.github_url, class: "project-link group", target: "_blank" do %>
        <span class="flex items-center px-3 py-2 rounded-lg bg-[#1a1b26]/50 border border-[#29293f] hover:border-[#7aa2f7]/50">
          <svg class="w-4 h-4 mr-2 transition-transform duration-300 ease-spring group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
          </svg>
          <span class="text-sm font-medium text-[#7aa2f7] group-hover:text-[#bb9af7] transition-colors">GitHub</span>
        </span>
      <% end %>
    <% end %>
    
    <% if project.live_site_url.present? %>
      <%= link_to project.live_site_url, class: "project-link group", target: "_blank" do %>
        <span class="flex items-center px-3 py-2 rounded-lg bg-[#1a1b26]/50 border border-[#29293f] hover:border-[#7aa2f7]/50">
          <svg class="w-4 h-4 mr-2 transition-transform duration-300 ease-spring group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          <span class="text-sm font-medium text-[#7aa2f7] group-hover:text-[#bb9af7] transition-colors">Live Site</span>
        </span>
      <% end %>
    <% end %>
  </div>
</div> 