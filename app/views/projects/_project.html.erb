<%# Project card with entrance animation %>
<div class="project-card bg-[#16161e]/50 border border-[#29293f] rounded-lg p-6 hover:border-[#7aa2f7]/50"
     data-controller="entrance"
     data-entrance-delay-value="<%= project_counter * 100 %>">
  <h3 class="text-xl font-semibold mb-3 text-[#7aa2f7]">
    <%= project.title %>
  </h3>
  
  <p class="text-[#a9b1d6] mb-4">
    <%= project.description %>
  </p>
  
  <div class="flex flex-wrap gap-2 mb-4">
    <% project.technologies_used.each do |tech| %>
      <span class="px-2 py-1 text-sm rounded bg-[#1a1b26] border border-[#29293f] text-[#7dcfff]">
        <%= tech %>
      </span>
    <% end %>
  </div>
  
  <div class="flex space-x-4">
    <% if project.github_url.present? %>
      <%= link_to project.github_url, class: "project-link group", target: "_blank" do %>
        <span class="flex items-center px-3 py-2 rounded-lg bg-[#1a1b26]/50 border border-[#29293f] hover:border-[#7aa2f7]/50">
          <i class="fab fa-github w-4 h-4 mr-2 transition-transform duration-300 ease-spring group-hover:scale-110"></i>
          <span class="text-sm font-medium text-[#7aa2f7] group-hover:text-[#bb9af7] transition-colors">GitHub</span>
        </span>
      <% end %>
    <% end %>
    
    <% if project.live_site_url.present? %>
      <%= link_to project.live_site_url, class: "project-link group", target: "_blank" do %>
        <span class="flex items-center px-3 py-2 rounded-lg bg-[#1a1b26]/50 border border-[#29293f] hover:border-[#7aa2f7]/50">
          <i class="fas fa-link w-4 h-4 mr-2 transition-transform duration-300 ease-spring group-hover:scale-110"></i>
          <span class="text-sm font-medium text-[#7aa2f7] group-hover:text-[#bb9af7] transition-colors">Live Site</span>
        </span>
      <% end %>
    <% end %>
  </div>
</div> 