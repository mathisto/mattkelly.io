<%# Projects Index with Tokyo Night theme %>
<style>
  /* Project Grid Layout */
  .projects-grid {
    display: grid;
    gap: clamp(1rem, 3vw, 2rem);
    grid-template-columns: repeat(1, 1fr);
    width: 100%;
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Project Card Container */
  .project-container {
    padding: clamp(0.5rem, 2vw, 1rem);
  }

  /* Mobile Optimizations */
  @media (max-width: 639px) {
    .project-container {
      padding: 0.5rem;
    }

    .projects-grid {
      gap: 1rem;
      margin: 0 -0.5rem;
    }

    .dev-card {
      margin: 0;
    }

    .dev-card:hover {
      transform: none;
    }

    .skills-container {
      justify-content: flex-start;
      padding: 0.25rem;
    }

    .skill-pill {
      font-size: 0.75rem;
      padding: 0.3rem 0.6rem;
    }
  }
</style>

<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] py-8 px-4 sm:py-12 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto w-full">
    <h1 class="text-[#7aa2f7] text-3xl sm:text-4xl font-bold mb-8 sm:mb-12">Projects</h1>

    <div class="projects-grid">
      <%= render partial: "project", collection: @projects, as: :project %>
    </div>
  </div>
</div> 