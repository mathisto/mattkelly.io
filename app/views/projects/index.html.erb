<%# Projects Index %>
<div class="py-12">
  <%# Header %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold font-heading text-[#7aa2f7]">Projects</h1>
      <p class="mt-4 text-xl text-[#a9b1d6]">A collection of my favorite projects and experiments.</p>
    </div>
  </div>

  <%# Projects Grid %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <% @projects.each do |project| %>
        <%# Project Card %>
        <div class="group relative bg-[#1f2335] rounded-lg shadow-lg overflow-hidden border border-[#29293f] transition-all duration-300 hover:border-[#7aa2f7] hover:shadow-xl hover:shadow-[#7aa2f7]/5">
          <%# Project Image %>
          <% if project.screenshot_url.present? %>
            <div class="aspect-w-16 aspect-h-9 bg-[#16161e] group-hover:opacity-90 transition-opacity duration-300">
              <%= image_tag project.screenshot_url, class: "object-cover", alt: project.title %>
            </div>
          <% else %>
            <div class="aspect-w-16 aspect-h-9 bg-[#16161e] flex items-center justify-center">
              <svg class="h-12 w-12 text-[#29293f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          <% end %>

          <%# Project Content %>
          <div class="p-6">
            <h3 class="text-xl font-semibold font-heading text-[#7aa2f7] group-hover:text-[#bb9af7] transition-colors duration-300">
              <%= project.title %>
            </h3>
            
            <p class="mt-2 text-[#a9b1d6]"><%= project.description %></p>

            <%# Technologies %>
            <div class="mt-4 flex flex-wrap gap-2">
              <% project.technologies_used.each do |tech| %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#29293f] text-[#7aa2f7]">
                  <%= tech %>
                </span>
              <% end %>
            </div>

            <%# Links %>
            <div class="mt-6 flex items-center space-x-4">
              <% if project.github_url.present? %>
                <%= link_to project.github_url, class: "text-[#7aa2f7] hover:text-[#bb9af7] transition-colors duration-200", target: "_blank", rel: "noopener noreferrer" do %>
                  <span class="sr-only">GitHub</span>
                  <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                  </svg>
                <% end %>
              <% end %>

              <% if project.live_site_url.present? %>
                <%= link_to project.live_site_url, class: "text-[#7aa2f7] hover:text-[#bb9af7] transition-colors duration-200", target: "_blank", rel: "noopener noreferrer" do %>
                  <span class="sr-only">Live Site</span>
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                <% end %>
              <% end %>

              <%= link_to project_path(project), class: "ml-auto text-[#7aa2f7] hover:text-[#bb9af7] transition-colors duration-200" do %>
                <span class="sr-only">View Details</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div> 