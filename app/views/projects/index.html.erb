<%# Projects Index %>
<div class="py-12">
  <%# Header %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold font-heading text-[#7aa2f7]">Projects</h1>
      <p class="mt-4 text-xl text-[#a9b1d6]">A collection of my favorite projects and experiments.</p>
    </div>
  </div>

  <%# Projects Grid %>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= render partial: "project", collection: @projects, as: :project %>
    </div>
  </div>
</div> 