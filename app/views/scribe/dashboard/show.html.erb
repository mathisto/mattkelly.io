<%= turbo_stream_from "scribe_dashboard" %>
<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-4 sm:p-8">
  <div class="max-w-6xl mx-auto">
    <!-- Flash Messages -->
    <div id="flash-message"></div>
    <!-- Input Form Card -->
    <div class="dev-card mb-8">
      <div class="p-6">
        <div id="utterance_form">
          <%= render Scribe::UtteranceFormComponent.new %>
        </div>
      </div>
    </div>
    <!-- Tabbed Data Card -->
    <div class="dev-card" data-controller="tabs">
      <div class="p-6">
        <h2 class="text-[#7aa2f7] text-2xl font-bold mb-6">Activity Log</h2>
        <!-- Tab Navigation -->
        <div class="flex gap-2 mb-6 border-b border-[#3b4261]">
          <button 
            type="button"
            data-tabs-target="tab" 
            data-tab-name="all"
            data-action="click->tabs#select"
            class="tab-button px-4 py-2 font-medium transition-all">
            All Activity
          </button>
          <button 
            type="button"
            data-tabs-target="tab" 
            data-tab-name="workouts"
            data-action="click->tabs#select"
            class="tab-button px-4 py-2 font-medium transition-all">
            Workouts
          </button>
          <button 
            type="button"
            data-tabs-target="tab" 
            data-tab-name="ingestions"
            data-action="click->tabs#select"
            class="tab-button px-4 py-2 font-medium transition-all">
            Ingestions
          </button>
          <button 
            type="button"
            data-tabs-target="tab" 
            data-tab-name="sleep"
            data-action="click->tabs#select"
            class="tab-button px-4 py-2 font-medium transition-all">
            Sleep
          </button>
          <button 
            type="button"
            data-tabs-target="tab" 
            data-tab-name="journal"
            data-action="click->tabs#select"
            class="tab-button px-4 py-2 font-medium transition-all">
            Journal
          </button>
          <button 
            type="button"
            data-tabs-target="tab" 
            data-tab-name="parse_history"
            data-action="click->tabs#select"
            class="tab-button px-4 py-2 font-medium transition-all">
            Parse History
          </button>
        </div>
        <!-- Tab Panels -->
        <!-- All Activity Panel -->
        <div data-tabs-target="panel" data-tab-panel="all">
          <div class="overflow-x-auto">
            <table class="w-full table-auto">
              <thead class="bg-[#1f2335] border-b-2 border-[#7aa2f7]">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Utterance</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Type</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Details</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Confidence</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody id="ingestions-body" class="divide-y divide-[#3b4261]">
                <% if @ingestions.any? %>
                  <% @ingestions.each do |ingestion| %>
                    <%= render "scribe/ingestions/table_row", ingestion: ingestion %>
                  <% end %>
                <% else %>
                  <tr id="ingestions-empty-state">
                    <td colspan="5" class="px-4 py-12 text-center">
                      <p class="text-[#565f89] text-lg">No activity yet. Start tracking above!</p>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <!-- Workouts Panel -->
        <div data-tabs-target="panel" data-tab-panel="workouts" class="hidden" style="display: none;">
          <%= render Scribe::RollupStatsComponent.new(title: "Workout Summary", stats: @workout_stats) %>
          <div class="overflow-x-auto">
            <table class="w-full table-auto">
              <thead class="bg-[#1f2335] border-b-2 border-[#7aa2f7]">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Activity</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Metrics</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">When</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Confidence</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#3b4261]">
                <% if @workouts.any? %>
                  <% @workouts.each do |workout| %>
                    <%= render Scribe::WorkoutRowComponent.new(workout: workout) %>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="px-4 py-12 text-center">
                      <p class="text-[#565f89] text-lg">No workouts yet. Start tracking above!</p>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <!-- Ingestions Panel -->
        <div data-tabs-target="panel" data-tab-panel="ingestions" class="hidden" style="display: none;">
          <%= render Scribe::RollupStatsComponent.new(title: "Ingestion Summary", stats: @ingestion_stats) %>
          <div class="overflow-x-auto">
            <table class="w-full table-auto">
              <thead class="bg-[#1f2335] border-b-2 border-[#7aa2f7]">
                <tr>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Icon</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Item</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Amount</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Calories</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">When</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#3b4261]">
                <% if @ingestion_events&.any? %>
                  <% @ingestion_events.each do |ingestion_event| %>
                    <tr class="hover:bg-[#24283b] transition-colors">
                      <td class="px-4 py-3 text-center">
                        <span class="text-2xl"><%= ingestion_event.type_icon || "🍽️" %></span>
                      </td>
                      <td class="px-4 py-3">
                        <div class="text-sm text-[#c0caf5] font-medium"><%= ingestion_event.item_name %></div>
                      </td>
                      <td class="px-4 py-3 text-sm text-[#a9b1d6]">
                        <%= ingestion_event.formatted_normalized_quantity || content_tag(:span, "—", class: "text-[#565f89]") %>
                      </td>
                      <td class="px-4 py-3 text-sm text-[#a9b1d6]">
                        <%= ingestion_event.formatted_calories || content_tag(:span, "—", class: "text-[#565f89]") %>
                      </td>
                      <td class="px-4 py-3 text-sm">
                        <span class="text-[#565f89] hover:text-[#7aa2f7] transition-colors cursor-help" 
                              title="<%= ingestion_event.consumed_at.in_time_zone('Eastern Time (US & Canada)').strftime('%Y-%m-%d %H:%M:%S %Z') %>">
                          <%= time_ago_in_words(ingestion_event.consumed_at) %> ago
                        </span>
                      </td>
                      <td class="px-4 py-3">
                        <div class="flex items-center justify-center gap-2">
                          <%= link_to edit_scribe_ingestion_event_path(ingestion_event), 
                                class: "px-3 py-1 text-xs font-medium text-[#7aa2f7] hover:text-[#7dcfff] bg-[#1f2335] hover:bg-[#292e42] rounded-md transition-all duration-200 border border-[#3b4261] hover:border-[#7aa2f7]",
                                data: { turbo_frame: "_top" } do %>
                            Edit
                          <% end %>
                          <%= button_to scribe_ingestion_event_path(ingestion_event), 
                                method: :delete,
                                data: { turbo_confirm: "Are you sure you want to delete this ingestion?" },
                                class: "inline-block" do %>
                            <span class="px-3 py-1 text-xs font-medium text-[#f7768e] hover:text-[#ff9e64] bg-[#1f2335] hover:bg-[#292e42] rounded-md transition-all duration-200 border border-[#3b4261] hover:border-[#f7768e] cursor-pointer">
                              Delete
                            </span>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="6" class="px-4 py-12 text-center">
                      <p class="text-[#565f89] text-lg">No ingestions yet</p>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <!-- Sleep Panel -->
        <div data-tabs-target="panel" data-tab-panel="sleep" class="hidden" style="display: none;">
          <%= render Scribe::RollupStatsComponent.new(title: "Sleep Summary", stats: @sleep_stats) %>
          <div class="overflow-x-auto">
            <table class="w-full table-auto">
              <thead class="bg-[#1f2335] border-b-2 border-[#7aa2f7]">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Event</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Duration</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Start</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">End</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#3b4261]">
                <% if @sleep_events&.any? %>
                  <% @sleep_events.each do |sleep_event| %>
                    <tr class="hover:bg-[#24283b] transition-colors">
                      <td class="px-4 py-3">
                        <div class="flex items-center gap-2">
                          <span class="text-xl">
                            <%= sleep_event.type_icon %>
                          </span>
                          <span class="text-sm text-[#c0caf5] font-medium">
                            <%= sleep_event.event_type.titleize %>
                          </span>
                        </div>
                      </td>
                      <td class="px-4 py-3 text-sm text-[#a9b1d6]">
                        <%= sleep_event.formatted_duration || content_tag(:span, "—", class: "text-[#565f89]") %>
                      </td>
                      <td class="px-4 py-3 text-sm text-[#a9b1d6]">
                        <%= time_tag(sleep_event.occurred_at, format: :short) %>
                      </td>
                      <td class="px-4 py-3 text-sm text-[#a9b1d6]">
                        <% if sleep_event.event_type == 'wake' && sleep_event.respond_to?(:paired_sleep_start) && sleep_event.paired_sleep_start.present? %>
                          <%= time_tag(sleep_event.paired_sleep_start, format: :short) %>
                        <% else %>
                          <span class="text-[#565f89]">—</span>
                        <% end %>
                      </td>
                      <td class="px-4 py-3">
                        <div class="flex items-center justify-center gap-2">
                          <%= link_to edit_scribe_sleep_event_path(sleep_event), 
                                class: "px-3 py-1 text-xs font-medium text-[#7aa2f7] hover:text-[#7dcfff] bg-[#1f2335] hover:bg-[#292e42] rounded-md transition-all duration-200 border border-[#3b4261] hover:border-[#7aa2f7]",
                                data: { turbo_frame: "_top" } do %>
                            Edit
                          <% end %>
                          <%= button_to scribe_sleep_event_path(sleep_event), 
                                method: :delete,
                                data: { turbo_confirm: "Are you sure you want to delete this sleep event?" },
                                class: "inline-block" do %>
                            <span class="px-3 py-1 text-xs font-medium text-[#f7768e] hover:text-[#ff9e64] bg-[#1f2335] hover:bg-[#292e42] rounded-md transition-all duration-200 border border-[#3b4261] hover:border-[#f7768e] cursor-pointer">
                              Delete
                            </span>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="px-4 py-12 text-center">
                      <p class="text-[#565f89] text-lg">No sleep events yet</p>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <!-- Journal Panel -->
        <div data-tabs-target="panel" data-tab-panel="journal" class="hidden" style="display: none;">
          <%= render Scribe::RollupStatsComponent.new(title: "Journal Summary", stats: @journal_stats) %>
          <div class="overflow-x-auto">
            <table class="w-full table-auto">
              <thead class="bg-[#1f2335] border-b-2 border-[#7aa2f7]">
                <tr>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Icon</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Entry</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Words</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">When</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#3b4261]">
                <% if @journal_entries&.any? %>
                  <% @journal_entries.each do |journal_entry| %>
                    <tr class="hover:bg-[#24283b] transition-colors">
                      <td class="px-4 py-3 text-center">
                        <span class="text-2xl"><%= journal_entry.type_icon %></span>
                      </td>
                      <td class="px-4 py-3">
                        <div class="text-sm text-[#c0caf5] font-medium"><%= journal_entry.short_content(100) %></div>
                      </td>
                      <td class="px-4 py-3 text-sm text-[#a9b1d6]">
                        <%= journal_entry.word_count %>
                      </td>
                      <td class="px-4 py-3 text-sm">
                        <span class="text-[#565f89] hover:text-[#7aa2f7] transition-colors cursor-help" 
                              title="<%= (journal_entry.occurred_at || journal_entry.created_at).in_time_zone('Eastern Time (US & Canada)').strftime('%Y-%m-%d %H:%M:%S %Z') %>">
                          <%= time_ago_in_words(journal_entry.occurred_at || journal_entry.created_at) %> ago
                        </span>
                      </td>
                      <td class="px-4 py-3">
                        <div class="flex items-center justify-center gap-2">
                          <%= link_to edit_scribe_journal_entry_path(journal_entry), 
                                class: "px-3 py-1 text-xs font-medium text-[#7aa2f7] hover:text-[#7dcfff] bg-[#1f2335] hover:bg-[#292e42] rounded-md transition-all duration-200 border border-[#3b4261] hover:border-[#7aa2f7]",
                                data: { turbo_frame: "_top" } do %>
                            Edit
                          <% end %>
                          <%= button_to scribe_journal_entry_path(journal_entry), 
                                method: :delete,
                                data: { turbo_confirm: "Are you sure you want to delete this journal entry?" },
                                class: "inline-block" do %>
                            <span class="px-3 py-1 text-xs font-medium text-[#f7768e] hover:text-[#ff9e64] bg-[#1f2335] hover:bg-[#292e42] rounded-md transition-all duration-200 border border-[#3b4261] hover:border-[#f7768e] cursor-pointer">
                              Delete
                            </span>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="px-4 py-12 text-center">
                      <p class="text-[#565f89] text-lg">No journal entries yet</p>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <!-- Parse History Panel -->
        <div data-tabs-target="panel" data-tab-panel="parse_history" class="hidden" style="display: none;">
          <div class="overflow-x-auto">
            <table class="w-full table-auto">
              <thead class="bg-[#1f2335] border-b-2 border-[#7aa2f7]">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Utterance</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Status</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Model</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Created</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#3b4261]">
                <% if @ingestions.any? %>
                  <% @ingestions.each do |ingestion| %>
                    <tr class="hover:bg-[#24283b] transition-colors">
                      <td class="px-4 py-3">
                        <div class="text-sm text-[#c0caf5]"><%= truncate(ingestion.raw_utterance, length: 60) %></div>
                      </td>
                      <td class="px-4 py-3">
                        <%= render Scribe::BadgeComponent.new(
                          text: ingestion.status.titleize,
                          color: ingestion.status_badge_color
                        ) %>
                      </td>
                      <td class="px-4 py-3 text-sm text-[#a9b1d6]">
                        <%= ingestion.model_display_name %>
                      </td>
                      <td class="px-4 py-3 text-sm text-[#565f89]">
                        <%= time_ago_in_words(ingestion.created_at) %> ago
                      </td>
                      <td class="px-4 py-3 text-center">
                        <% if ingestion.retryable? %>
                          <%= button_to "Retry", retry_scribe_ingestion_path(ingestion), 
                                method: :post,
                                class: "text-[#7aa2f7] hover:text-[#7dcfff] text-sm" %>
                        <% else %>
                          <span class="text-[#565f89] text-xs">—</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="px-4 py-12 text-center">
                      <p class="text-[#565f89] text-lg">No parse history yet.</p>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  /* Reuse the beautiful card styles from projects page */
  .dev-card {
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid transparent;
    border-radius: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    position: relative;
    isolation: isolate;
  }

  .dev-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    padding: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,
      #bb9af7 33.33%,
      #7dcfff 66.67%,
      #7aa2f7 100%
    );
    border-radius: calc(1rem + 2px);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    background-size: 200% 100%;
    z-index: -2;
    pointer-events: none;
  }

  .dev-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    background: rgba(31, 35, 53, 0.95);
    border-radius: calc(1rem + 1px);
    z-index: -1;
    pointer-events: none;
  }

  /* Ensure card content is above pseudo-elements */
  .dev-card > * {
    position: relative;
    z-index: 1;
  }

  .dev-card:hover::before {
    opacity: 1;
    animation: borderGradient 3s linear infinite;
  }

  @keyframes borderGradient {
    0% { background-position: 0% 0; }
    100% { background-position: 200% 0; }
  }

  /* Tab Styles */
  .tab-button {
    color: #565f89;
    border: none;
    border-bottom: 3px solid transparent;
    background: transparent;
    cursor: pointer;
    position: relative;
    z-index: 10;
    border-radius: 0;
    padding-bottom: 0.75rem;
  }

  .tab-button.active {
    color: #7aa2f7;
    border-bottom-color: #7aa2f7;
    font-weight: 600;
  }

  .tab-button.inactive {
    color: #565f89;
  }

  .tab-button:hover:not(.active) {
    color: #a9b1d6;
    background: transparent;
  }

  /* Tab container */
  .flex.gap-2.mb-6.border-b {
    position: relative;
    z-index: 10;
  }

  /* Table row styles */
  tbody tr {
    transition: all 0.2s ease;
  }

  /* Odd rows - medium tone */
  tbody tr:nth-child(odd) {
    background-color: #24283b;
  }

  /* Even rows - lighter tone for clear contrast */
  tbody tr:nth-child(even) {
    background-color: #2a2e45;
  }

  tbody tr:hover {
    background-color: rgba(122, 162, 247, 0.2) !important;
    transform: translateX(4px);
  }

  tbody td {
    padding: 1rem;
    vertical-align: middle;
  }

  /* Fade-in animation for new rows */
  @keyframes fadeInFromTop {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  tbody > tr.fade-in-row {
    animation: fadeInFromTop 0.5s ease-out;
  }
</style>
