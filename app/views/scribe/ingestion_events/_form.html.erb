<%= form_with model: [:scribe, @ingestion_event], local: true, data: { turbo: false } do |form| %>
  <% if @ingestion_event.errors.any? %>
    <div class="mb-6 p-4 bg-[#292e42] border border-[#f7768e] rounded-lg">
      <h3 class="text-[#f7768e] font-medium mb-2">
        <%= pluralize(@ingestion_event.errors.count, "error") %> prohibited this ingestion from being saved:
      </h3>
      <ul class="list-disc list-inside text-[#c0caf5] text-sm">
        <% @ingestion_event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="space-y-6">
    <!-- Type (ingestion_type) -->
    <div>
      <%= form.label :ingestion_type, "Type", class: "block text-[#7aa2f7] font-medium mb-2" %>
      <%= form.select :ingestion_type, 
          options_for_select([
            ['Food', 'food'],
            ['Beverage', 'beverage'],
            ['Medication', 'medication'],
            ['Supplement', 'supplement'],
            ['Substance', 'substance']
          ], @ingestion_event.ingestion_type),
          { prompt: "Select a type" },
          { required: true,
            class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" } %>
    </div>
    <!-- Item Name -->
    <div>
      <%= form.label :item_name, "Item Name", class: "block text-[#7aa2f7] font-medium mb-2" %>
      <%= form.text_field :item_name, 
          required: true,
          placeholder: "e.g., Water, Coffee, Vyvanse",
          class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" %>
    </div>
    <!-- Quantity and Unit in a grid -->
    <div class="grid grid-cols-2 gap-4">
      <!-- Quantity -->
      <div>
        <%= form.label :quantity, "Quantity", class: "block text-[#7aa2f7] font-medium mb-2" %>
        <%= form.number_field :quantity,
            step: 0.01,
            placeholder: "Amount",
            class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" %>
      </div>
      <!-- Unit -->
      <div>
        <%= form.label :unit, "Unit", class: "block text-[#7aa2f7] font-medium mb-2" %>
        <%= form.text_field :unit,
            placeholder: "e.g., ml, g, tablets",
            class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" %>
      </div>
    </div>
    <!-- Normalized Values (auto-calculated, read-only display) -->
    <div class="grid grid-cols-2 gap-4">
      <!-- Normalized Quantity -->
      <div>
        <%= form.label :normalized_quantity, "Normalized Quantity", class: "block text-[#7aa2f7] font-medium mb-2" %>
        <div class="text-sm text-[#565f89] mb-1">Auto-calculated by service</div>
        <%= form.number_field :normalized_quantity,
            step: 0.01,
            readonly: true,
            placeholder: "Auto-calculated",
            class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full opacity-60" %>
      </div>
      <!-- Normalized Unit -->
      <div>
        <%= form.label :normalized_unit, "Normalized Unit", class: "block text-[#7aa2f7] font-medium mb-2" %>
        <div class="text-sm text-[#565f89] mb-1">Auto-calculated by service</div>
        <%= form.text_field :normalized_unit,
            readonly: true,
            placeholder: "Auto-calculated",
            class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full opacity-60" %>
      </div>
    </div>
    <!-- Nutritional Information -->
    <div class="space-y-4">
      <h3 class="text-[#bb9af7] font-medium">Nutritional Information (Optional)</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Calories -->
        <div>
          <%= form.label :calories, "Calories", class: "block text-[#7aa2f7] font-medium mb-2" %>
          <%= form.number_field :calories,
              step: 1,
              placeholder: "kcal",
              class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" %>
        </div>
        <!-- Protein -->
        <div>
          <%= form.label :protein_grams, "Protein (g)", class: "block text-[#7aa2f7] font-medium mb-2" %>
          <%= form.number_field :protein_grams,
              step: 0.1,
              placeholder: "grams",
              class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" %>
        </div>
        <!-- Carbs -->
        <div>
          <%= form.label :carbs_grams, "Carbs (g)", class: "block text-[#7aa2f7] font-medium mb-2" %>
          <%= form.number_field :carbs_grams,
              step: 0.1,
              placeholder: "grams",
              class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" %>
        </div>
        <!-- Fat -->
        <div>
          <%= form.label :fat_grams, "Fat (g)", class: "block text-[#7aa2f7] font-medium mb-2" %>
          <%= form.number_field :fat_grams,
              step: 0.1,
              placeholder: "grams",
              class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" %>
        </div>
      </div>
    </div>
    <!-- Substance Information (for medications/substances) -->
    <div class="space-y-4">
      <h3 class="text-[#bb9af7] font-medium">Substance Information (Optional)</h3>
      <div class="grid grid-cols-2 gap-4">
        <!-- Substance Category -->
        <div>
          <%= form.label :substance_category, "Substance Category", class: "block text-[#7aa2f7] font-medium mb-2" %>
          <%= form.select :substance_category,
              options_for_select([
                ['Caffeine', 'caffeine'],
                ['THC', 'thc'],
                ['Prescription', 'prescription'],
                ['Nicotine', 'nicotine'],
                ['Alcohol', 'alcohol'],
                ['Stimulant', 'stimulant'],
                ['Depressant', 'depressant'],
                ['Other', 'other']
              ], @ingestion_event.substance_category),
              { prompt: "Select if applicable", include_blank: true },
              { class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" } %>
        </div>
        <!-- Active Ingredient -->
        <div>
          <%= form.label :active_ingredient_mg, "Active Ingredient (mg)", class: "block text-[#7aa2f7] font-medium mb-2" %>
          <%= form.number_field :active_ingredient_mg,
              step: 0.01,
              placeholder: "mg of active ingredient",
              class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" %>
        </div>
      </div>
    </div>
    <!-- Consumed At -->
    <div>
      <%= form.label :consumed_at, "Consumed At", class: "block text-[#7aa2f7] font-medium mb-2" %>
      <%= form.datetime_local_field :consumed_at,
          value: (@ingestion_event.consumed_at || Time.current).strftime('%Y-%m-%dT%H:%M'),
          required: true,
          class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full" %>
    </div>
    <!-- Notes -->
    <div>
      <%= form.label :notes, "Notes", class: "block text-[#7aa2f7] font-medium mb-2" %>
      <%= form.text_area :notes,
          rows: 3,
          placeholder: "Additional notes (optional)",
          class: "px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent w-full resize-y" %>
    </div>
    <!-- Form Actions -->
    <div class="flex items-center justify-between pt-6 border-t border-[#3b4261]">
      <%= link_to "Cancel", scribe_dashboard_path, 
          class: "px-6 py-3 text-[#565f89] hover:text-[#c0caf5] transition-colors" %>
      <%= form.submit "Save Ingestion", 
          class: "px-6 py-3 bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] text-white font-medium rounded-lg hover:from-[#7dcfff] hover:to-[#7aa2f7] transition-all duration-300 transform hover:scale-105 cursor-pointer" %>
    </div>
  </div>
<% end %>
