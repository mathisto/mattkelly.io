<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-4 sm:p-8">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-[#7aa2f7] mb-2">Edit Ingestion Event</h1>
      <p class="text-[#565f89]">Update consumption details</p>
    </div>
    <!-- Form Card -->
    <div class="dev-card">
      <div class="p-6 sm:p-8">
        <%= render 'form', ingestion_event: @ingestion_event %>
      </div>
    </div>
    <!-- Delete Option -->
    <div class="mt-6 text-center">
      <%= button_to "Delete this ingestion", 
          scribe_ingestion_event_path(@ingestion_event),
          method: :delete,
          data: { 
            turbo_confirm: "Are you sure you want to delete this ingestion event? This action cannot be undone." 
          },
          class: "text-[#f7768e] hover:text-[#ff9e64] text-sm transition-colors" %>
    </div>
  </div>
</div>
<style>
  /* Reuse the beautiful card styles from dashboard */
  .dev-card {
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid transparent;
    border-radius: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    position: relative;
    isolation: isolate;
  }

  .dev-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    padding: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,
      #bb9af7 33.33%,
      #7dcfff 66.67%,
      #7aa2f7 100%
    );
    border-radius: calc(1rem + 2px);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    background-size: 200% 100%;
    z-index: -2;
    pointer-events: none;
  }

  .dev-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    background: rgba(31, 35, 53, 0.95);
    border-radius: calc(1rem + 1px);
    z-index: -1;
    pointer-events: none;
  }

  /* Ensure card content is above pseudo-elements */
  .dev-card > * {
    position: relative;
    z-index: 1;
  }

  .dev-card:hover::before {
    opacity: 1;
    animation: borderGradient 3s linear infinite;
  }

  @keyframes borderGradient {
    0% { background-position: 0% 0; }
    100% { background-position: 200% 0; }
  }
</style>
