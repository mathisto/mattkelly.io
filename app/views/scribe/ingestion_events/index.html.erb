<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-4 sm:p-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-bold text-[#7aa2f7] mb-2">Ingestion Events</h1>
        <p class="text-[#565f89]">Track and manage your consumption history</p>
      </div>
      <div class="flex gap-4">
        <%= link_to "← Dashboard", scribe_dashboard_path,
            class: "px-4 py-2 text-[#565f89] hover:text-[#c0caf5] transition-colors" %>
        <%= link_to "+ New Ingestion", new_scribe_ingestion_event_path,
            class: "px-6 py-3 bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] text-white font-medium rounded-lg hover:from-[#7dcfff] hover:to-[#7aa2f7] transition-all duration-300 transform hover:scale-105" %>
      </div>
    </div>
    <!-- Table Card -->
    <div class="dev-card">
      <div class="p-6">
        <div class="overflow-x-auto">
          <table class="w-full table-auto">
            <thead class="bg-[#1f2335] border-b-2 border-[#7aa2f7]">
              <tr>
                <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Icon</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Item</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Category</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Amount</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Nutrition</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">When</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#3b4261]">
              <% if @ingestion_events&.any? %>
                <% @ingestion_events.each do |ingestion_event| %>
                  <tr class="hover:bg-[#24283b] transition-colors">
                    <!-- Icon -->
                    <td class="px-4 py-4 text-center">
                      <span class="text-2xl"><%= ingestion_event.type_icon %></span>
                    </td>
                    <!-- Item Name -->
                    <td class="px-4 py-4">
                      <div class="text-sm text-[#c0caf5] font-medium">
                        <%= ingestion_event.item_name %>
                      </div>
                      <% if ingestion_event.notes.present? %>
                        <div class="text-xs text-[#565f89] mt-1">
                          <%= truncate(ingestion_event.notes, length: 50) %>
                        </div>
                      <% end %>
                    </td>
                    <!-- Category -->
                    <td class="px-4 py-4">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                        <%= case ingestion_event.ingestion_type
                            when 'food' then 'bg-[#ff9e64]/20 text-[#ff9e64]'
                            when 'beverage' then 'bg-[#7dcfff]/20 text-[#7dcfff]'
                            when 'medication' then 'bg-[#f7768e]/20 text-[#f7768e]'
                            when 'supplement' then 'bg-[#9ece6a]/20 text-[#9ece6a]'
                            when 'substance' then 'bg-[#bb9af7]/20 text-[#bb9af7]'
                            else 'bg-[#565f89]/20 text-[#565f89]'
                            end %>">
                        <%= ingestion_event.ingestion_type.capitalize %>
                      </span>
                      <% if ingestion_event.substance_category.present? %>
                        <div class="text-xs text-[#565f89] mt-1">
                          <%= ingestion_event.substance_category.capitalize %>
                        </div>
                      <% end %>
                    </td>
                    <!-- Amount -->
                    <td class="px-4 py-4 text-sm text-[#a9b1d6]">
                      <% if ingestion_event.formatted_quantity %>
                        <div><%= ingestion_event.formatted_quantity %></div>
                      <% end %>
                      <% if ingestion_event.formatted_normalized_quantity %>
                        <div class="text-xs text-[#565f89]">
                          (<%= ingestion_event.formatted_normalized_quantity %>)
                        </div>
                      <% end %>
                      <% if ingestion_event.active_ingredient_mg.present? %>
                        <div class="text-xs text-[#7aa2f7] mt-1">
                          <%= ingestion_event.active_ingredient_mg %> mg active
                        </div>
                      <% end %>
                      <% if !ingestion_event.formatted_quantity && !ingestion_event.formatted_normalized_quantity %>
                        <span class="text-[#565f89]">—</span>
                      <% end %>
                    </td>
                    <!-- Nutrition -->
                    <td class="px-4 py-4 text-sm text-[#a9b1d6]">
                      <% if ingestion_event.calories.present? %>
                        <div class="font-medium"><%= ingestion_event.calories %> kcal</div>
                      <% end %>
                      <% macros = [] %>
                      <% macros << "#{ingestion_event.protein_grams}g protein" if ingestion_event.protein_grams.present? %>
                      <% macros << "#{ingestion_event.carbs_grams}g carbs" if ingestion_event.carbs_grams.present? %>
                      <% macros << "#{ingestion_event.fat_grams}g fat" if ingestion_event.fat_grams.present? %>
                      <% if macros.any? %>
                        <div class="text-xs text-[#565f89]">
                          <%= macros.join(" • ") %>
                        </div>
                      <% end %>
                      <% if !ingestion_event.calories.present? && macros.empty? %>
                        <span class="text-[#565f89]">—</span>
                      <% end %>
                    </td>
                    <!-- When -->
                    <td class="px-4 py-4">
                      <div class="text-sm text-[#c0caf5]">
                        <%= ingestion_event.consumed_at.strftime("%b %d, %Y") %>
                      </div>
                      <div class="text-xs text-[#565f89]">
                        <%= ingestion_event.consumed_at.strftime("%l:%M %p") %>
                      </div>
                    </td>
                    <!-- Actions -->
                    <td class="px-4 py-4">
                      <div class="flex items-center justify-center gap-2">
                        <%= link_to edit_scribe_ingestion_event_path(ingestion_event), 
                              class: "px-3 py-1 text-xs font-medium text-[#7aa2f7] hover:text-[#7dcfff] bg-[#1f2335] hover:bg-[#292e42] rounded-md transition-all duration-200 border border-[#3b4261] hover:border-[#7aa2f7]",
                              data: { turbo_frame: "_top" } do %>
                          Edit
                        <% end %>
                        <%= button_to scribe_ingestion_event_path(ingestion_event), 
                              method: :delete,
                              data: { turbo_confirm: "Are you sure you want to delete this ingestion?" },
                              class: "inline-block" do %>
                          <span class="px-3 py-1 text-xs font-medium text-[#f7768e] hover:text-[#ff9e64] bg-[#1f2335] hover:bg-[#292e42] rounded-md transition-all duration-200 border border-[#3b4261] hover:border-[#f7768e] cursor-pointer">
                            Delete
                          </span>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="7" class="px-4 py-12 text-center">
                    <p class="text-[#565f89] text-lg mb-4">No ingestion events yet</p>
                    <%= link_to "Track your first ingestion", new_scribe_ingestion_event_path,
                        class: "inline-block px-6 py-3 bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] text-white font-medium rounded-lg hover:from-[#7dcfff] hover:to-[#7aa2f7] transition-all duration-300 transform hover:scale-105" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <!-- Pagination if needed -->
        <% if @ingestion_events&.respond_to?(:total_pages) && @ingestion_events.total_pages > 1 %>
          <div class="mt-6 flex justify-center">
            <%= paginate @ingestion_events, theme: 'tokyo_night' %>
          </div>
        <% end %>
      </div>
    </div>
    <!-- Summary Stats Card (optional enhancement) -->
    <% if @ingestion_events&.any? %>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Today's Calories -->
        <div class="dev-card-mini p-4">
          <div class="text-[#565f89] text-xs uppercase tracking-wider mb-1">Today's Calories</div>
          <div class="text-2xl font-bold text-[#7aa2f7]">
            <%= @ingestion_events.today.sum(:calories) || 0 %> kcal
          </div>
        </div>
        <!-- Today's Water -->
        <div class="dev-card-mini p-4">
          <div class="text-[#565f89] text-xs uppercase tracking-wider mb-1">Today's Hydration</div>
          <div class="text-2xl font-bold text-[#7dcfff]">
            <%= (@ingestion_events.today.beverage.sum(:normalized_quantity) || 0).round(0) %> ml
          </div>
        </div>
        <!-- Today's Items -->
        <div class="dev-card-mini p-4">
          <div class="text-[#565f89] text-xs uppercase tracking-wider mb-1">Items Today</div>
          <div class="text-2xl font-bold text-[#bb9af7]">
            <%= @ingestion_events.today.count %>
          </div>
        </div>
        <!-- Needs Review -->
        <div class="dev-card-mini p-4">
          <div class="text-[#565f89] text-xs uppercase tracking-wider mb-1">Needs Review</div>
          <div class="text-2xl font-bold text-[#f7768e]">
            <%= @ingestion_events.needs_review.count %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
<style>
  /* Reuse the beautiful card styles from dashboard */
  .dev-card {
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid transparent;
    border-radius: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    position: relative;
    isolation: isolate;
  }

  .dev-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    padding: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,
      #bb9af7 33.33%,
      #7dcfff 66.67%,
      #7aa2f7 100%
    );
    border-radius: calc(1rem + 2px);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    background-size: 200% 100%;
    z-index: -2;
    pointer-events: none;
  }

  .dev-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    background: rgba(31, 35, 53, 0.95);
    border-radius: calc(1rem + 1px);
    z-index: -1;
    pointer-events: none;
  }

  /* Ensure card content is above pseudo-elements */
  .dev-card > * {
    position: relative;
    z-index: 1;
  }

  .dev-card:hover::before {
    opacity: 1;
    animation: borderGradient 3s linear infinite;
  }

  /* Mini card for stats */
  .dev-card-mini {
    background: rgba(31, 35, 53, 0.6);
    border: 1px solid #3b4261;
    border-radius: 0.75rem;
    transition: all 0.2s ease;
  }

  .dev-card-mini:hover {
    background: rgba(31, 35, 53, 0.9);
    border-color: #7aa2f7;
    transform: translateY(-2px);
  }

  @keyframes borderGradient {
    0% { background-position: 0% 0; }
    100% { background-position: 200% 0; }
  }

  /* Table row styles */
  tbody tr {
    transition: all 0.2s ease;
  }

  /* Odd rows - medium tone */
  tbody tr:nth-child(odd) {
    background-color: #24283b;
  }

  /* Even rows - lighter tone for clear contrast */
  tbody tr:nth-child(even) {
    background-color: #2a2e45;
  }

  tbody tr:hover {
    background-color: rgba(122, 162, 247, 0.1) !important;
    transform: translateX(2px);
  }
</style>
