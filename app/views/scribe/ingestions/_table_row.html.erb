<tr id="ingestion_<%= ingestion.id %>" 
    class="fade-in-row"
    data-ingestion-id="<%= ingestion.id %>">
  <!-- Utterance -->
  <td class="text-sm">
    <div class="text-[#a9b1d6]" title="<%= ingestion.raw_utterance %>">
      <%= ingestion.raw_utterance %>
    </div>
    <div class="text-xs text-[#565f89] mt-1 italic">
      parsed as: 
      <% if ingestion.status == "failed" %>
        <span class="text-[#f7768e]">❌ Parsing Error: <%= ingestion.error_message || "Unknown error" %></span>
      <% elsif ingestion.workout %>
        workout • <%= ingestion.workout.activity_type %> • <%= ingestion.workout.summary %>
      <% elsif ingestion.ingestion_event %>
        <%= ingestion.ingestion_event.type_icon %> <%= ingestion.ingestion_event.item_name %> • <%= ingestion.ingestion_event.formatted_normalized_quantity || "—" %> • <%= ingestion.ingestion_event.formatted_calories || "—" %>
      <% elsif ingestion.sleep_event %>
        <% event_type_text = ingestion.sleep_event.sleep_event? ? "went to sleep" : "woke up" %>
        <% duration_or_status = ingestion.sleep_event.formatted_duration || "awaiting pair" %>
        <%= ingestion.sleep_event.type_icon %> <%= event_type_text %> • <%= duration_or_status %>
      <% elsif ingestion.journal_entry %>
        📔 journal entry • <%= ingestion.journal_entry.word_count %> words
      <% else %>
        ⏳ Processing...
      <% end %>
      <% if ingestion.created_at %>
        • 
        <span class="text-[#565f89] hover:text-[#7aa2f7] transition-colors cursor-help" 
              title="<%= ingestion.created_at.in_time_zone('Eastern Time (US & Canada)').strftime('%Y-%m-%d %H:%M:%S %Z') %>">
          <%= time_ago_in_words(ingestion.created_at) %> ago
        </span>
      <% end %>
    </div>
  </td>
  <!-- Classification -->
  <td class="text-sm">
    <% if ingestion.status == "failed" %>
      <span class="text-[#f7768e] font-medium">❌ Failed</span>
    <% elsif ingestion.workout %>
      <span class="text-[#7dcfff] font-medium">💪 Workout</span>
    <% elsif ingestion.ingestion_event %>
      <span class="text-[#7aa2f7] font-medium"><%= ingestion.ingestion_event.type_icon %> <%= ingestion.ingestion_event.ingestion_type.titleize %></span>
    <% elsif ingestion.sleep_event %>
      <span class="text-[#bb9af7] font-medium">😴 Sleep</span>
    <% else %>
      <span class="text-[#565f89]">—</span>
    <% end %>
  </td>
  <!-- Details/Summary -->
  <td class="text-sm">
    <% if ingestion.status == "failed" %>
      <span class="text-[#f7768e]"><%= ingestion.error_message || "Parsing failed" %></span>
    <% elsif ingestion.workout %>
      <span class="text-[#c0caf5]"><%= ingestion.workout.summary %></span>
    <% elsif ingestion.ingestion_event %>
      <span class="text-[#c0caf5]">
        <%= ingestion.ingestion_event.item_name %>
        <% if ingestion.ingestion_event.formatted_normalized_quantity.present? %>
          (<%= ingestion.ingestion_event.formatted_normalized_quantity %>)
        <% end %>
        <% if ingestion.ingestion_event.formatted_calories.present? %>
          - <%= ingestion.ingestion_event.formatted_calories %>
        <% end %>
      </span>
    <% elsif ingestion.sleep_event %>
      <span class="text-[#c0caf5]">
        <%= ingestion.sleep_event.event_type.titleize %> at <%= ingestion.sleep_event.occurred_at.strftime("%l:%M %p").strip %>
        <% if ingestion.sleep_event.formatted_duration.present? %>
          • <%= ingestion.sleep_event.formatted_duration %>
        <% end %>
      </span>
    <% else %>
      <span class="text-[#565f89]">—</span>
    <% end %>
  </td>
  <!-- Confidence -->
  <td class="text-sm text-center">
    <% if ingestion.confidence_score %>
      <% percentage = (ingestion.confidence_score * 100).round(0) %>
      <% color_class = case ingestion.confidence_score
                       when 0.9..Float::INFINITY then "text-[#9ece6a]"
                       when 0.7..0.9 then "text-[#7aa2f7]"
                       when 0.5..0.7 then "text-[#e0af68]"
                       else "text-[#f7768e]"
                       end %>
      <span class="font-bold <%= color_class %>"><%= percentage %>%</span>
    <% else %>
      <span class="text-[#565f89]">—</span>
    <% end %>
  </td>
  <!-- Actions -->
  <td class="text-sm text-center align-middle">
    <div class="flex items-center justify-center gap-1.5">
      <% if ingestion.failed? && ingestion.retryable? %>
        <%= button_to retry_scribe_ingestion_path(ingestion), 
              method: :post,
              class: "inline-flex items-center justify-center w-5 h-5 text-[#7aa2f7] hover:text-[#7dcfff] hover:bg-[#1f2335] transition-colors rounded",
              style: "color: #7aa2f7;",
              title: "Retry parsing",
              data: { turbo_confirm: "Retry parsing this utterance?" } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="stroke: currentColor;">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        <% end %>
      <% end %>
      <%= link_to edit_scribe_ingestion_path(ingestion),
            class: "inline-flex items-center justify-center w-5 h-5 text-[#bb9af7] hover:text-[#c0caf5] hover:bg-[#1f2335] transition-colors rounded",
            style: "color: #bb9af7;",
            title: "Edit utterance" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="stroke: currentColor;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
        </svg>
      <% end %>
      <% if ingestion.completed? && ingestion.parsed_event.present? %>
        <% edit_path = if ingestion.workout
                         edit_scribe_workout_path(ingestion.workout)
                       elsif ingestion.ingestion_event
                         edit_scribe_ingestion_event_path(ingestion.ingestion_event)
                       elsif ingestion.sleep_event
                         edit_scribe_sleep_event_path(ingestion.sleep_event)
                       elsif ingestion.journal_entry
                         edit_scribe_journal_entry_path(ingestion.journal_entry)
                       end %>
        <% if edit_path %>
          <%= link_to edit_path,
                class: "inline-flex items-center justify-center w-5 h-5 text-[#9ece6a] hover:text-[#7dcfff] hover:bg-[#1f2335] transition-colors rounded",
                style: "color: #9ece6a;",
                title: "Edit parsed data" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="stroke: currentColor;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          <% end %>
        <% end %>
      <% end %>
      <%= button_to scribe_ingestion_path(ingestion), 
            method: :delete,
            class: "inline-flex items-center justify-center w-5 h-5 text-[#f7768e] hover:text-[#ff9e64] hover:bg-[#1f2335] transition-colors rounded",
            style: "color: #f7768e;",
            title: "Delete this entry",
            data: { turbo_confirm: "Delete this ingestion? This cannot be undone." } do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="stroke: currentColor;">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      <% end %>
    </div>
  </td>
</tr>
