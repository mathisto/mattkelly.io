<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-4 sm:p-8">
  <div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <%= link_to scribe_dashboard_path, class: "inline-flex items-center text-[#7aa2f7] hover:text-[#7dcfff] transition-colors mb-4" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Dashboard
      <% end %>
      <h1 class="text-3xl font-bold text-[#7aa2f7]">Edit Sleep Event</h1>
      <p class="text-[#565f89] mt-2">Update your sleep tracking information</p>
    </div>
    <!-- Pairing Info Card (if paired) -->
    <% if @sleep_event.paired_sleep_event.present? %>
      <div class="dev-card mb-6">
        <div class="p-4 bg-[#bb9af7]/10 border border-[#bb9af7]/30 rounded-lg">
          <h3 class="text-[#bb9af7] font-medium mb-2">🔗 Paired Event</h3>
          <p class="text-[#c0caf5] text-sm">
            This <%= @sleep_event.wake_event? ? "wake" : "sleep" %> event is paired with:
          </p>
          <div class="mt-2 flex items-center gap-3">
            <span class="text-xl"><%= @sleep_event.paired_sleep_event.type_icon %></span>
            <div>
              <p class="text-[#c0caf5] font-medium">
                <%= @sleep_event.paired_sleep_event.event_type.humanize %>
              </p>
              <p class="text-[#565f89] text-sm">
                <%= @sleep_event.paired_sleep_event.occurred_at.strftime("%B %d, %Y at %l:%M %p") %>
              </p>
            </div>
            <% if @sleep_event.duration_minutes.present? %>
              <div class="ml-auto">
                <p class="text-[#7dcfff] font-medium">
                  Duration: <%= @sleep_event.formatted_duration %>
                </p>
              </div>
            <% end %>
          </div>
          <%= link_to "View paired event →", 
                edit_scribe_sleep_event_path(@sleep_event.paired_sleep_event),
                class: "inline-block mt-3 text-[#7aa2f7] hover:text-[#7dcfff] text-sm font-medium transition-colors" %>
        </div>
      </div>
    <% elsif @sleep_event.paired_wake_event.present? %>
      <div class="dev-card mb-6">
        <div class="p-4 bg-[#bb9af7]/10 border border-[#bb9af7]/30 rounded-lg">
          <h3 class="text-[#bb9af7] font-medium mb-2">🔗 Paired Event</h3>
          <p class="text-[#c0caf5] text-sm">
            This sleep event is paired with:
          </p>
          <div class="mt-2 flex items-center gap-3">
            <span class="text-xl"><%= @sleep_event.paired_wake_event.type_icon %></span>
            <div>
              <p class="text-[#c0caf5] font-medium">
                <%= @sleep_event.paired_wake_event.event_type.humanize %>
              </p>
              <p class="text-[#565f89] text-sm">
                <%= @sleep_event.paired_wake_event.occurred_at.strftime("%B %d, %Y at %l:%M %p") %>
              </p>
            </div>
            <% if @sleep_event.paired_wake_event.duration_minutes.present? %>
              <div class="ml-auto">
                <p class="text-[#7dcfff] font-medium">
                  Duration: <%= @sleep_event.paired_wake_event.formatted_duration %>
                </p>
              </div>
            <% end %>
          </div>
          <%= link_to "View paired event →", 
                edit_scribe_sleep_event_path(@sleep_event.paired_wake_event),
                class: "inline-block mt-3 text-[#7aa2f7] hover:text-[#7dcfff] text-sm font-medium transition-colors" %>
        </div>
      </div>
    <% end %>
    <!-- Form Card -->
    <div class="dev-card">
      <div class="p-6">
        <%= render "form", sleep_event: @sleep_event %>
      </div>
    </div>
    <!-- Delete Section -->
    <div class="mt-6 p-4 border border-[#f7768e]/30 rounded-lg">
      <h3 class="text-[#f7768e] font-medium mb-2">Danger Zone</h3>
      <p class="text-[#565f89] text-sm mb-4">
        Deleting this sleep event will remove it permanently and unlink any paired events.
      </p>
      <%= button_to "Delete Sleep Event", 
            scribe_sleep_event_path(@sleep_event),
            method: :delete,
            data: { 
              turbo_confirm: "Are you sure you want to delete this sleep event? This action cannot be undone." 
            },
            class: "px-4 py-2 bg-[#f7768e]/10 text-[#f7768e] font-medium rounded-lg border border-[#f7768e]/30 hover:bg-[#f7768e]/20 transition-all duration-200 cursor-pointer" %>
    </div>
  </div>
</div>
<style>
  /* Reuse the beautiful card styles from dashboard */
  .dev-card {
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid transparent;
    border-radius: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    position: relative;
    isolation: isolate;
  }

  .dev-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    padding: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,
      #bb9af7 33.33%,
      #7dcfff 66.67%,
      #7aa2f7 100%
    );
    border-radius: calc(1rem + 2px);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    background-size: 200% 100%;
    z-index: -2;
    pointer-events: none;
  }

  .dev-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    background: rgba(31, 35, 53, 0.95);
    border-radius: calc(1rem + 1px);
    z-index: -1;
    pointer-events: none;
  }

  /* Ensure card content is above pseudo-elements */
  .dev-card > * {
    position: relative;
    z-index: 1;
  }

  .dev-card:hover::before {
    opacity: 1;
    animation: borderGradient 3s linear infinite;
  }

  @keyframes borderGradient {
    0% { background-position: 0% 0; }
    100% { background-position: 200% 0; }
  }
</style>
