<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-4 sm:p-8">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <%= link_to scribe_dashboard_path, class: "inline-flex items-center text-[#7aa2f7] hover:text-[#7dcfff] transition-colors mb-4" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Dashboard
        <% end %>
        <h1 class="text-3xl font-bold text-[#7aa2f7]">Sleep Events</h1>
        <p class="text-[#565f89] mt-2">Track and manage your sleep patterns</p>
      </div>
      <%= link_to new_scribe_sleep_event_path, 
            class: "px-6 py-3 bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] text-white font-medium rounded-lg hover:from-[#7dcfff] hover:to-[#e0af68] transition-all duration-200 inline-flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        New Sleep Event
      <% end %>
    </div>
    <!-- Sleep Events Table Card -->
    <div class="dev-card">
      <div class="p-6">
        <% if @sleep_events&.any? %>
          <div class="overflow-x-auto">
            <table class="w-full table-auto">
              <thead class="bg-[#1f2335] border-b-2 border-[#7aa2f7]">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Event</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Time</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Duration</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Quality</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Notes</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Status</th>
                  <th class="px-4 py-3 text-center text-xs font-medium text-[#7aa2f7] uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#3b4261]">
                <% @sleep_events.each do |sleep_event| %>
                  <tr class="hover:bg-[#24283b] transition-colors">
                    <!-- Event Type -->
                    <td class="px-4 py-4">
                      <div class="flex items-center gap-3">
                        <span class="text-2xl"><%= sleep_event.type_icon %></span>
                        <div>
                          <p class="text-[#c0caf5] font-medium">
                            <%= sleep_event.event_type.humanize %>
                          </p>
                          <% if sleep_event.paired_sleep_event.present? %>
                            <p class="text-[#bb9af7] text-xs">
                              🔗 Paired
                            </p>
                          <% elsif sleep_event.paired_wake_event.present? %>
                            <p class="text-[#bb9af7] text-xs">
                              🔗 Has wake event
                            </p>
                          <% end %>
                        </div>
                      </div>
                    </td>
                    <!-- Time -->
                    <td class="px-4 py-4">
                      <div>
                        <p class="text-[#c0caf5] text-sm">
                          <%= sleep_event.occurred_at.strftime("%b %d, %Y") %>
                        </p>
                        <p class="text-[#565f89] text-xs">
                          <%= sleep_event.occurred_at.strftime("%l:%M %p").strip %>
                        </p>
                      </div>
                    </td>
                    <!-- Duration -->
                    <td class="px-4 py-4">
                      <% if sleep_event.duration_minutes.present? %>
                        <span class="text-[#7dcfff] font-medium">
                          <%= sleep_event.formatted_duration %>
                        </span>
                      <% else %>
                        <span class="text-[#565f89]">—</span>
                      <% end %>
                    </td>
                    <!-- Quality -->
                    <td class="px-4 py-4">
                      <% if sleep_event.quality_score.present? %>
                        <div class="flex items-center gap-2">
                          <div class="w-20 bg-[#1f2335] rounded-full h-2">
                            <div class="bg-gradient-to-r from-[#f7768e] via-[#e0af68] to-[#9ece6a] h-2 rounded-full" 
                                 style="width: <%= (sleep_event.quality_score * 10).to_i %>%"></div>
                          </div>
                          <span class="text-[#c0caf5] text-sm">
                            <%= sleep_event.quality_score.round(1) %>
                          </span>
                        </div>
                      <% else %>
                        <span class="text-[#565f89]">—</span>
                      <% end %>
                    </td>
                    <!-- Notes -->
                    <td class="px-4 py-4">
                      <% if sleep_event.notes.present? %>
                        <p class="text-[#a9b1d6] text-sm truncate max-w-xs" title="<%= sleep_event.notes %>">
                          <%= truncate(sleep_event.notes, length: 30) %>
                        </p>
                      <% else %>
                        <span class="text-[#565f89]">—</span>
                      <% end %>
                    </td>
                    <!-- Status -->
                    <td class="px-4 py-4 text-center">
                      <% if sleep_event.needs_review? %>
                        <span class="px-2 py-1 text-xs font-medium text-[#e0af68] bg-[#e0af68]/10 rounded-full">
                          Needs Review
                        </span>
                      <% elsif sleep_event.confidence_score.present? %>
                        <span class="px-2 py-1 text-xs font-medium text-[#9ece6a] bg-[#9ece6a]/10 rounded-full">
                          <%= (sleep_event.confidence_score * 100).to_i %>% confident
                        </span>
                      <% else %>
                        <span class="px-2 py-1 text-xs font-medium text-[#7aa2f7] bg-[#7aa2f7]/10 rounded-full">
                          Manual
                        </span>
                      <% end %>
                    </td>
                    <!-- Actions -->
                    <td class="px-4 py-4">
                      <div class="flex items-center justify-center gap-2">
                        <%= link_to edit_scribe_sleep_event_path(sleep_event), 
                              class: "px-3 py-1 text-xs font-medium text-[#7aa2f7] hover:text-[#7dcfff] bg-[#1f2335] hover:bg-[#292e42] rounded-md transition-all duration-200 border border-[#3b4261] hover:border-[#7aa2f7]",
                              data: { turbo_frame: "_top" } do %>
                          Edit
                        <% end %>
                        <%= button_to scribe_sleep_event_path(sleep_event), 
                              method: :delete,
                              data: { turbo_confirm: "Are you sure you want to delete this sleep event?" },
                              class: "inline-block" do %>
                          <span class="px-3 py-1 text-xs font-medium text-[#f7768e] hover:text-[#ff9e64] bg-[#1f2335] hover:bg-[#292e42] rounded-md transition-all duration-200 border border-[#3b4261] hover:border-[#f7768e] cursor-pointer">
                            Delete
                          </span>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <!-- Empty State -->
          <div class="text-center py-12">
            <div class="text-6xl mb-4">😴</div>
            <h3 class="text-xl font-medium text-[#c0caf5] mb-2">No sleep events yet</h3>
            <p class="text-[#565f89] mb-6">Start tracking your sleep patterns for better health insights</p>
            <%= link_to new_scribe_sleep_event_path, 
                  class: "inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] text-white font-medium rounded-lg hover:from-[#7dcfff] hover:to-[#e0af68] transition-all duration-200" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Add Your First Sleep Event
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <!-- Sleep Statistics Card (optional enhancement) -->
    <% if @sleep_events&.any? %>
      <div class="dev-card mt-8">
        <div class="p-6">
          <h2 class="text-xl font-bold text-[#7aa2f7] mb-4">Sleep Statistics</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Average Duration -->
            <div class="bg-[#1a1b26] p-4 rounded-lg border border-[#3b4261]">
              <p class="text-[#565f89] text-sm mb-1">Average Sleep Duration</p>
              <p class="text-2xl font-bold text-[#7dcfff]">
                <% avg_duration = @sleep_events.where.not(duration_minutes: nil).average(:duration_minutes) %>
                <% if avg_duration %>
                  <%= (avg_duration / 60).round(1) %> hours
                <% else %>
                  —
                <% end %>
              </p>
            </div>
            <!-- Average Quality -->
            <div class="bg-[#1a1b26] p-4 rounded-lg border border-[#3b4261]">
              <p class="text-[#565f89] text-sm mb-1">Average Sleep Quality</p>
              <p class="text-2xl font-bold text-[#9ece6a]">
                <% avg_quality = @sleep_events.where.not(quality_score: nil).average(:quality_score) %>
                <% if avg_quality %>
                  <%= avg_quality.round(1) %>/10
                <% else %>
                  —
                <% end %>
              </p>
            </div>
            <!-- Total Events -->
            <div class="bg-[#1a1b26] p-4 rounded-lg border border-[#3b4261]">
              <p class="text-[#565f89] text-sm mb-1">Total Sleep Events</p>
              <p class="text-2xl font-bold text-[#bb9af7]">
                <%= @sleep_events.count %>
              </p>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
<style>
  /* Reuse the beautiful card styles from dashboard */
  .dev-card {
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid transparent;
    border-radius: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    position: relative;
    isolation: isolate;
  }

  .dev-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    padding: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,
      #bb9af7 33.33%,
      #7dcfff 66.67%,
      #7aa2f7 100%
    );
    border-radius: calc(1rem + 2px);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    background-size: 200% 100%;
    z-index: -2;
    pointer-events: none;
  }

  .dev-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    background: rgba(31, 35, 53, 0.95);
    border-radius: calc(1rem + 1px);
    z-index: -1;
    pointer-events: none;
  }

  /* Ensure card content is above pseudo-elements */
  .dev-card > * {
    position: relative;
    z-index: 1;
  }

  .dev-card:hover::before {
    opacity: 1;
    animation: borderGradient 3s linear infinite;
  }

  @keyframes borderGradient {
    0% { background-position: 0% 0; }
    100% { background-position: 200% 0; }
  }

  /* Table row styles */
  tbody tr {
    transition: all 0.2s ease;
  }

  /* Odd rows - medium tone */
  tbody tr:nth-child(odd) {
    background-color: #24283b;
  }

  /* Even rows - lighter tone for clear contrast */
  tbody tr:nth-child(even) {
    background-color: #2a2e45;
  }

  tbody tr:hover {
    background-color: rgba(122, 162, 247, 0.1) !important;
  }
</style>
