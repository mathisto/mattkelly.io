<div class="fixed top-4 right-4 z-[9999]" 
     data-controller="auto-dismiss"
     data-auto-dismiss-delay-value="2000"
     style="max-width: 280px; animation: slideInRight 0.3s ease-out;">
  <div class="bg-[#9ece6a]/10 backdrop-blur-sm border border-[#9ece6a]/30 rounded-lg px-4 py-3 shadow-xl">
    <div class="flex items-center gap-2">
      <div style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; max-width: 16px; max-height: 16px;">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" style="width: 16px; height: 16px; display: block;" class="text-[#9ece6a]">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
      </div>
      <div style="flex: 1; min-width: 0;">
        <p class="text-xs font-medium text-[#9ece6a] truncate">Tracked! <%= (confidence * 100).round %>% confidence</p>
      </div>
    </div>
  </div>
</div>
<style>
  @keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
</style>
