<div class="min-h-screen bg-[#1a1b26] text-[#a9b1d6] p-4 sm:p-8">
  <div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
      <%= link_to scribe_dashboard_path, class: "inline-flex items-center text-[#7aa2f7] hover:text-[#7dcfff] transition-colors mb-4" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Dashboard
      <% end %>
      <h1 class="text-3xl font-bold text-[#7aa2f7]">💪 Edit Workout</h1>
      <p class="text-[#565f89] mt-2">Update your workout information</p>
    </div>
    <!-- Form Card -->
    <div class="dev-card">
      <div class="p-6">
        <%= form_with model: @workout, url: scribe_workout_path(@workout), method: :patch, local: true do |f| %>
          <!-- Activity Type -->
          <div class="mb-4">
            <%= f.label :activity_type, "Activity Type", class: "block text-[#7aa2f7] font-medium mb-2" %>
            <%= f.select :activity_type, 
                  ['walk', 'run', 'bike', 'swim', 'strength', 'yoga', 'sports', 'other'],
                  {},
                  class: "w-full px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent" %>
          </div>
          <!-- Date/Time -->
          <div class="mb-4">
            <%= f.label :performed_at, "Date & Time", class: "block text-[#7aa2f7] font-medium mb-2" %>
            <%= f.datetime_local_field :performed_at,
                  class: "w-full px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent" %>
          </div>
          <!-- Duration -->
          <div class="mb-4">
            <%= f.label :duration_seconds, "Duration (minutes)", class: "block text-[#7aa2f7] font-medium mb-2" %>
            <%= f.number_field :duration_seconds,
                  value: @workout.duration_seconds ? (@workout.duration_seconds / 60.0).round(1) : nil,
                  step: 0.1,
                  placeholder: "e.g., 45.5",
                  class: "w-full px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent" %>
            <p class="text-[#565f89] text-sm mt-1">Enter duration in minutes (will be converted to seconds)</p>
          </div>
          <!-- Distance -->
          <div class="mb-4">
            <%= f.label :distance_meters, "Distance (km)", class: "block text-[#7aa2f7] font-medium mb-2" %>
            <%= f.number_field :distance_meters,
                  value: @workout.distance_meters ? (@workout.distance_meters / 1000.0).round(2) : nil,
                  step: 0.01,
                  placeholder: "e.g., 5.25",
                  class: "w-full px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent" %>
            <p class="text-[#565f89] text-sm mt-1">Enter distance in kilometers (will be converted to meters)</p>
          </div>
          <!-- Calories -->
          <div class="mb-4">
            <%= f.label :calories_burned, "Calories Burned", class: "block text-[#7aa2f7] font-medium mb-2" %>
            <%= f.number_field :calories_burned,
                  step: 1,
                  placeholder: "e.g., 450",
                  class: "w-full px-4 py-3 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:border-transparent" %>
          </div>
          <!-- Action Buttons -->
          <div class="flex gap-3 mt-6">
            <%= f.submit "Save Changes", 
                  class: "px-6 py-3 bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] text-white font-medium rounded-lg hover:opacity-90 transition-all duration-200 transform hover:scale-105" %>
            <%= link_to "Cancel", scribe_dashboard_path, 
                  class: "px-6 py-3 bg-[#24283b] text-[#a9b1d6] font-medium rounded-lg hover:bg-[#292e42] transition-colors border border-[#3b4261]" %>
          </div>
        <% end %>
      </div>
    </div>
    <!-- Delete Section -->
    <div class="mt-6 p-4 border border-[#f7768e]/30 rounded-lg">
      <h3 class="text-[#f7768e] font-medium mb-2">Danger Zone</h3>
      <p class="text-[#565f89] text-sm mb-4">
        Deleting this workout will remove it permanently.
      </p>
      <%= button_to "Delete Workout", 
            scribe_workout_path(@workout),
            method: :delete,
            data: { 
              turbo_confirm: "Are you sure you want to delete this workout? This action cannot be undone." 
            },
            class: "px-4 py-2 bg-[#f7768e]/10 text-[#f7768e] font-medium rounded-lg border border-[#f7768e]/30 hover:bg-[#f7768e]/20 transition-all duration-200 cursor-pointer" %>
    </div>
  </div>
</div>
<style>
  /* Reuse the beautiful card styles from dashboard */
  .dev-card {
    background: rgba(31, 35, 53, 0.8);
    border: 1px solid transparent;
    border-radius: 1rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(8px);
    position: relative;
    isolation: isolate;
  }

  .dev-card::before {
    content: '';
    position: absolute;
    inset: -2px;
    padding: 2px;
    background: linear-gradient(
      90deg,
      #7aa2f7 0%,
      #bb9af7 33.33%,
      #7dcfff 66.67%,
      #7aa2f7 100%
    );
    border-radius: calc(1rem + 2px);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    background-size: 200% 100%;
    z-index: -2;
    pointer-events: none;
  }

  .dev-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    background: rgba(31, 35, 53, 0.95);
    border-radius: calc(1rem + 1px);
    z-index: -1;
    pointer-events: none;
  }

  /* Ensure card content is above pseudo-elements */
  .dev-card > * {
    position: relative;
    z-index: 1;
  }

  .dev-card:hover::before {
    opacity: 1;
    animation: borderGradient 3s linear infinite;
  }

  @keyframes borderGradient {
    0% { background-position: 0% 0; }
    100% { background-position: 200% 0; }
  }
</style>
