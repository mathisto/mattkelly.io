<div class="min-h-screen bg-[#1a1b26] text-[#c0caf5] p-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-8 flex items-center justify-between">
      <div>
        <h1 class="text-4xl font-bold bg-gradient-to-r from-[#7aa2f7] to-[#bb9af7] bg-clip-text text-transparent">
          Workouts
        </h1>
        <p class="text-[#a9b1d6] mt-2">View and manage your tracked activities</p>
      </div>
      <%= link_to "← Dashboard", scribe_dashboard_path, class: "text-[#7aa2f7] hover:text-[#7dcfff]" %>
    </div>
    <!-- Filters (future enhancement) -->
    <div class="mb-6 bg-[#24283b] border border-[#3b4261] rounded-lg p-4">
      <%= search_form_for @q, url: scribe_workouts_path, class: "flex gap-4" do |f| %>
        <div class="flex-1">
          <%= f.search_field :activity_type_cont, 
                            placeholder: "Search by activity type...",
                            class: "w-full px-4 py-2 bg-[#1a1b26] border border-[#3b4261] rounded-lg text-[#c0caf5] placeholder-[#565f89] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7]" %>
        </div>
        <%= f.submit "Search", class: "px-6 py-2 bg-[#7aa2f7] text-[#1a1b26] font-medium rounded-lg hover:bg-[#7dcfff] transition-colors" %>
      <% end %>
    </div>
    <!-- Workouts Table -->
    <div class="bg-[#24283b] border border-[#3b4261] rounded-lg overflow-hidden">
      <% if @workouts.any? %>
        <table class="w-full">
          <thead class="bg-[#1a1b26]">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-medium text-[#a9b1d6] uppercase tracking-wider">Activity</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-[#a9b1d6] uppercase tracking-wider">Metrics</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-[#a9b1d6] uppercase tracking-wider">When</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-[#a9b1d6] uppercase tracking-wider">Confidence</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-[#a9b1d6] uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @workouts.each do |workout| %>
              <%= render Scribe::WorkoutRowComponent.new(workout: workout) %>
            <% end %>
          </tbody>
        </table>
        <!-- Pagination -->
        <div class="px-4 py-3 bg-[#1a1b26] border-t border-[#3b4261]">
          <%= paginate @workouts %>
        </div>
      <% else %>
        <div class="p-12 text-center">
          <p class="text-[#565f89] text-lg mb-4">No workouts found</p>
          <%= link_to "Go to Dashboard", scribe_dashboard_path, class: "text-[#7aa2f7] hover:text-[#7dcfff]" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
