<%# Accepts: code (string), language (string), filename (string, optional) %>
<div class="relative group rounded-lg overflow-hidden" data-controller="code-block">
  <% if local_assigns[:filename].present? %>
    <div class="flex items-center justify-between px-4 py-2 bg-[#1f2335] border-b border-[#29293f] rounded-t-lg">
      <span class="text-sm text-[#7aa2f7] font-mono"><%= filename %></span>
    </div>
    
    <div class="relative">
      <pre class="language-<%= local_assigns[:language] || 'plaintext' %> rounded-b-lg !m-0 !bg-[#1f2335]"><code data-code-block-target="code" class="!bg-transparent"><%= code %></code></pre>
      
      <button data-code-block-target="copyButton" data-action="click->code-block#copy" class="absolute top-2 right-2 p-2 rounded bg-[#29293f] text-[#7aa2f7] opacity-0 group-hover:opacity-100 transition-opacity duration-200 hover:bg-[#3b3b5d] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:ring-opacity-50" aria-label="Copy code">
        <svg class="copy-icon w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <svg class="check-icon w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </button>
    </div>
  <% else %>
    <div class="relative">
      <pre class="language-<%= local_assigns[:language] || 'plaintext' %> rounded-lg !m-0 !bg-[#1f2335]"><code data-code-block-target="code" class="!bg-transparent"><%= code %></code></pre>
      
      <button data-code-block-target="copyButton" data-action="click->code-block#copy" class="absolute top-2 right-2 p-2 rounded bg-[#29293f] text-[#7aa2f7] opacity-0 group-hover:opacity-100 transition-opacity duration-200 hover:bg-[#3b3b5d] focus:outline-none focus:ring-2 focus:ring-[#7aa2f7] focus:ring-opacity-50" aria-label="Copy code">
        <svg class="copy-icon w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <svg class="check-icon w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </button>
    </div>
  <% end %>
</div> 