#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
RELEASE_COMMAND=release-activate
. "$ROOT/bin/release-lib"

allow_preview=0
if [ "${1:-}" = "--allow-core-preview" ]; then allow_preview=1; shift; fi
[ "$#" = "1" ] || release_fail "usage: DEPLOY_ROOT=/opt/mattkelly bin/release-activate [--allow-core-preview] RELEASE_ID"
release_id=$1
require_release_id "$release_id"
deploy_root=${DEPLOY_ROOT:-/opt/mattkelly}
release="$deploy_root/releases/$release_id"
profile=complete
[ "$allow_preview" = "0" ] || profile=any
validate_release "$release" "$profile"
if [ "$allow_preview" = "1" ] && [ "$deploy_root" = "/opt/mattkelly" ]; then
  release_fail "core-only preview activation requires a non-production DEPLOY_ROOT"
fi

lock="$deploy_root/.deploy.lock"
mkdir "$lock" 2>/dev/null || release_fail "another deployment operation holds $lock"
cleanup() { rm -f "$deploy_root/.current.next.$$" "$deploy_root/.previous.next.$$"; rmdir "$lock"; }
trap cleanup EXIT HUP INT TERM
current_id=$(release_link_id "$deploy_root/current")
if [ -n "$current_id" ]; then
  ln -s "releases/$current_id" "$deploy_root/.previous.next.$$"
  atomic_replace_link "$deploy_root/.previous.next.$$" "$deploy_root/previous"
fi
ln -s "releases/$release_id" "$deploy_root/.current.next.$$"
atomic_replace_link "$deploy_root/.current.next.$$" "$deploy_root/current"
trap - EXIT HUP INT TERM
rmdir "$lock"
printf 'Activated release %s; previous release remains available\n' "$release_id"
