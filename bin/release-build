#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
RELEASE_COMMAND=release-build
. "$ROOT/bin/release-lib"

profile=complete
if [ "${1:-}" = "--core-only-preview" ]; then
  profile=core-only-preview
  shift
fi
unset quartz_artifact
quartz_artifact=${QUARTZ_ARTIFACT:-}
unset QUARTZ_ARTIFACT
[ "$#" = "1" ] || release_fail "usage: bin/release-build [--core-only-preview] OUTPUT_DIRECTORY"
output=$1
case "$output" in /*) ;; *) release_fail "output directory must be absolute" ;; esac
case "$output" in "$ROOT"|"$ROOT"/*) release_fail "output directory must be outside the repository" ;; esac
release_id=$(basename "$output")
require_release_id "$release_id"
[ ! -e "$output" ] || release_fail "output already exists: $output"
command -v shasum >/dev/null 2>&1 || release_fail "shasum is required"

repository_sha=$(git -C "$ROOT" rev-parse HEAD)
dirty=$(git -C "$ROOT" status --porcelain --untracked-files=all)
repository_state=clean
if [ -n "$dirty" ]; then
  if [ "$profile" = "complete" ]; then
    release_fail "complete releases require a clean repository"
  fi
  [ "${RELEASE_ALLOW_DIRTY_PREVIEW:-0}" = "1" ] || release_fail "repository is dirty (set RELEASE_ALLOW_DIRTY_PREVIEW=1 only for a preview)"
  repository_state=dirty-preview
fi

quartz_validation=not-included
quartz_source=none
validation_summary='core:passed,quartz:not-included'
[ "$profile" != "complete" ] || [ -n "$quartz_artifact" ] || release_fail "QUARTZ_ARTIFACT is required for a complete release"
source_root=$ROOT
source_snapshot=
evidence_hash=
if [ "$repository_state" = "clean" ]; then
  source_snapshot=$(mktemp -d "${TMPDIR:-/tmp}/mattkelly-release-source.XXXXXX")
  evidence_manifest="$source_snapshot/validated-evidence.manifest"
  PORTFOLIO_EVIDENCE_MANIFEST_OUT="$evidence_manifest" "$ROOT/bin/validate-content"
  git -C "$ROOT" archive "$repository_sha" | tar -x -C "$source_snapshot"
  mkdir -p "$source_snapshot/site/content"
  mv "$evidence_manifest" "$source_snapshot/site/content/validated-evidence.manifest"
  evidence_manifest="$source_snapshot/site/content/validated-evidence.manifest"
  evidence_hash=$(shasum -a 256 "$evidence_manifest" | cut -d' ' -f1)
  [ "$(git -C "$ROOT" rev-parse HEAD)" = "$repository_sha" ] || release_fail "repository HEAD changed while exporting release source"
  [ -z "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ] || release_fail "repository changed while exporting release source"
  source_root=$source_snapshot
fi
source_cleanup() { [ -z "$source_snapshot" ] || rm -rf "$source_snapshot"; }
trap source_cleanup EXIT HUP INT TERM
if [ -n "$evidence_hash" ]; then
  PORTFOLIO_EVIDENCE_MANIFEST="$source_root/site/content/validated-evidence.manifest" \
  PORTFOLIO_EVIDENCE_MANIFEST_SHA256="$evidence_hash" \
    "$source_root/bin/verify"
  [ "$(shasum -a 256 "$source_root/site/content/validated-evidence.manifest" | cut -d' ' -f1)" = "$evidence_hash" ] || release_fail "validated evidence manifest changed during snapshot verification"
else
  "$source_root/bin/verify"
fi
if [ "$profile" = "complete" ]; then
  receipt="$source_snapshot/.quartz-assembly-receipt"
  QUARTZ_ARTIFACT="$quartz_artifact" QUARTZ_ASSEMBLY_RECEIPT="$receipt" \
  PORTFOLIO_EVIDENCE_MANIFEST="$source_root/site/content/validated-evidence.manifest" \
  PORTFOLIO_EVIDENCE_MANIFEST_SHA256="$evidence_hash" \
    "$source_root/bin/assemble-release"
  [ -s "$receipt" ] || release_fail "Quartz assembly did not produce a source receipt"
  quartz_source=$(cat "$receipt")
  rm -f "$receipt"
  quartz_validation=passed
  validation_summary='core:passed,quartz:passed'
fi

. "$source_root/toolchain.env"
parent=$(dirname "$output")
[ -d "$parent" ] || release_fail "output parent does not exist: $parent"
tmp="$parent/.release-building.$$"
release="$tmp/$release_id"
[ ! -e "$tmp" ] || release_fail "temporary output already exists: $tmp"
cleanup() { rm -rf "$tmp"; source_cleanup; }
trap cleanup EXIT HUP INT TERM
mkdir "$tmp" "$release" "$release/public"
cp -R "$source_root/dist/." "$release/public/"
(
  cd "$release"
  find public -type f -print | LC_ALL=C sort | while IFS= read -r path; do
    shasum -a 256 "$path"
  done > release-files.sha256
)
inventory_hash=$(shasum -a 256 "$release/release-files.sha256" | cut -d' ' -f1)
cat > "$release/release-manifest.env" <<EOF
MANIFEST_VERSION=1
RELEASE_ID=$release_id
RELEASE_PROFILE=$profile
REPOSITORY_SHA=$repository_sha
REPOSITORY_STATE=$repository_state
CORE_VALIDATION=passed
QUARTZ_VALIDATION=$quartz_validation
VALIDATION_SUMMARY=$validation_summary
QUARTZ_ARTIFACT_SOURCE_REVISION=$quartz_source
QUARTZ_TOOLCHAIN_VERSION=$QUARTZ_VERSION
QUARTZ_TOOLCHAIN_REVISION=$QUARTZ_REVISION
QUARTZ_TOOLCHAIN_TREE=$QUARTZ_TREE
QUARTZ_COMPILER_SHA256=$QUARTZ_COMPILER_SHA256
LLVM_VERSION=$LLVM_VERSION
TOOLCHAIN_OS=$TOOLCHAIN_OS
TOOLCHAIN_ARCH=$TOOLCHAIN_ARCH
FILE_MANIFEST_SHA256=$inventory_hash
EOF
validate_release "$release" "$profile"
mv "$release" "$output"
rm -rf "$tmp"
trap - EXIT HUP INT TERM
source_cleanup
printf 'Built validated %s release at %s\n' "$profile" "$output"
