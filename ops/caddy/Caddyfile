{$PORTFOLIO_ADDRESS:http://mattkelly.io} {
	root * {$PORTFOLIO_ROOT:/opt/mattkelly/current/public}

	@staticAssets path /assets/* /images/* /favicon.ico /favicon-*.png /icon.png /icon.svg
	@machineFiles path /robots.txt /sitemap.xml

	route {
		header Cache-Control "no-cache"
		header @staticAssets Cache-Control "public, max-age=3600"
		header @machineFiles Cache-Control "public, max-age=300"
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), geolocation=(), microphone=()"
			-Server
		}

		@unsupportedMethod not method GET HEAD
		respond @unsupportedMethod 405

		redir /projects /work/ 308
		redir /projects/ /work/ 308
		redir /cv /resume/ 308
		redir /cv/ /resume/ 308
		redir /work /work/ 308
		redir /lab /lab/ 308
		redir /writing /writing/ 308
		redir /about /about/ 308
		redir /resume /resume/ 308
		redir /blog /writing/ 308
		redir /blog/ /writing/ 308
		redir /references /references/ 308
		redir /now /now/ 308
		redir /provenance /provenance/ 308
		redir /site-history /site-history/ 308
		redir /dragonruby /lab/dragonruby/ 308
		redir /dragonruby/ /lab/dragonruby/ 308
		redir /dragonruby/* /lab/dragonruby/ 308
		redir /blog/building-mattkelly-io /blog/building-mattkelly-io/ 308
		redir /blog/hello-world /blog/building-mattkelly-io/ 308
		redir /blog/hello-world/ /blog/building-mattkelly-io/ 308
		redir /quartz/ /quartz 308

		@retiredCv path /CV.pdf /CV.docx
		respond @retiredCv 410

		@quartzApex path /quartz
		rewrite @quartzApex /quartz/index.html

		file_server
	}

	handle_errors {
		header Cache-Control "no-cache"
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), geolocation=(), microphone=()"
			-Server
		}
		rewrite * /404.html
		file_server
	}
}

{$WWW_ADDRESS:http://www.mattkelly.io} {
	redir https://mattkelly.io{uri} 308
}

{$QUARTZ_ALIAS_ADDRESS:http://quartz.mattkelly.io} {
	redir https://mattkelly.io/quartz{uri} 308
}

{$CHIP8_ADDRESS:http://chip8.mattkelly.io} {
	redir https://mattkelly.io/quartz/chip8/ 308
}

# Soul is deliberately isolated on its own hostname and configurable upstream.
# No apex request can fall through to this dynamic service.
{$SOUL_ADDRESS:http://soulofquartz.mattkelly.io} {$SOUL_ALIAS_ADDRESS:http://unikernel.mattkelly.io} {
	@soulHealth expression `{http.request.orig_uri} == "/health" || {http.request.orig_uri}.startsWith("/health?")`
	@soulStats expression `{http.request.orig_uri} == "/api/soul/stats.json" || {http.request.orig_uri}.startsWith("/api/soul/stats.json?")`

	route {
		header Cache-Control "no-store"
		header @soulStats Cache-Control "public, max-age=5"
		header {
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), geolocation=(), microphone=()"
			-Server
		}

		@unsupportedMethod not method GET HEAD
		respond @unsupportedMethod 405

		rewrite @soulHealth /health
		reverse_proxy @soulHealth {$SOUL_UPSTREAM:http://127.0.0.1:8080}
		rewrite @soulStats /api/soul/stats.json
		reverse_proxy @soulStats {$SOUL_UPSTREAM:http://127.0.0.1:8080}
		respond 404
	}
}
