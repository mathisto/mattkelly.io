# Dependency-minimal portfolio build driver.

import std/io/file
import ssg/doc
import ssg/content
import ssg/template
import ssg/markdown
import ssg/theme
import ssg/records

def _document_title(title: String): String
  if title == "Matt Kelly"
    return title
  end
  return title + " | Matt Kelly"
end

def _wrap(layout: String, title: String, description: String, path: String, page_type: String, content_html: String): String
  var out = str_replace(layout, "{{title}}", html_context_escape(_document_title(title)))
  out = str_replace(out, "{{description}}", html_context_escape(description))
  out = str_replace(out, "{{canonical}}", "https://mattkelly.io" + path)
  out = str_replace(out, "{{og_type}}", page_type)
  return str_replace(out, "{{content}}", content_html)
end

def _render_page(src_path: String, out_dir: String, path: String, title: String, description: String, layout: String, terminal_html: String): Void
  mkdir(out_dir)
  var body = str_replace(read_file(src_path), "{{terminal_commands}}", terminal_html)
  write_file(out_dir + "/index.html", _wrap(layout, title, description, path, "website", body))
end

def _route_path_valid(path: String): Bool
  if path == "/"
    return true
  end
  if str_starts_with(path, "/") == false or str_ends_with(path, "/") == false or str_contains(path, "//")
    return false
  end
  var parts = str_split(str_byte_slice(path, 1, str_byte_len(path) - 1), "/")
  var i = 0
  while i < parts.size
    if content_slug_valid(parts[i]) == false
      return false
    end
    i = i + 1
  end
  return true
end

def render_routes(layout: String, terminal_html: String): Int
  var lines = str_split(read_file("site/content/routes.txt"), "\n")
  var paths: Vec<String> = vec_new()
  var count = 0
  var i = 0
  while i < lines.size
    var line = str_trim(lines[i])
    if line != "" and str_starts_with(line, "#") == false
      var fields = str_split(line, "|")
      if fields.size != 5
        puts("error: routes.txt line " + str_from_int(i + 1) + " must have 5 fields")
        return 0 - 1
      end
      var path = str_trim(fields[0])
      var source = str_trim(fields[1])
      var indexed = str_trim(fields[4])
      if _route_path_valid(path) == false or str_contains(source, "/") or str_contains(source, "..") or str_ends_with(source, ".html") == false
        puts("error: invalid route record: " + line)
        return 0 - 1
      end
      if str_trim(fields[2]) == "" or str_trim(fields[3]) == "" or (indexed != "yes" and indexed != "no")
        puts("error: incomplete route record: " + path)
        return 0 - 1
      end
      if _contains(paths, path)
        puts("error: duplicate route: " + path)
        return 0 - 1
      end
      paths.push(path)
      var out_dir = "dist"
      if path != "/"
        out_dir = "dist" + str_byte_slice(path, 0, str_byte_len(path) - 1)
      end
      _render_page("site/content/pages/" + source, out_dir, path, str_trim(fields[2]), str_trim(fields[3]), layout, terminal_html)
      count = count + 1
    end
    i = i + 1
  end
  return count
end

def _filename_slug(fname: String): String
  return str_byte_slice(fname, 0, str_byte_len(fname) - 3)
end

def _contains(values: Vec<String>, value: String): Bool
  var i = 0
  while i < values.size
    if values[i] == value
      return true
    end
    i = i + 1
  end
  return false
end

def render_blog(layout: String): Int
  var entries = str_split(read_file("site/content/blog.order"), "\n")
  var slugs: Vec<String> = vec_new()
  var titles: Vec<String> = vec_new()
  var descriptions: Vec<String> = vec_new()
  var dates: Vec<String> = vec_new()
  var bodies: Vec<String> = vec_new()
  var redirects = 0
  var i = 0

  while i < entries.size
    var fname = entries[i]
    if str_ends_with(fname, ".md")
      var doc = parse_frontmatter(read_file("site/content/blog/" + fname))
      if doc.valid == false
        puts("error: site/content/blog/" + fname + ": " + doc.error)
        return 0 - 1
      end
      var validation_error = content_validate_doc(doc, _filename_slug(fname))
      if validation_error != ""
        puts("error: site/content/blog/" + fname + ": " + validation_error)
        return 0 - 1
      end
      var slug = _filename_slug(fname)
      if _contains(slugs, slug)
        puts("error: duplicate blog output: " + slug)
        return 0 - 1
      end
      var status = doc_get(doc, "status", "")
      if status == "published"
        slugs.push(slug)
        titles.push(doc_get(doc, "title", ""))
        descriptions.push(doc_get(doc, "description", ""))
        dates.push(doc_get(doc, "date", ""))
        bodies.push(doc.body)
      end
      if status == "redirect"
        redirects = redirects + 1
      end
    end
    i = i + 1
  end

  mkdir("dist/blog")
  var index = sb_new()
  index.append("<main class=\"content\"><h1>Writing</h1><ul class=\"post-list\">\n")
  i = 0
  while i < slugs.size
    var out_dir = "dist/blog/" + slugs[i]
    mkdir(out_dir)
    var safe_title = html_context_escape(titles[i])
    var safe_date = html_context_escape(dates[i])
    var header = "<header class=\"article-header\"><h1>" + safe_title + "</h1><time datetime=\"" + safe_date + "\">" + safe_date + "</time></header>\n"
    var body = "<main class=\"content\"><article class=\"prose\">" + header + render_safe_markdown(bodies[i]) + "</article></main>"
    var path = "/blog/" + slugs[i] + "/"
    write_file(out_dir + "/index.html", _wrap(layout, titles[i], descriptions[i], path, "article", body))
    index.append("<li><a href=\"" + path + "\">" + safe_title + "</a><time datetime=\"" + safe_date + "\">" + safe_date + "</time></li>\n")
    i = i + 1
  end
  index.append("</ul></main>\n")
  write_file("dist/blog/index.html", _wrap(layout, "Writing", "Articles and notes by Matt Kelly.", "/blog/", "website", index.to_string()))

  var sitemap = sb_new()
  sitemap.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n")
  var route_lines = str_split(read_file("site/content/routes.txt"), "\n")
  i = 0
  while i < route_lines.size
    var route_line = str_trim(route_lines[i])
    if route_line != "" and str_starts_with(route_line, "#") == false
      var route_fields = str_split(route_line, "|")
      if route_fields.size == 5 and str_trim(route_fields[4]) == "yes"
        sitemap.append("  <url><loc>https://mattkelly.io" + str_trim(route_fields[0]) + "</loc></url>\n")
      end
    end
    i = i + 1
  end
  i = 0
  while i < slugs.size
    sitemap.append("  <url><loc>https://mattkelly.io/blog/" + slugs[i] + "/</loc></url>\n")
    i = i + 1
  end
  sitemap.append("</urlset>\n")
  write_file("dist/sitemap.xml", sitemap.to_string())
  return slugs.size + redirects
end

def main(): Int
  mkdir("dist")
  mkdir("dist/assets")
  mkdir("dist/assets/css")
  write_file("dist/assets/css/themes.css", render_themes_css())
  var layout = read_file("site/layouts/base.html")
  var claim_count = records_validate_claims(read_file("site/content/claims.txt"))
  if claim_count < 0
    return 1
  end
  var terminal_html = records_render_terminal(read_file("site/content/terminal.commands"))
  if terminal_html == ""
    puts("error: terminal command model is invalid or empty")
    return 1
  end
  var page_count = render_routes(layout, terminal_html)
  if page_count < 0
    return 1
  end
  _render_page("site/content/pages/404.html", "dist/404", "/404/", "Page Not Found", "The requested page could not be found.", layout, terminal_html)
  write_file("dist/404.html", read_file("dist/404/index.html"))
  write_file("dist/robots.txt", "User-agent: *\nAllow: /\nSitemap: https://mattkelly.io/sitemap.xml\n")
  var blog_count = render_blog(layout)
  if blog_count < 0
    return 1
  end
  puts("portfolio pages: " + str_from_int(page_count))
  puts("claim records: " + str_from_int(claim_count))
  puts("blog outputs: " + str_from_int(blog_count))
  puts("done -> dist/")
  return 0
end
