<div class="p-8 bg-[#1a1b26]">
  <%= render Terminal::Component.new do |terminal| %>
    <% terminal.with_header(title: "bash") %>
    <% terminal.with_prompt(command: "cat banner.txt") do |prompt| %>
      <% prompt.with_output(type: :ascii) do %>
        <pre>__  __       _   _    _  __    _ _       
|  \/  | __ _| |_| |_ | |/ /___| | |_   _ 
| |\/| |/ _` | __| __|| ' // _ \ | | | | |
| |  | | (_| | |_| |_ | . \  __/ | | |_| |
|_|  |_|\__,_|\__|\__||_|\_\___|_|_|\__, |
                                    |___/</pre>
      <% end %>
    <% end %>
    <% terminal.with_prompt(command: "echo $ROLE") do |prompt| %>
      <% prompt.with_output do %>
        Full-Stack Developer & Technical Leader
      <% end %>
    <% end %>
  <% end %>
</div>
