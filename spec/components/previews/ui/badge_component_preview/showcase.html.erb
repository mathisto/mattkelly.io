<div class="p-8 bg-[#1a1b26] space-y-6">
  <div class="space-y-2">
    <h3 class="text-[#7aa2f7] font-semibold">Default Badges</h3>
    <div class="flex gap-3 flex-wrap">
      <%= render UI::BadgeComponent.new do %>Badge 1<% end %>
      <%= render UI::BadgeComponent.new do %>Badge 2<% end %>
      <%= render UI::BadgeComponent.new do %>Badge 3<% end %>
    </div>
  </div>
  <div class="space-y-2">
    <h3 class="text-[#7aa2f7] font-semibold">Skill Badges</h3>
    <div class="flex gap-3 flex-wrap">
      <%= render UI::BadgeComponent.new(variant: :skill) do |b|
        b.with_icon(name: "gem", style: :solid, class: "text-[#9ece6a]")
        "Ruby"
      end %>
      <%= render UI::BadgeComponent.new(variant: :skill) do |b|
        b.with_icon(name: "python", style: :brands, class: "text-[#9ece6a]")
        "Python"
      end %>
      <%= render UI::BadgeComponent.new(variant: :skill) do |b|
        b.with_icon(name: "js", style: :brands, class: "text-[#9ece6a]")
        "JavaScript"
      end %>
    </div>
  </div>
  <div class="space-y-2">
    <h3 class="text-[#7aa2f7] font-semibold">Tag Badges</h3>
    <div class="flex gap-3 flex-wrap">
      <%= render UI::BadgeComponent.new(variant: :tag) do |b|
        b.with_icon(name: "tag", style: :solid)
        "ViewComponent"
      end %>
      <%= render UI::BadgeComponent.new(variant: :tag) do |b|
        b.with_icon(name: "tag", style: :solid)
        "Rails 8"
      end %>
      <%= render UI::BadgeComponent.new(variant: :tag) do |b|
        b.with_icon(name: "tag", style: :solid)
        "Hotwire"
      end %>
    </div>
  </div>
</div>
